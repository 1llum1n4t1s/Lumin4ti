<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Lumin4ti.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CRDebugger.Avalonia" Version="1.0.34" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- Velopack 本体は Program.cs / UpdateService が直接使うため、VelopackUpdateDialog 経由の
         transitive 参照に頼らず直接参照する (NuGet が直接参照版へ統合する)。 -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="VelopackUpdateDialog.Avalonia" Version="1.0.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumin4ti.Core\Lumin4ti.Core.csproj" />
    <!-- 別エントリポイントとして同じ Core/runtime を使う。UI の参照 assembly には含めない。 -->
    <ProjectReference Include="..\Lumin4ti.RebootCleanup\Lumin4ti.RebootCleanup.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumin4ti.Tests" />
    <InternalsVisibleTo Include="Lumin4ti.Verification" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon/app.ico" />
    <AvaloniaResource Include="Resources/FluentSystemIcons/*.png" />
    <None Update="Resources/FluentSystemIcons/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windowsアプリのアイコン/manifest設定が欠落する回帰をビルド時に検出する。 -->
  <Target Name="ValidateWindowsApplicationMetadata" BeforeTargets="CoreCompile">
    <Error Condition="'$(ApplicationIcon)' == '' Or !Exists('$(MSBuildProjectDirectory)\$(ApplicationIcon)')" Text="Windows アプリの ApplicationIcon が未設定か、ファイルが存在しません。" />
    <Error Condition="'$(ApplicationManifest)' == '' Or !Exists('$(MSBuildProjectDirectory)\$(ApplicationManifest)')" Text="Windows アプリの ApplicationManifest が未設定か、ファイルが存在しません。" />
  </Target>

  <!-- GetTargetPath で通常出力・ArtifactsPath・RID ごとの実出力先を取得する。 -->
  <Target Name="CollectRebootCleanupArtifacts"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeResolvedFilesToPublishList"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Lumin4ti.RebootCleanup\Lumin4ti.RebootCleanup.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)">
      <Output TaskParameter="TargetOutputs" ItemName="_RebootCleanupTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_RebootCleanupArtifact Include="@(_RebootCleanupTargetPath->'%(RootDir)%(Directory)Lumin4ti.RebootCleanup.exe')" />
      <_RebootCleanupArtifact Include="@(_RebootCleanupTargetPath->'%(RootDir)%(Directory)Lumin4ti.RebootCleanup.dll')" />
      <_RebootCleanupArtifact Include="@(_RebootCleanupTargetPath->'%(RootDir)%(Directory)Lumin4ti.RebootCleanup.deps.json')" />
      <_RebootCleanupArtifact Include="@(_RebootCleanupTargetPath->'%(RootDir)%(Directory)Lumin4ti.RebootCleanup.runtimeconfig.json')" />
      <ContentWithTargetPath Include="@(_RebootCleanupArtifact)"
                             TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RebootCleanupArtifact.Identity)')"
           Text="再起動時クリーンアップ helper の出力がありません: %(_RebootCleanupArtifact.Identity)" />
  </Target>

  <Target Name="IncludeRebootCleanupPublishArtifacts" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="CollectRebootCleanupArtifacts">
    <ItemGroup>
      <!-- runtime/Core の重複コピーを避け、helper 自身の起動に必要な4ファイルだけを同梱する。 -->
      <ResolvedFileToPublish Include="@(_RebootCleanupArtifact)"
                             RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
