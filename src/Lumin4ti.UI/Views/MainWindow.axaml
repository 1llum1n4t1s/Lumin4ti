<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumin4ti.UI.ViewModels"
        xmlns:views="using:Lumin4ti.UI.Views"
        x:Class="Lumin4ti.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lumin4ti"
        Icon="avares://Lumin4ti.UI/icon/app.ico"
        Width="880" Height="620" MinWidth="760" MinHeight="500"
        Background="Transparent"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!--  ウィンドウ背景：アクリルブラー (Shisui / Lhamiel と同じ Tahoe 風ガラス質感)  -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource Color.Window}" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <Grid Margin="16,36,16,16" RowDefinitions="Auto,*">
      <TextBlock Text="{Binding Version.SettingsSaveStatusText}" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,8"
                 Foreground="#FF9500" IsVisible="{Binding Version.SettingsSaveStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TabControl Classes="sidebar" Grid.Row="1">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/arrow_sync.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Update}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding Update}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/document_folder.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Cleanup}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding Cleanup}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/wrench.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Repair}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding Repair}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/gauge.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Performance}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding Performance}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/settings.png" />
              <TextBlock Text="{DynamicResource Text.Tab.System}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding System}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/laptop.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Devices}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:DeviceCleanupView DataContext="{Binding DeviceCleanup}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/apps_list.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Organize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:CommandCategoryView DataContext="{Binding Organize}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://Lumin4ti.UI/Resources/FluentSystemIcons/question_circle.png" />
              <TextBlock Text="{DynamicResource Text.Tab.Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:VersionView DataContext="{Binding Version}" />
        </TabItem>
      </TabControl>
    </Grid>
  </Panel>
</Window>
