<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             xmlns:controls="using:Lumin4ti.UI.Controls"
             x:Class="Lumin4ti.UI.Views.SlimView"
             x:DataType="vm:SlimViewModel">

  <!--  スリム化: 走査 → 選択 → 確認シート → 実行 → 結果。項目は走査前から並べ、自動では走査も実行もしない。  -->
  <controls:CleanupPage AutomationProperties.Name="{DynamicResource Text.Cleanup.Slim.Ui.Title}"
                        Description="{DynamicResource Text.Cleanup.Slim.Ui.Description}"
                        DescriptionMaxLines="1"
                        IsBusy="{Binding IsRunning}"
                        ProgressText="{Binding ProgressDisplayText}"
                        IsResultVisible="{Binding HasResult}"
                        IsFooterVisible="{Binding HasScan}"
                        IsSheetOpen="{Binding IsConfirming}"
                        SheetCancelCommand="{Binding CancelConfirmCommand}">

    <controls:CleanupPage.Toolbar>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!--  走査 (走査前は強調)。走査中・実行中は同じ場所が「中止」になる。  -->
        <Button Content="{Binding ScanButtonText}" Classes.accent="{Binding !HasScan}"
                Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                IsVisible="{Binding !IsRunning}" />
        <Button Content="{DynamicResource Text.Cleanup.Action.CancelScan}"
                Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                IsVisible="{Binding IsRunning}" />
        <Button IsEnabled="{Binding CanEditSelection}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{DynamicResource Text.Cleanup.Ui.SelectMenu}" />
            <TextBlock Text="▾" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="{DynamicResource Text.Cleanup.Select.None}" Command="{Binding ClearSelectionCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </controls:CleanupPage.Toolbar>

    <controls:CleanupPage.Notices>
      <StackPanel Spacing="8">
        <!--  走査前の案内は 1 行の文だけ (一覧をそのまま見せる)。  -->
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}"
                   IsVisible="{Binding ShowNotScannedNotice}" />
        <Border Classes="notice warning" IsVisible="{Binding ShowStatusWarning}">
          <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}" />
        </Border>
        <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}" IsVisible="{Binding ShowStatusPlain}" />
      </StackPanel>
    </controls:CleanupPage.Notices>

    <!--  実行後: 全体の結果・復元ポイント・再起動の要否。成功色は完全な成功のときだけ。  -->
    <controls:CleanupPage.Result>
      <Border Classes="result" Classes.success="{Binding IsResultSuccess}" Classes.warning="{Binding IsResultWarning}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RestorePointResultText}" TextWrapping="Wrap"
                     IsVisible="{Binding RestorePointResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding RebootText}" TextWrapping="Wrap" FontWeight="SemiBold"
                     IsVisible="{Binding RebootText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!--  実行後の再走査の案内は結果の下の注記として出す (警告の帯にしない)。  -->
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RescanNoticeText}"
                     IsVisible="{Binding ShowRescanNotice}" />
        </StackPanel>
      </Border>
    </controls:CleanupPage.Result>

    <!--  項目一覧: 走査前から並ぶ。名前・説明・警告・状態・空きの見込み (実行後は結果)。  -->
    <controls:CleanupPage.Body>
      <ListBox Classes="cleanup-list" ItemsSource="{Binding Items}" IsEnabled="{Binding !IsRunning}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SlimItemRowViewModel">
            <Border Classes="list-row">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top"
                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsCheckEnabled}"
                          AutomationProperties.Name="{Binding AutomationName}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
                  <TextBlock Classes="warning" TextWrapping="Wrap" IsVisible="{Binding HasWarning}">
                    <Run Text="{Binding LevelText}" FontWeight="SemiBold" />
                    <Run Text="{Binding WarningText}" />
                  </TextBlock>
                  <TextBlock Classes="caption" Text="{Binding ReasonText}" TextWrapping="Wrap"
                             IsVisible="{Binding HasReason}" />
                  <TextBlock Classes="caption" Text="{Binding ResultMessage}" TextWrapping="Wrap"
                             IsVisible="{Binding HasResult}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="140" Spacing="2">
                  <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                             IsVisible="{Binding HasResult}" />
                  <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </controls:CleanupPage.Body>

    <controls:CleanupPage.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SelectionText}" />
        <Button Grid.Column="1" Classes="danger"
                Content="{DynamicResource Text.Cleanup.Slim.Ui.Run}"
                Command="{Binding RequestRunCommand}" IsEnabled="{Binding CanRequestRun}" />
      </Grid>
    </controls:CleanupPage.Footer>

    <!--  確認シート (警告・復元ポイントの方針・取り消せない操作への同意)。  -->
    <controls:CleanupPage.Sheet>
      <Border Classes="sheet">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Text.Cleanup.Registry.View.Cancel}" Command="{Binding CancelConfirmCommand}" />
            <Button Classes="danger" Content="{DynamicResource Text.Button.Run}"
                    Command="{Binding ConfirmRunCommand}" IsEnabled="{Binding CanConfirm}" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
              <TextBlock Classes="warning" Text="{Binding ConfirmWarnings}" TextWrapping="Wrap"
                         IsVisible="{Binding ConfirmWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <CheckBox Content="{DynamicResource Text.Cleanup.Slim.Ui.CreateRestorePoint}"
                        IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding !IsRunning}" />
              <TextBlock Classes="caption" Text="{Binding RestorePointNote}" TextWrapping="Wrap"
                         IsVisible="{Binding RestorePointNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Spacing="6" IsVisible="{Binding RequiresAcknowledgement}">
                <TextBlock Classes="error" Text="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding IrreversibleText}" TextWrapping="Wrap" />
                <CheckBox Content="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check}"
                          IsChecked="{Binding Acknowledged}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </controls:CleanupPage.Sheet>
  </controls:CleanupPage>
</UserControl>
