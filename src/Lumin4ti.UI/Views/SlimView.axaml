<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             x:Class="Lumin4ti.UI.Views.SlimView"
             x:DataType="vm:SlimViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8,0" Spacing="8">
      <TextBlock Classes="h1" Text="{DynamicResource Text.Cleanup.Slim.Ui.Title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="{DynamicResource Text.Cleanup.Slim.Ui.Description}" />

      <!--  操作: 走査 (走査中は中断) と、選択の解除。実行は選択後に確認を経て行う。  -->
      <WrapPanel Orientation="Horizontal">
        <Button Margin="0,0,8,0" Content="{Binding ScanButtonText}"
                Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" />
        <Button Margin="0,0,8,0" Content="{DynamicResource Text.Cleanup.Action.CancelScan}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsRunning}" IsEnabled="{Binding CanCancel}" />
        <Button Margin="0,0,8,0" Content="{DynamicResource Text.Cleanup.Select.None}"
                Command="{Binding ClearSelectionCommand}" IsEnabled="{Binding CanEditSelection}" />
        <CheckBox Margin="0,0,8,0" Content="{DynamicResource Text.Cleanup.Slim.Ui.CreateRestorePoint}"
                  IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding !IsRunning}" />
      </WrapPanel>

      <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
        <ProgressBar IsIndeterminate="True" Height="4" />
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding ProgressText}" TextWrapping="Wrap"
                   IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!--  項目一覧: 名前・説明・警告・状態・空きの見込み (実行後は結果)。  -->
      <ItemsControl ItemsSource="{Binding Items}" IsEnabled="{Binding !IsRunning}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SlimItemRowViewModel">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="8"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top"
                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsCheckEnabled}"
                          AutomationProperties.Name="{Binding AutomationName}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
                  <TextBlock Foreground="#FFB020" TextWrapping="Wrap" IsVisible="{Binding HasWarning}">
                    <Run Text="{Binding LevelText}" FontWeight="SemiBold" />
                    <Run Text="{Binding WarningText}" />
                  </TextBlock>
                  <TextBlock Classes="caption" Text="{Binding ReasonText}" TextWrapping="Wrap"
                             IsVisible="{Binding HasReason}" />
                  <TextBlock Classes="caption" Text="{Binding ResultMessage}" TextWrapping="Wrap"
                             IsVisible="{Binding HasResult}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="140" Spacing="2">
                  <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                             IsVisible="{Binding HasResult}" />
                  <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button HorizontalAlignment="Left" Classes="danger"
              Content="{DynamicResource Text.Cleanup.Slim.Ui.Run}"
              Command="{Binding RequestRunCommand}" IsEnabled="{Binding CanRequestRun}" />

      <!--  確認 (警告・二段階確認・復元ポイントの方針)。処理中オーバーレイの前に出すため、実行前の確認はここで行う。  -->
      <Border Padding="12,10" CornerRadius="10" IsVisible="{Binding IsConfirming}"
              Background="#18FF3B30" BorderBrush="#66FF3B30" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Title}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmWarnings}" TextWrapping="Wrap"
                     IsVisible="{Binding ConfirmWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding RestorePointNote}" TextWrapping="Wrap"
                     IsVisible="{Binding RestorePointNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="6" IsVisible="{Binding RequiresAcknowledgement}">
            <TextBlock Text="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding IrreversibleText}" TextWrapping="Wrap" />
            <CheckBox Content="{DynamicResource Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check}"
                      IsChecked="{Binding Acknowledged}" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <Button Classes="danger" Margin="0,0,8,0" Content="{DynamicResource Text.Button.Run}"
                    Command="{Binding ConfirmRunCommand}" IsEnabled="{Binding CanConfirm}" />
            <Button Content="{DynamicResource Text.Button.Cancel}" Command="{Binding CancelConfirmCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!--  実行後: 全体の結果・復元ポイント・再起動の要否。  -->
      <StackPanel Spacing="4" IsVisible="{Binding ResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RestorePointResultText}" TextWrapping="Wrap"
                   IsVisible="{Binding RestorePointResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding RebootText}" TextWrapping="Wrap" FontWeight="SemiBold"
                   IsVisible="{Binding RebootText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
