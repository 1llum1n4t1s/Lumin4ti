<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             xmlns:controls="using:Lumin4ti.UI.Controls"
             x:Class="Lumin4ti.UI.Views.AdvancedCleanView"
             x:DataType="vm:AdvancedCleanViewModel">

  <!--  ドライブ選択 → 走査 → 種別ごとの結果と 2 行の一覧 (仮想化) → 選択 → 確認シート → 削除。自動では走査も削除もしない。  -->
  <controls:CleanupPage AutomationProperties.Name="{DynamicResource Text.Cleanup.Advanced.Title}"
                        Description="{DynamicResource Text.Cleanup.Advanced.Description}"
                        DescriptionMaxLines="1"
                        IsBusy="{Binding IsRunning}"
                        ProgressText="{Binding ProgressText}"
                        IsResultVisible="{Binding HasResult}"
                        IsFooterVisible="{Binding HasResults}"
                        IsSheetOpen="{Binding IsConfirming}"
                        SheetCancelCommand="{Binding CancelDeleteCommand}">

    <!--  ② 操作バー: 先頭に走査 (走査中は同じ場所が中止) と選択メニュー、その下に走査する場所と条件の開閉欄  -->
    <controls:CleanupPage.Toolbar>
      <StackPanel Spacing="2">
        <WrapPanel Orientation="Horizontal">
          <Button Margin="0,0,8,4" Classes.accent="{Binding !HasScan}" Content="{Binding ScanButtonText}"
                  Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}" IsVisible="{Binding !IsRunning}" />
          <Button Margin="0,0,8,4" Content="{DynamicResource Text.Cleanup.Action.CancelScan}"
                  Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
          <Button Margin="0,0,8,4" Click="OnSelectMenuClick" IsEnabled="{Binding CanScan}" IsVisible="{Binding HasResults}"
                  AutomationProperties.Name="{DynamicResource Text.Cleanup.Ui.SelectMenu}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{DynamicResource Text.Cleanup.Ui.SelectMenu}" />
              <TextBlock Text="▾" />
            </StackPanel>
          </Button>
        </WrapPanel>

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  IsExpanded="{Binding IsScopeExpanded, Mode=TwoWay}">
          <Expander.Header>
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Text.Cleanup.Advanced.ScanScope}" />
          </Expander.Header>
          <StackPanel Spacing="6" IsEnabled="{Binding CanScan}">
            <TextBlock Text="{DynamicResource Text.Cleanup.Advanced.Drives}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AdvancedCleanDriveViewModel">
                  <!--  文字列を直接 Content にすると "_" がアクセスキー扱いで消えるため、TextBlock で包む  -->
                  <CheckBox Margin="0,0,16,0" IsChecked="{Binding IsSelected}">
                    <TextBlock Text="{Binding DisplayName}" />
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Orientation="Horizontal">
              <CheckBox Margin="0,0,16,0" IsChecked="{Binding IncludeZeroByte}"
                        Content="{DynamicResource Text.Cleanup.Advanced.Option.ZeroByte}" />
              <CheckBox Margin="0,0,16,0" IsChecked="{Binding IncludeInvalidShortcuts}"
                        Content="{DynamicResource Text.Cleanup.Advanced.Option.InvalidShortcuts}" />
              <CheckBox Margin="0,0,8,0" IsChecked="{Binding IncludeOlder}"
                        Content="{DynamicResource Text.Cleanup.Advanced.Option.OlderThan}" />
              <NumericUpDown Width="130" Minimum="1" Maximum="36500" Increment="30" FormatString="0"
                             Value="{Binding OlderThanDays}" IsEnabled="{Binding IncludeOlder}"
                             AutomationProperties.Name="{DynamicResource Text.Cleanup.Advanced.Option.Days}" />
            </WrapPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </controls:CleanupPage.Toolbar>

    <!--  ④ 通知: 失効の警告帯 (再走査は操作バーの走査ボタンで行う)、走査結果の状態文、表示上限の超過などの注意  -->
    <controls:CleanupPage.Notices>
      <StackPanel Spacing="4">
        <Border Classes="notice warning" IsVisible="{Binding ShowStaleBand}">
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding StatusText}" />
        </Border>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" IsVisible="{Binding ShowScanStatus}" />
        <ItemsControl ItemsSource="{Binding Notices}" IsVisible="{Binding ShowScanNotices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:CleanupPage.Notices>

    <!--  ⑤ 結果カード: 完全な成功だけ成功色。部分失敗・失効・取消は警告色、失敗は誤り色。  -->
    <controls:CleanupPage.Result>
      <Border Classes="result"
              Classes.success="{Binding IsResultSuccess}"
              Classes.warning="{Binding IsResultWarning}"
              Classes.error="{Binding IsResultError}">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StatusText}" />
          <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RescanAfterRunText}" />
        </StackPanel>
      </Border>
    </controls:CleanupPage.Result>

    <!--  ⑥ 本体: 種別の絞り込み・並べ替え・カスタムフォルダー・2 行の一覧 (仮想化)。縦スクロールは一覧だけ。  -->
    <controls:CleanupPage.Body>
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,4" IsVisible="{Binding HasResults}">
          <!--  種別・すべて表示・絞り込み (伸縮)・並べ替えを 1 行に収める  -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <ComboBox Grid.Column="0" MinWidth="200" MaxWidth="300" ItemsSource="{Binding Groups}"
                      VerticalAlignment="Center"
                      SelectedItem="{Binding SelectedGroup}" PlaceholderText="{Binding KindsHeaderText}"
                      AutomationProperties.Name="{Binding KindsHeaderText}">
              <!--  閉じた状態は 1 行 (種別名・件数・サイズ)。2 行目の分類はドロップダウンの項目だけに出す。  -->
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="vm:AdvancedCleanGroupViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CountText}" />
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SizeText}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AdvancedCleanGroupViewModel">
                  <!--  1 行目: 種別名・件数・サイズ  2 行目: 分類 (既定・追加・ユーザー定義)  -->
                  <StackPanel Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding CountText}" />
                      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SizeText}" />
                    </StackPanel>
                    <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding GroupText}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding ShowAllKindsCommand}"
                    IsEnabled="{Binding SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding ShowAllText}" />
            </Button>
            <TextBox Grid.Column="2" MinWidth="80" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding FilterText}"
                     PlaceholderText="{DynamicResource Text.Cleanup.Filter.Placeholder}" />
            <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnSortMenuClick"
                    AutomationProperties.Name="{DynamicResource Text.Cleanup.Ui.Sort}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{DynamicResource Text.Cleanup.Ui.Sort}" />
                <TextBlock Text="▾" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Classes="caption" Text="{Binding SortStateText}"
                     IsVisible="{Binding SortStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!--  カスタムフォルダー (既定では未選択)。数が多いときはこの区画の中だけでスクロールする。  -->
        <Border Grid.Row="1" Classes="card compact" IsVisible="{Binding HasCustomFolders}">
          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Text.Cleanup.Advanced.CustomFolders}" />
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding CustomFolders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdvancedCleanFolderViewModel">
                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" Margin="0,0,0,4">
                      <StackPanel>
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SummaryText}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <ListBox Grid.Row="2" Classes="cleanup-list" ItemsSource="{Binding VisibleRows}"
                 SelectionMode="Single" IsVisible="{Binding HasResults}"
                 AutomationProperties.Name="{DynamicResource Text.Cleanup.A11y.Results}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AdvancedCleanRowViewModel">
              <!--  1 行目: ☑・名前・サイズ・安全性・⋯  2 行目: フォルダー・更新日時・規則  -->
              <Border Classes="list-row" ToolTip.Tip="{Binding ToolTipText}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                  <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                            IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Classes="caption" Text="{Binding SizeText}" />
                  <Border Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" Classes="badge"
                          Classes.warning="{Binding IsWarning}">
                    <TextBlock Text="{Binding SafetyText}" />
                  </Border>
                  <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Margin="4,0,0,0" Padding="8,2" VerticalAlignment="Top"
                          Content="⋯" Click="OnRowMenuClick"
                          AutomationProperties.Name="{DynamicResource Text.Cleanup.Ui.RowActions}" />
                  <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding Folder}" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Classes="caption" Text="{Binding ModifiedText}" />
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Classes="caption" MaxWidth="140"
                               TextTrimming="CharacterEllipsis" Text="{Binding RuleText}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!--  空状態: 走査前・結果なし・対象なし・走査の中止や失敗  -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <StackPanel Spacing="4" IsVisible="{Binding IsNotScannedState}">
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource Text.Cleanup.Ui.NotScanned.Title}" />
            <TextBlock HorizontalAlignment="Center" Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource Text.Cleanup.Ui.NotScanned.Body}" />
          </StackPanel>
          <TextBlock HorizontalAlignment="Center" Classes="caption" TextAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding StatusText}" IsVisible="{Binding IsStatusEmptyState}" />
        </StackPanel>
      </Grid>
    </controls:CleanupPage.Body>

    <!--  ⑦ 実行バー  -->
    <controls:CleanupPage.Footer>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="caption" TextWrapping="Wrap" Text="{Binding SelectionText}" />
        <Button Grid.Column="1" Margin="12,0,0,0" Classes="danger" Content="{DynamicResource Text.Cleanup.Action.Clean}"
                Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" />
      </Grid>
    </controls:CleanupPage.Footer>

    <!--  ⑧ 確認シート: 元に戻せない旨 (ConfirmLines の先頭) と対象の要約。  -->
    <controls:CleanupPage.Sheet>
      <Border Classes="sheet">
        <DockPanel>
          <!--  ボタン行は下端に固定し、本文だけを 1 つの ScrollViewer に入れる  -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Text.Cleanup.Confirm.Back}" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger" Content="{DynamicResource Text.Cleanup.Confirm.Run}" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="{DynamicResource Text.Cleanup.Confirm.Title}" />
              <ItemsControl ItemsSource="{Binding ConfirmLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </controls:CleanupPage.Sheet>
  </controls:CleanupPage>
</UserControl>
