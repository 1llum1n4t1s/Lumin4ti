<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             xmlns:views="using:Lumin4ti.UI.Views"
             x:Class="Lumin4ti.UI.Views.CleanupView"
             x:DataType="vm:CleanupViewModel">

  <!--  内側 6 タブ: 通常／高度／スリム化／レジストリ／設定／その他 (その他は従来のカテゴリ画面)  -->
  <TabControl>
    <!--  見出しは折り返さず 1 行に保ち、幅が足りない言語では見出し列だけを横スクロールにする (このタブ列に閉じる)  -->
    <TabControl.Styles>
      <Style Selector="TabItem">
        <Setter Property="Padding" Value="8,0" />
      </Style>
    </TabControl.Styles>
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <DockPanel>
          <ScrollViewer
              DockPanel.Dock="Top"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </ScrollViewer>
          <ContentPresenter
              Name="PART_SelectedContentHost"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              Content="{TemplateBinding SelectedContent}"
              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </DockPanel>
      </ControlTemplate>
    </TabControl.Template>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Common}">
      <views:CommonCleanView DataContext="{Binding Common}" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Advanced}">
      <views:AdvancedCleanView DataContext="{Binding Advanced}" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Slim}">
      <views:SlimView DataContext="{Binding Slim}" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Registry}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <views:RegistryCleanView DataContext="{Binding Registry}" />
          <views:RegistryRestoreView DataContext="{Binding RegistryRestore}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Settings}">
      <views:CleanupSettingsView DataContext="{Binding Settings}" />
    </TabItem>
    <TabItem Header="{DynamicResource Text.Cleanup.Tab.Other}">
      <views:CommandCategoryView DataContext="{Binding Other}" />
    </TabItem>
  </TabControl>
</UserControl>
