<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             xmlns:controls="using:Lumin4ti.UI.Controls"
             x:Class="Lumin4ti.UI.Views.RegistryRestoreView"
             x:DataType="vm:RegistryRestoreViewModel">

  <!--  レジストリ (復元側): バックアップ一覧・戻す (確認シートつき)・バックアップの削除 (確認シートつき)・結果。
        見出しは外枠 (CleanupView) が持つため、ここでは出さない。  -->
  <controls:CleanupPage Padding="0"
                        IsBusy="{Binding IsRunning}"
                        ProgressText="{Binding Label}"
                        IsResultVisible="{Binding HasResult}"
                        IsFooterVisible="False"
                        IsSheetOpen="{Binding IsSheetOpen}"
                        SheetCancelCommand="{Binding CancelSheetCommand}">

    <!--  ② 操作バー: 一覧の更新 (実行中は同じ場所が中断)  -->
    <controls:CleanupPage.Toolbar>
      <WrapPanel Orientation="Horizontal">
        <Button Margin="0,0,8,6" Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Refresh}"
                Command="{Binding RefreshCommand}" IsEnabled="{Binding CanOperate}"
                IsVisible="{Binding !IsRunning}" />
        <Button Margin="0,0,8,6" Content="{DynamicResource Text.Button.Cancel}"
                Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                IsVisible="{Binding IsRunning}" />
      </WrapPanel>
    </controls:CleanupPage.Toolbar>

    <!--  ④ 状態文  -->
    <controls:CleanupPage.Notices>
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}"
                 IsVisible="{Binding IsStatusVisible}" />
    </controls:CleanupPage.Notices>

    <!--  ⑤ 結果カード: 完全な成功だけ成功色。一部だけ戻せた・取消は警告色、失敗は赤。  -->
    <controls:CleanupPage.Result>
      <Border Classes="result"
              Classes.success="{Binding IsResultSuccess}"
              Classes.warning="{Binding IsResultWarning}"
              Classes.error="{Binding IsResultError}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ResultReasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" Text="{Binding ResultMoreText}" TextWrapping="Wrap"
                     IsVisible="{Binding ResultMoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding ResultMessageText}" TextWrapping="Wrap"
                     IsVisible="{Binding ResultMessageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </controls:CleanupPage.Result>

    <!--  ⑥ 本体: バックアップの一覧 (画面で唯一の縦スクロール)。無いときは空状態。  -->
    <controls:CleanupPage.Body>
      <Panel>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   Classes="caption" IsVisible="{Binding !HasBackups}"
                   Text="{DynamicResource Text.Cleanup.Registry.View.Backups.Empty}" />

        <ListBox Classes="cleanup-list" ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RegistryBackupRowViewModel">
              <Border Classes="list-row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding ItemCountText}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding ResultFileText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!--  コマンドと操作可否は行の ViewModel が親の画面から受け取って持つ (画面の切り替えで親が外れても警告が出ない)  -->
                    <Button Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Restore}"
                            Command="{Binding RequestRestoreCommand}" CommandParameter="{Binding}"
                            IsEnabled="{Binding CanOperate}" />
                    <Button Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Delete}"
                            Command="{Binding RequestDeleteCommand}" CommandParameter="{Binding}"
                            IsEnabled="{Binding CanOperate}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </controls:CleanupPage.Body>

    <!--  ⑧ 確認シート: 戻す前の確認と、バックアップの削除の確認 (同時には開かない)  -->
    <controls:CleanupPage.Sheet>
      <Panel>
        <!--  どちらも、ボタン行を下端に固定し、本文だけを 1 つの ScrollViewer に入れる。戻すのは削除ではないので強調色。  -->
        <Border Classes="sheet" IsVisible="{Binding IsConfirmingRestore}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{DynamicResource Text.Cleanup.Registry.View.Cancel}" Command="{Binding CancelRestoreCommand}" />
              <Button Classes="accent" Content="{DynamicResource Text.Cleanup.Registry.View.Backups.RestoreRun}"
                      Command="{Binding ConfirmRestoreCommand}" IsEnabled="{Binding CanOperate}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Text.Cleanup.Registry.View.Backups.RestoreConfirm.Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RestoreConfirmText}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Classes="sheet" IsVisible="{Binding IsConfirmingDelete}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{DynamicResource Text.Cleanup.Registry.View.Cancel}" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="danger" Content="{DynamicResource Text.Cleanup.Registry.View.Backups.DeleteRun}"
                      Command="{Binding ConfirmDeleteCommand}" IsEnabled="{Binding CanOperate}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DeleteConfirmText}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Panel>
    </controls:CleanupPage.Sheet>
  </controls:CleanupPage>
</UserControl>
