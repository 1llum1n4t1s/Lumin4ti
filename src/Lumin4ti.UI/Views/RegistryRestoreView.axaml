<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumin4ti.UI.ViewModels"
             x:Class="Lumin4ti.UI.Views.RegistryRestoreView"
             x:DataType="vm:RegistryRestoreViewModel">

  <!--  レジストリ (復元側): バックアップ一覧・復元・バックアップの削除 (確認つき)・結果。  -->
  <StackPanel Margin="8,16,8,0" Spacing="8">
    <TextBlock Text="{DynamicResource Text.Cleanup.Registry.View.Backups.Title}" FontSize="16" FontWeight="SemiBold" />

    <WrapPanel Orientation="Horizontal">
      <Button Margin="0,0,8,0" Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Refresh}"
              Command="{Binding RefreshCommand}" IsEnabled="{Binding CanOperate}" />
      <Button Margin="0,0,8,0" Content="{DynamicResource Text.Button.Cancel}"
              Command="{Binding CancelCommand}"
              IsVisible="{Binding IsRunning}" IsEnabled="{Binding CanCancel}" />
    </WrapPanel>

    <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
      <ProgressBar IsIndeterminate="True" Height="4" />
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <TextBlock Classes="caption" IsVisible="{Binding !HasBackups}"
               Text="{DynamicResource Text.Cleanup.Registry.View.Backups.Empty}" />

    <ItemsControl ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RegistryBackupRowViewModel">
          <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="8"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding CreatedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding ItemCountText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding ResultFileText}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Restore}"
                        Command="{Binding $parent[UserControl].((vm:RegistryRestoreViewModel)DataContext).RestoreCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:RegistryRestoreViewModel)DataContext).CanOperate}" />
                <Button Content="{DynamicResource Text.Cleanup.Registry.View.Backups.Delete}"
                        Command="{Binding $parent[UserControl].((vm:RegistryRestoreViewModel)DataContext).RequestDeleteCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding $parent[UserControl].((vm:RegistryRestoreViewModel)DataContext).CanOperate}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!--  バックアップの削除は確認を経る (戻せなくなるため)。  -->
    <Border Padding="12,10" CornerRadius="10" IsVisible="{Binding IsConfirmingDelete}"
            Background="#18FF3B30" BorderBrush="#66FF3B30" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="{DynamicResource Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DeleteConfirmText}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Button Classes="danger" Margin="0,0,8,0" Content="{DynamicResource Text.Cleanup.Registry.View.Backups.DeleteRun}"
                  Command="{Binding ConfirmDeleteCommand}" IsEnabled="{Binding CanOperate}" />
          <Button Content="{DynamicResource Text.Cleanup.Registry.View.Cancel}" Command="{Binding CancelDeleteCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!--  復元の結果: 要約・代表理由 (最大 8 行)。  -->
    <StackPanel Spacing="4" IsVisible="{Binding ResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding ResultReasons}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption" Text="{Binding ResultMoreText}" TextWrapping="Wrap"
                 IsVisible="{Binding ResultMoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding ResultMessageText}" TextWrapping="Wrap"
                 IsVisible="{Binding ResultMessageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
