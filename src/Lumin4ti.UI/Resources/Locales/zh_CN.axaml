  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">成功</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">部分完成</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">失败</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">已跳过</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">已停止</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">确认瘦身</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">将运行所选的 {0} 个项目（预计可释放空间：{1}）。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">运行前会创建还原点。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">不会创建还原点。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">确认无法撤销的操作</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">删除更新回滚数据后，已安装的更新将无法再卸载。此操作无法撤销。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">我了解已安装的更新将无法再卸载</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">已创建还原点。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">使用 {0} 创建的现有还原点（24 小时内不会再创建新的还原点）。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">没有可用的还原点</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">无法创建还原点：{0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">系统保护已关闭，因此无法创建还原点。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">不创建还原点并继续</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">停止</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">开启系统保护并重试</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">正在运行第 {0} 项，共 {1} 项：{2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">完成。已释放空间：{0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">部分项目未完成。请查看每个项目的结果。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">需要重新启动才能使更改生效。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">清理设置</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">设置已保存。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">无法保存设置。请查看日志。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">排除</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">被排除的项目不会被改动：既不会被扫描，也不会被删除。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">添加</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">从列表中移除</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">导入</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">导出</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">导入排除项</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">导出排除项</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">文件</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">示例：C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">文件夹</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">示例：C:\Users\me\Projects（包括子文件夹）</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">扩展名和文件名</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">示例：*.log 或 cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Cookie 域名</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">示例：example.com（包括子域名）</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">已添加。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">已在列表中。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">格式无效。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">已达到 {0} 条的上限。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">文件太大。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">无法读取该文件。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">文件格式无效。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">此版本无法读取该格式。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">条目太多，因此未导入任何内容。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">已添加 {0} 条（重复：{1} 条，被拒绝：{2} 条）。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">已导出到 {0}。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">无法导出：{0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">文件的删除方式</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">安全删除（覆盖一次后再删除）</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">删除文件前，先将其内容覆盖一次。在 SSD 上无法保证彻底擦除。具有硬链接的文件，以及压缩、稀疏或加密的文件，将不经覆盖直接删除。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">瘦身前创建还原点</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">如果最近 24 小时内已有还原点，则会重复使用。如果系统保护已关闭，你可以在确认后将其开启。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">打开系统还原</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">自定义文件夹</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">高级清理可以清空其内容的文件夹。不允许使用 Windows、Program Files、ProgramData、其他用户的配置文件、驱动器根目录以及包含凭据的位置。新添加的文件夹始终处于未选中状态。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">添加文件夹…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">选择自定义文件夹</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">用户自定义的扩展名和文件名</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">会加入高级清理的搜索。匹配的项目始终处于未选中状态。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">示例：*.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">内置模式</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">各项目的默认选择</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">覆盖标准清理中某个项目的推荐默认选择。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">恢复默认</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">遵循推荐</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">始终选中</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">从不选中</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">累计成果</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">尚未运行过。</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">“运行”对话框历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">最近使用的项目</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">远程桌面连接历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">“打开”和“保存”对话框历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">文件资源管理器搜索历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">映射网络驱动器历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">跳转列表</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Internet Explorer 历史记录和输入过的地址</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">程序启动历史记录（UserAssist）</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">当前用户的 Windows 错误报告</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">用户临时文件</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">系统临时文件</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">用户模式崩溃转储</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">系统内存转储</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Windows 错误报告</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Windows 更新协调器日志</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">ETL 跟踪日志</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Microsoft Defender 诊断日志</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">缩略图缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">图标缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Windows 字体缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">远程桌面位图缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">DirectX 着色器缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">旧的 Prefetch 数据</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">回收站</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">DNS 解析程序缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">网络使用情况历史记录</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">无效的快捷方式和“开始”菜单项</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">无效的计划任务</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Internet 缓存（WinINet）</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Office 加载项缓存</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">证书 URL 缓存（CryptnetUrlCache）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">孤立的 Windows Installer 文件</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">删除 Windows Installer 文件夹中未注册到任何产品或修补程序、且超过 30 天的 .msi 和 .msp 文件。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">如果无法完整读取注册信息，则此项目不可用。删除前会再次检查注册情况。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">更新回滚数据</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">使用 DISM /StartComponentCleanup /ResetBase，删除回滚已安装更新所需的数据。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">运行后，已安装的更新将无法再卸载。此操作无法撤销。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">更新备份（组件存储）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">使用 DISM /StartComponentCleanup 清理已被取代的组件。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">显示的空间是 DISM 的估算值，可能与实际释放的空间不同。这可能需要几分钟。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Windows 更新下载缓存</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">删除 SoftwareDistribution\Download 中的内容。运行期间会停止 Windows Update 和 BITS 服务，并在之后恢复。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">残留的修补程序缓存</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">停止 Windows Installer 服务，并删除 Installer\$PatchCache$ 中的内容。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">日后进行修复或卸载时，可能会要求提供原始安装介质。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">语言输入功能（日语）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">使用 DISM Remove-Capability 删除日语 Language.Basic 功能（拼写检查、文本预测等）。它不是输入法（IME）本身。仅当该语言未被显示语言、语言列表或键盘布局使用时才能运行。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">若要再次使用这些语言功能，需要重新添加。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">语言输入功能（韩语）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">使用 DISM Remove-Capability 删除韩语 Language.Basic 功能（拼写检查、文本预测等）。它不是输入法（IME）本身。仅当该语言未被显示语言、语言列表或键盘布局使用时才能运行。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">若要再次使用这些语言功能，需要重新添加。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">语言输入功能（中文，繁体）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">使用 DISM Remove-Capability 删除繁体中文 Language.Basic 功能（拼写检查、文本预测等）。它不是输入法（IME）本身。仅当该语言未被显示语言、语言列表或键盘布局使用时才能运行。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">若要再次使用这些语言功能，需要重新添加。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">语言输入功能（中文，简体）</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">使用 DISM Remove-Capability 删除简体中文 Language.Basic 功能（拼写检查、文本预测等）。它不是输入法（IME）本身。仅当该语言未被显示语言、语言列表或键盘布局使用时才能运行。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">若要再次使用这些语言功能，需要重新添加。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Windows 帮助文件</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">删除 Windows 帮助文件。在 Windows 10/11 上，这些文件受 Windows 资源保护的保护，因此通常没有可删除的内容。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">受 Windows 保护或归 TrustedInstaller 所有的文件将保持不动。绝不会获取所有权。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">默认壁纸</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">删除 Windows 的默认壁纸。在 Windows 10/11 上，这些文件受 Windows 资源保护的保护，因此通常没有可删除的内容。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">受 Windows 保护或归 TrustedInstaller 所有的文件将保持不动。绝不会获取所有权。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">示例音乐</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">仅删除 Windows 7 附带的已知示例歌曲。文件夹中的其他文件将保持不动。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">示例图片</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">仅删除 Windows 7 附带的已知示例图片。文件夹中的其他文件将保持不动。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">示例视频</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">仅删除 Windows 7 附带的已知示例视频。文件夹中的其他文件将保持不动。</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">展开或折叠 {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">无法完成删除。请查看日志。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">无法读取设置，因此为保护原始文件已禁用保存。更改仅在本次会话中生效。</x:String>
