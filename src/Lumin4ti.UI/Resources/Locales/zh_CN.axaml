  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">包含早于指定天数的文件</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">天数</x:String>
