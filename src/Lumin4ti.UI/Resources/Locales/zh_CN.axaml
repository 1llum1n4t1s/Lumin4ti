  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">使用 DISM 的项目可能需要几分钟或更长时间。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">就绪</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">无需清理</x:String>
