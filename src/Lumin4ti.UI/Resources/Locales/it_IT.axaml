  <x:String x:Key="Text.Cleanup.Impact.Rebuild" xml:space="preserve">Da ricostruire</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles" xml:space="preserve">I tuoi file</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace.Warning" xml:space="preserve">La cronologia di utilizzo andrà persa.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout.Warning" xml:space="preserve">L'eliminazione dei cookie può disconnetterti dai siti web.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild.Warning" xml:space="preserve">Il primo utilizzo dopo l'eliminazione può essere più lento mentre i dati vengono ricostruiti.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles.Warning" xml:space="preserve">Include file tuoi che non possono essere scaricati di nuovo. Selezionali singolarmente; prima dell'eliminazione ti viene chiesta un'altra conferma.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.NotRecommended" xml:space="preserve">Questa voce non è consigliata per impostazione predefinita. Verifica che cosa rimuove prima di selezionarla.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.JumpListPins" xml:space="preserve">Eliminando le Jump List vengono rimossi anche gli elementi che hai aggiunto alla barra delle applicazioni e al menu Start.</x:String>

  <!-- 通常: 状態・理由 -->
  <x:String x:Key="Text.Cleanup.State.Found" xml:space="preserve">Può essere eliminato</x:String>
  <x:String x:Key="Text.Cleanup.State.Empty" xml:space="preserve">Nulla da eliminare</x:String>
  <x:String x:Key="Text.Cleanup.State.Unmeasurable" xml:space="preserve">Numero sconosciuto</x:String>
  <x:String x:Key="Text.Cleanup.State.Unavailable" xml:space="preserve">Non disponibile</x:String>
  <x:String x:Key="Text.Cleanup.State.NotDetected" xml:space="preserve">Non rilevato</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeDifferentUser" xml:space="preserve">L'utente connesso e l'utente con privilegi elevati sono diversi, quindi le voci che riguardano le impostazioni e i dati di un utente sono disattivate.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeUnknown" xml:space="preserve">Non è stato possibile verificare l'utente connesso, quindi le voci che riguardano le impostazioni e i dati di un utente sono disattivate.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.TargetRejected" xml:space="preserve">La destinazione è stata rifiutata per motivi di sicurezza (percorso protetto, credenziali, collegamento e così via).</x:String>
  <x:String x:Key="Text.Cleanup.Reason.ScanFailed" xml:space="preserve">L'analisi non è riuscita.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.HandlerUnavailable" xml:space="preserve">Non può essere eseguito in questo ambiente.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.CustomFolderRejected" xml:space="preserve">Questo percorso non è consentito come cartella personalizzata, quindi viene ignorato.</x:String>

  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Pulizia standard</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Analizza prima ciò che può essere rimosso, poi elimina solo le voci selezionate. L'analisi non modifica nulla.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Non è ancora stata eseguita alcuna analisi. Premi Analizza per trovare ciò che può essere eliminato.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Analisi di {0} su {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Analisi completata: {0} voci, {1} file, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">L'analisi è stata interrotta.</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">L'analisi non è riuscita. Controlla il log.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">Il risultato dell'analisi non è aggiornato perché le impostazioni sono cambiate o è stata eseguita un'altra operazione. Analizza di nuovo.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Non è stato trovato nulla che possa essere eliminato.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{0} voci su {1} selezionate (circa {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">{0} voci vengono mantenute a causa delle tue esclusioni.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unreadable" xml:space="preserve">Non è stato possibile controllare {0} voci.</x:String>
  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} voci sono collegamenti e non vengono toccate.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">Può essere eseguito, ma il numero e la dimensione non possono essere misurati in anticipo.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">Esempio: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">In esecuzione: {0} (prima dell'eliminazione ti viene chiesto se chiuderlo)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">Servizi arrestati temporaneamente durante l'eliminazione: {0}</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Conferma eliminazione</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Elimina</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Indietro</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">Le {0} voci selezionate ({1} file, circa {2}) verranno eliminate definitivamente. Non vengono spostate nel Cestino e non possono essere ripristinate.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">Include {0} voci non consigliate. Controllale prima.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">Include {0} voci che possono disconnetterti (come i cookie).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} voci includono file tuoi che non possono essere scaricati di nuovo. Ti viene chiesta un'altra conferma.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">Capisco che i miei file verranno eliminati definitivamente</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">L'eliminazione sicura è attiva. I file vengono sovrascritti una volta prima dell'eliminazione (sugli SSD non è garantito).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Alcuni prodotti sono in esecuzione. Durante l'eliminazione ti viene chiesto se chiuderli.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">"{0}" è in esecuzione ({1}). Deve essere chiuso prima che i suoi dati vengano eliminati.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Chiudilo</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Salta questa voce</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Interrompi</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">Non è stato possibile chiudere "{0}" normalmente ({1}). Forzandone l'uscita si perde ogni dato non salvato.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Forza l'uscita</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">Non forzare l'uscita</x:String>

  <!-- 通常: 実行・結果 -->
  <x:String x:Key="Text.Cleanup.Run.Running" xml:space="preserve">Eliminazione di {0} su {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Done" xml:space="preserve">Eliminati {0} file e liberati {1}</x:String>
  <x:String x:Key="Text.Cleanup.Run.DonePartial" xml:space="preserve">Completato in parte: eliminati {0} file e liberati {1}. Alcune voci non sono riuscite o sono state saltate.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Canceled" xml:space="preserve">Interrotto. {0} file ({1}) erano già stati eliminati.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Stale" xml:space="preserve">Non è stato eliminato nulla perché il risultato dell'analisi non era aggiornato. Analizza di nuovo.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Retained" xml:space="preserve">{0} voci sono state mantenute a causa di esclusioni o di modifiche successive all'analisi.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Blocked" xml:space="preserve">Non è stato possibile eliminare {0} voci (in uso, autorizzazioni mancanti e così via).</x:String>
  <x:String x:Key="Text.Cleanup.Run.Wiped" xml:space="preserve">{0} voci sono state sovrascritte prima dell'eliminazione ({1} sono state eliminate senza sovrascrittura).</x:String>
  <x:String x:Key="Text.Cleanup.Run.ServiceResumeFailed" xml:space="preserve">Non è stato possibile riavviare un servizio arrestato temporaneamente. Controlla lo stato del servizio.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Succeeded" xml:space="preserve">Riuscito</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NothingToDo" xml:space="preserve">Nulla da fare</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Partial" xml:space="preserve">Completato in parte</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Failed" xml:space="preserve">Non riuscito</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Skipped" xml:space="preserve">Saltato</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Canceled" xml:space="preserve">Interrotto</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NotRun" xml:space="preserve">Non eseguito</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NotScanned" xml:space="preserve">Non analizzato, quindi non eliminato.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NothingFound" xml:space="preserve">Non c'era nulla da eliminare.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">Non può essere eseguito in questo ambiente.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.UserFilesNotConfirmed" xml:space="preserve">Non eliminato perché non è stata data la conferma per i tuoi file.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessRunningDeclined" xml:space="preserve">Saltato perché il prodotto è in esecuzione.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessUnverifiable" xml:space="preserve">Saltato perché non è stato possibile verificare il proprietario di un processo in esecuzione.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessStillRunning" xml:space="preserve">Saltato perché il prodotto non si è chiuso.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ForceTerminationDeclined" xml:space="preserve">Saltato perché la chiusura forzata non è stata approvata.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessIdentityMismatch" xml:space="preserve">Saltato perché non è stato possibile identificare il processo, quindi non è stato chiuso.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.TerminateFailed" xml:space="preserve">Saltato perché non è stato possibile chiudere il prodotto.</x:String>
