  <x:String x:Key="Text.Cleanup.Export.Header.Total" xml:space="preserve">Totale</x:String>

  <!-- 高度: 画面 -->
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">Pulizia avanzata</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">Cerca, tramite modelli, nelle unità selezionate i file che di solito si possono rimuovere senza rischi. L'analisi non modifica nulla. Controlla i risultati, poi elimina solo ciò che selezioni.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">Unità da analizzare</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">Rimovibile</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">Fissa</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">Includi i file da zero byte</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">Includi i collegamenti la cui destinazione non esiste</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">Includi i file più vecchi del numero di giorni indicato</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">Giorni</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">Seleziona solo le voci sicure</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">Predefiniti</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">Aggiuntivi</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">Definiti dall'utente</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">Sicuro</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">Indeterminabile</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">Definito dall'utente</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">File .chk fuori da una cartella FOUND. Potrebbe essere un checkpoint ESE, quindi resta deselezionato finché non lo controlli.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">Modificato nelle ultime 24 ore, quindi non è selezionato per impostazione predefinita.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">File da zero byte, quindi non è selezionato per impostazione predefinita.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">Trovato solo perché è vecchio, quindi non è selezionato per impostazione predefinita.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">Corrisponde a un modello che hai definito, quindi non è selezionato per impostazione predefinita.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">Modello di nome</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">Zero byte</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">Collegamento non valido</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">File vecchio</x:String>

  <!-- 高度: 走査・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">Controllate {0} cartelle e {1} file; {2} corrispondenze ({3}): {4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">Analisi completata: {0} corrispondenze ({1}) su {2} file controllati.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">Le corrispondenze sono troppe, quindi vengono mostrate solo le prime {0}. Le altre {1} ({2}) non vengono né mostrate né eliminate.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">Impossibile analizzare: {0} ({1})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">{0} cartelle non sono state controllate perché protette o escluse.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">Nessun file corrisponde.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">{0} file su {1} selezionati ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">Cartelle personalizzate</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">Viene svuotato solo il contenuto della cartella. La cartella stessa resta.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">Non trovata</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} file, {1}</x:String>

  <!-- 高度: 確認・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">I {0} file selezionati ({1}) e il contenuto di {2} cartelle personalizzate verranno eliminati definitivamente. Non vengono spostati nel Cestino e non possono essere ripristinati.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">Include {0} file contrassegnati come "indeterminabile". Deseleziona quelli che non hai controllato.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">Include {0} file modificati nelle ultime 24 ore.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Done" xml:space="preserve">Eliminati {0} file e {1} cartelle, liberati {2}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Partial" xml:space="preserve">Completato in parte: eliminati {0} file e {1} cartelle, liberati {2}. Alcune voci sono state mantenute o non è stato possibile eliminarle.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Expired" xml:space="preserve">Non è stato eliminato nulla perché il risultato dell'analisi non era aggiornato. Analizza di nuovo.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Cancelled" xml:space="preserve">Interrotto. {0} file ({1}) erano già stati eliminati.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Blocked" xml:space="preserve">Non è stato possibile eliminare {0} file (in uso, autorizzazioni mancanti e così via).</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Retained" xml:space="preserve">{0} file sono stati mantenuti a causa di esclusioni o di modifiche successive all'analisi.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Gone" xml:space="preserve">{0} file non esistevano più.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} file si trovano in una cartella personalizzata selezionata e non sono stati gestiti separatamente.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">{0} voci sono state rifiutate da un controllo di sicurezza.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">Questo percorso non può essere usato come cartella.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">Non si può usare la radice di un'unità.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">La cartella Windows e le sue cartelle superiori e inferiori non possono essere usate.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">Program Files e le sue cartelle superiori e inferiori non possono essere usate.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">ProgramData e le sue cartelle superiori e inferiori non possono essere usate.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">Il profilo di un altro utente non può essere usato.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">La cartella del tuo profilo e AppData non possono essere usate, perché svuotarle comporterebbe la perdita di tutti i tuoi dati.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">I percorsi che contengono credenziali o chiavi non possono essere usati.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Added" xml:space="preserve">La cartella personalizzata è stata aggiunta.</x:String>

  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Alleggerimento</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Libera spazio su disco rimuovendo i dati di cui Windows non ha bisogno. Alcune voci non sono reversibili o possono influire su riparazioni successive, quindi per impostazione predefinita non è selezionato nulla.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Esegui selezionati</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Crea un punto di ripristino prima dell'esecuzione</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Voce</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">Stato</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Spazio stimato</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">Circa {0} (stima)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Sconosciuto</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Non è ancora stata eseguita alcuna analisi. Premi Analizza per vedere quanto spazio può liberare ogni voce.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Controllo delle voci di alleggerimento…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Analisi completata. {0} voci possono essere eseguite.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">L'analisi non è riuscita. Controlla il log.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">Non è stato eseguito nulla perché il risultato dell'analisi non era aggiornato. Analizza di nuovo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Le voci che usano DISM possono richiedere diversi minuti o più.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Pronto</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Nulla da pulire</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">Non disponibile</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Nota</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Attenzione</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">Non reversibile</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">Non è stato possibile leggere completamente i dati di registrazione, quindi non si può valutare in sicurezza.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows protegge questi file, quindi non c'è nulla da rimuovere.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">È usata dalla lingua di visualizzazione, dall'elenco delle lingue o da un layout di tastiera, quindi non può essere rimossa.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">I dati di alcuni utenti non sono caricati, quindi non si può verificare l'utilizzo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">La destinazione non è installata o non è stata trovata.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">Non è stato possibile leggere o interpretare il risultato di DISM.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">Un controllo di sicurezza ha rifiutato la destinazione.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Riuscito</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Completato in parte</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">Non riuscito</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">Saltato</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">Interrotto</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Conferma alleggerimento</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">Le {0} voci selezionate (spazio stimato: {1}) verranno eseguite.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Prima dell'esecuzione viene creato un punto di ripristino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Non viene creato alcun punto di ripristino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Conferma di un'azione non reversibile</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Dopo la rimozione dei dati di rollback degli aggiornamenti, gli aggiornamenti già installati non potranno più essere disinstallati. L'operazione non è reversibile.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Capisco che gli aggiornamenti installati non potranno più essere disinstallati</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">È stato creato un punto di ripristino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Viene usato il punto di ripristino esistente creato il {0} (entro 24 ore non ne viene creato uno nuovo).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">Nessun punto di ripristino disponibile</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">Non è stato possibile creare un punto di ripristino: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">La protezione del sistema è disattivata, quindi non è possibile creare un punto di ripristino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Continua senza</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Interrompi</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Attiva la protezione del sistema e riprova</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Esecuzione di {0} su {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Completato. Spazio liberato: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Alcune voci non sono state completate. Controlla l'esito di ogni voce.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">È necessario riavviare perché le modifiche abbiano effetto.</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Impostazioni di pulizia</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Impostazioni salvate.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">Non è stato possibile salvare le impostazioni. Controlla il log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Esclusioni</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Le voci escluse non vengono toccate: non vengono né analizzate né eliminate.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Aggiungi</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Rimuovi dall'elenco</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Importa</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Esporta</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Importa esclusioni</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Esporta esclusioni</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Esempio: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Cartelle</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Esempio: C:\Users\me\Projects (comprese le sottocartelle)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Estensioni e nomi di file</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Esempio: *.log o cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Domini dei cookie</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Esempio: example.com (compresi i sottodomini)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Aggiunto.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Già presente nell'elenco.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">Il formato non è valido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">È stato raggiunto il limite di {0} voci.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">Il file è troppo grande.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">Non è stato possibile leggere il file.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">Il formato del file non è valido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Questa versione non può leggere quel formato.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Le voci sono troppe, quindi non è stato importato nulla.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">Aggiunte {0} (duplicati: {1}, rifiutati: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Esportato in {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Impossibile esportare: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Modalità di eliminazione dei file</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Eliminazione sicura (sovrascrivi una volta, poi elimina)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Sovrascrive una volta il contenuto di un file prima di eliminarlo. Sugli SSD non può garantire la cancellazione. I file con collegamenti reali (hard link) e i file compressi, sparsi o crittografati vengono eliminati senza sovrascrittura.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Crea un punto di ripristino prima dell'alleggerimento</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Un punto di ripristino esistente creato nelle ultime 24 ore viene riutilizzato. Se la protezione del sistema è disattivata, puoi attivarla dopo la conferma.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Apri Ripristino configurazione di sistema</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Cartelle personalizzate</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Cartelle il cui contenuto può essere svuotato dalla pulizia avanzata. Windows, Program Files, ProgramData, i profili di altri utenti, le radici delle unità e i percorsi con credenziali non sono consentiti. Le cartelle aggiunte partono sempre deselezionate.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Aggiungi una cartella…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Scegli una cartella personalizzata</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Estensioni e nomi di file definiti dall'utente</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Aggiunti alla ricerca della pulizia avanzata. Le corrispondenze partono sempre deselezionate.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Esempio: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Modelli integrati</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Selezione predefinita per voce</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Sostituisce la selezione predefinita consigliata di una voce nella pulizia standard.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Ripristina predefinito</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Segui il consiglio</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Seleziona sempre</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Non selezionare mai</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Risultati finora</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Non è ancora stato eseguito nulla.</x:String>

  <!-- Windows 項目の名称 (Definitions の nameKey) -->
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Cronologia della finestra Esegui</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Elementi recenti</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Cronologia delle connessioni Desktop remoto</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Cronologia delle finestre Apri e Salva</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Cronologia di ricerca di Esplora file</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Cronologia di Connetti unità di rete</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Jump List</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Cronologia di Internet Explorer e indirizzi digitati</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Cronologia dei programmi avviati (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Segnalazioni errori di Windows dell'utente corrente</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">File temporanei dell'utente</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">File temporanei di sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Dump di arresto anomalo in modalità utente</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Dump della memoria di sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Report di Segnalazione errori di Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Log dell'agente di orchestrazione di Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">Log di traccia ETL</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Log di diagnostica di Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Cache delle anteprime</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Cache delle icone</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Cache dei caratteri di Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Cache bitmap di Desktop remoto</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">Cache degli shader DirectX</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Vecchi dati Prefetch</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Cestino</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">Cache del resolver DNS</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Cronologia di utilizzo della rete</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Collegamenti e voci del menu Start non validi</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Attività pianificate non valide</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Cache di Internet (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Cache dei componenti aggiuntivi di Office</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Cache degli URL dei certificati (CryptnetUrlCache)</x:String>

  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">File orfani di Windows Installer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Elimina i file .msi e .msp nella cartella di Windows Installer che non sono associati ad alcun prodotto o patch e risalgono a più di 30 giorni fa.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Se i dati di registrazione non possono essere letti completamente, questa voce non è disponibile. Le registrazioni vengono ricontrollate subito prima dell'eliminazione.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Dati di rollback degli aggiornamenti</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Usa DISM /StartComponentCleanup /ResetBase per rimuovere i dati necessari per annullare gli aggiornamenti già installati.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Dopo l'esecuzione, gli aggiornamenti installati non potranno più essere disinstallati. L'operazione non è reversibile.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Backup degli aggiornamenti (archivio dei componenti)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Usa DISM /StartComponentCleanup per pulire i componenti sostituiti.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">Lo spazio mostrato è una stima di DISM e può differire da quello effettivamente liberato. L'operazione può richiedere diversi minuti.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Cache di download di Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Elimina il contenuto di SoftwareDistribution\Download. I servizi Windows Update e BITS vengono arrestati durante l'esecuzione e poi ripristinati.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Cache residua delle patch</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Arresta il servizio Windows Installer ed elimina il contenuto di Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Riparazioni o disinstallazioni successive potrebbero richiedere il supporto di installazione originale.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Funzionalità di input della lingua (giapponese)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Usa DISM Remove-Capability per rimuovere le funzionalità giapponesi di Language.Basic (controllo ortografico, previsione del testo e così via). Non riguarda l'IME stesso. Può essere eseguito solo se la lingua non è usata dalla lingua di visualizzazione, dall'elenco delle lingue o da un layout di tastiera.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Per usare di nuovo queste funzionalità della lingua dovrai aggiungerle nuovamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Funzionalità di input della lingua (coreano)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Usa DISM Remove-Capability per rimuovere le funzionalità coreane di Language.Basic (controllo ortografico, previsione del testo e così via). Non riguarda l'IME stesso. Può essere eseguito solo se la lingua non è usata dalla lingua di visualizzazione, dall'elenco delle lingue o da un layout di tastiera.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Per usare di nuovo queste funzionalità della lingua dovrai aggiungerle nuovamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Funzionalità di input della lingua (cinese tradizionale)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Usa DISM Remove-Capability per rimuovere le funzionalità di Language.Basic per il cinese tradizionale (controllo ortografico, previsione del testo e così via). Non riguarda l'IME stesso. Può essere eseguito solo se la lingua non è usata dalla lingua di visualizzazione, dall'elenco delle lingue o da un layout di tastiera.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Per usare di nuovo queste funzionalità della lingua dovrai aggiungerle nuovamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Funzionalità di input della lingua (cinese semplificato)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Usa DISM Remove-Capability per rimuovere le funzionalità di Language.Basic per il cinese semplificato (controllo ortografico, previsione del testo e così via). Non riguarda l'IME stesso. Può essere eseguito solo se la lingua non è usata dalla lingua di visualizzazione, dall'elenco delle lingue o da un layout di tastiera.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Per usare di nuovo queste funzionalità della lingua dovrai aggiungerle nuovamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">File della Guida di Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Elimina i file della Guida di Windows. In Windows 10/11 sono protetti dalla Protezione risorse di Windows, quindi di solito non c'è nulla da eliminare.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">I file protetti da Windows o di proprietà di TrustedInstaller non vengono toccati. La proprietà non viene mai acquisita.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Sfondi predefiniti</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Elimina gli sfondi predefiniti di Windows. In Windows 10/11 sono protetti dalla Protezione risorse di Windows, quindi di solito non c'è nulla da eliminare.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">I file protetti da Windows o di proprietà di TrustedInstaller non vengono toccati. La proprietà non viene mai acquisita.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Musica di esempio</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Elimina solo i brani di esempio noti forniti con Windows 7. Gli altri file nella cartella non vengono toccati.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Immagini di esempio</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Elimina solo le immagini di esempio note fornite con Windows 7. Gli altri file nella cartella non vengono toccati.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Video di esempio</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Elimina solo il video di esempio noto fornito con Windows 7. Gli altri file nella cartella non vengono toccati.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Espandi o comprimi {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">Non è stato possibile completare l'eliminazione. Controlla il log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">Non è stato possibile leggere le impostazioni, quindi il salvataggio è disattivato per proteggere il file originale. Le modifiche valgono solo per questa sessione.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">Non è stato possibile aprire Ripristino configurazione di sistema.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} aggiunto alle esclusioni. Le impostazioni sono cambiate, quindi analizza di nuovo.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} è già escluso.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">Impossibile aggiungere {0} alle esclusioni (formato non valido o limite raggiunto).</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">{0} è stato aggiunto alle esclusioni, ma non è stato possibile salvarlo. Vale solo fino alla chiusura dell'app.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">Seleziona un'unità o una cartella personalizzata da analizzare.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">Mostra tutti i tipi</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Action.IgnoreFolder" xml:space="preserve">Ignora questa cartella</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Kinds" xml:space="preserve">Risultati per tipo</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Failed" xml:space="preserve">Si è verificato un errore durante l'eliminazione. Controlla il log.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserScopeUnavailable" xml:space="preserve">Le regole specifiche dell'utente non possono essere usate (l'utente interattivo e l'utente con privilegi elevati sono diversi oppure non è stato possibile confermarli)</x:String>
