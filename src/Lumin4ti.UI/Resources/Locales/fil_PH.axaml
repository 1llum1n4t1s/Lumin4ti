  <x:String x:Key="Text.Cleanup.Registry.Ui.ScanDone" xml:space="preserve">Tapos na ang scan. {0} kandidato sa pagbura, {1} ang pinanatili.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ScanFailed" xml:space="preserve">Nabigo ang pag-scan.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Stale" xml:space="preserve">Walang pinatakbo dahil luma na ang resulta ng scan. I-scan muli.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ScanInvalidated" xml:space="preserve">Itinapon ang resulta ng scan dahil may naibalik na backup. I-scan muli.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Confirm.Body" xml:space="preserve">Buburahin ang {0} napiling registry entry. Magse-save muna ng backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Confirm.WithRestorePoint" xml:space="preserve">Gagawa ng restore point bago patakbuhin.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Walang gagawing restore point.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Running" xml:space="preserve">Binubura ang {0} entry…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.RunFailed" xml:space="preserve">Nabigo ang pagpapatakbo.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Success" xml:space="preserve">Nabura ang {0} entry.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Partial" xml:space="preserve">Nabura ang {0} entry; {1} ang hindi nabura.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Failed" xml:space="preserve">Walang nabura ({0} nabura, {1} hindi nabura).</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Canceled" xml:space="preserve">Kinansela ({0} nabura, {1} hindi nabura).</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ReasonLine" xml:space="preserve">{0}: {1} ({2} item)</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ReasonMore" xml:space="preserve">May {0} pang uri ng dahilan.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.BackupSaved" xml:space="preserve">Na-save ang backup: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.View32" xml:space="preserve">32-bit na view</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Retained" xml:space="preserve">Pinanatili ang {0} entry dahil hindi mahuhusgahan o protektado ang mga ito: {1}</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Deleted" xml:space="preserve">Nabura</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Retained" xml:space="preserve">Pinanatili</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Skipped" xml:space="preserve">Nilaktawan</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Failed" xml:space="preserve">Nabigo</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Restored" xml:space="preserve">Naibalik</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.AlreadyPresent" xml:space="preserve">Naroon na</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Conflict" xml:space="preserve">Salungatan</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.NotLoaded" xml:space="preserve">Hindi pa nila-load ang listahan ng backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Loaded" xml:space="preserve">{0} backup</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.ListFailed" xml:space="preserve">Hindi makuha ang listahan ng backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Count" xml:space="preserve">{0} entry</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.CountUnknown" xml:space="preserve">Hindi alam ang bilang ng entry</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.HasResult" xml:space="preserve">May result file</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.NoResult" xml:space="preserve">Walang result file</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteConfirm" xml:space="preserve">Buburahin ang backup mula {0}. Kapag nabura na, wala nang maibabalik mula rito.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Deleting" xml:space="preserve">Binubura ang backup…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Deleted" xml:space="preserve">Nabura ang backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteFailed" xml:space="preserve">Hindi nabura ang backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Restoring" xml:space="preserve">Ibinabalik ang backup…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Restore.Summary" xml:space="preserve">{0} naibalik, {1} naroon na, {2} salungatan, {3} nilaktawan, {4} nabigo.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Restore.Failed" xml:space="preserve">Nabigo ang pagbabalik.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Name" xml:space="preserve">Mga registration ng app (App Paths)</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Description" xml:space="preserve">Mga registration sa paglulunsad ng app na walang umiiral na target na executable.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Name" xml:space="preserve">Startup</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Description" xml:space="preserve">Mga registration na tumatakbo sa startup ng Windows na walang umiiral na executable. Kasamang binubura ang setting na enabled/disabled ng startup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Name" xml:space="preserve">Mga font</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Description" xml:space="preserve">Mga registration ng font na walang umiiral na font file.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Name" xml:space="preserve">Mga file association</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Description" xml:space="preserve">Mga association gaya ng "Open with" na wala na ang app. Hindi binabago ang mga setting ng default na app.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Name" xml:space="preserve">Impormasyon sa pag-uninstall</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Description" xml:space="preserve">Mga uninstall entry na parehong wala ang uninstaller at ang install location. Naka-off bilang default, at kailangan ng iyong pag-apruba ang bawat item.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Name" xml:space="preserve">Mga Shared DLL</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Description" xml:space="preserve">Mga reference count ng Shared DLL na wala ang DLL. Naka-off bilang default at hindi kasama sa "Piliin lahat".</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Title" xml:space="preserve">Registry</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ExcludedFromSelectAll" xml:space="preserve">Hindi kasama sa "Piliin lahat". Piliin nang isa-isa ang mga kailangan mo lang.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.RequiresApproval" xml:space="preserve">Para magbura, kailangan ng iyong pag-apruba ang bawat item sa screen ng kumpirmasyon.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.NoCandidates" xml:space="preserve">Walang kandidato.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ValueName" xml:space="preserve">Pangalan ng value:</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Approval.Title" xml:space="preserve">Kailangan ng hiwalay na pag-apruba ang mga sumusunod na item. Suriin ang mga ito at lagyan ng check ang maaaring burahin.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Title" xml:space="preserve">Mga backup at pagbabalik</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Refresh" xml:space="preserve">I-refresh ang listahan</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Empty" xml:space="preserve">Walang mga backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Restore" xml:space="preserve">Ibalik</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Delete" xml:space="preserve">Burahin ang backup</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title" xml:space="preserve">Burahin ang backup na ito?</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteRun" xml:space="preserve">Burahin</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Name" xml:space="preserve">Sample na recorded TV</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Description" xml:space="preserve">Binubura lamang ang kilalang sample na recording na kasama sa Windows 7. Hindi ginagalaw ang iba pang file sa folder.</x:String>
