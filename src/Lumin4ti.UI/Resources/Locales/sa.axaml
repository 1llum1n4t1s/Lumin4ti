  <x:String x:Key="Text.Cleanup.Column.Folder" xml:space="preserve">सञ्चिकाकोशः</x:String>
  <x:String x:Key="Text.Cleanup.Column.Modified" xml:space="preserve">परिवर्तितम्</x:String>
  <x:String x:Key="Text.Cleanup.Column.Rule" xml:space="preserve">नियमः</x:String>
  <x:String x:Key="Text.Cleanup.Column.Safety" xml:space="preserve">सुरक्षा</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Results" xml:space="preserve">अन्वीक्षणफलानि</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Progress" xml:space="preserve">अन्वीक्षणस्य प्रगतिः</x:String>
  <x:String x:Key="Text.Cleanup.A11y.SelectRow" xml:space="preserve">{0} चिनुत</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Row" xml:space="preserve">{0}, {1}, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Category.Windows" xml:space="preserve">Windows-तन्त्रम्</x:String>
  <x:String x:Key="Text.Cleanup.Category.StoreApps" xml:space="preserve">Store-अनुप्रयोगाः</x:String>
  <x:String x:Key="Text.Cleanup.Category.BrowserCache" xml:space="preserve">अन्वेषकसंग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Category.BrowserTrace" xml:space="preserve">अन्वेषकस्य इतिहासः चिह्नानि च</x:String>
  <x:String x:Key="Text.Cleanup.Category.Cookies" xml:space="preserve">Cookies</x:String>
  <x:String x:Key="Text.Cleanup.Category.Traces" xml:space="preserve">उपयोगचिह्नानि</x:String>
  <x:String x:Key="Text.Cleanup.Category.Components" xml:space="preserve">Windows-घटकाः</x:String>
  <x:String x:Key="Text.Cleanup.Category.Apps" xml:space="preserve">अन्ये अनुप्रयोगाः</x:String>
  <x:String x:Key="Text.Cleanup.Category.Custom" xml:space="preserve">स्वनिर्मिताः सञ्चिकाकोशाः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Cache" xml:space="preserve">{0}-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Log" xml:space="preserve">{0}-अभिलेखाः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Temp" xml:space="preserve">{0}-अस्थायिसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Dump" xml:space="preserve">{0}-dumps</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Thumbnail" xml:space="preserve">{0}-लघुचित्राणि</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Shader" xml:space="preserve">{0}-shader-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Report" xml:space="preserve">{0}-प्रतिवेदनानि</x:String>
  <x:String x:Key="Text.Cleanup.Kind.History" xml:space="preserve">{0}-इतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Form" xml:space="preserve">{0}-प्रपत्रदत्तांशः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Session" xml:space="preserve">{0}-सत्रदत्तांशः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Cookies" xml:space="preserve">{0}-cookies</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Recent" xml:space="preserve">{0}-अधुनातनमदाः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Backup" xml:space="preserve">{0}-प्रतिलिपयः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Downloads" xml:space="preserve">{0}-अवारोपितसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Other" xml:space="preserve">{0}</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Junk" xml:space="preserve">अनुपयोगिसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace" xml:space="preserve">उपयोगचिह्नानि</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout" xml:space="preserve">भवन्तं बहिः करोति</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild" xml:space="preserve">पुनर्निर्माणम् आवश्यकम्</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles" xml:space="preserve">भवतः सञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace.Warning" xml:space="preserve">भवतः उपयोगेतिहासः नश्यति।</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout.Warning" xml:space="preserve">Cookies-लोपनं जालस्थानेभ्यः भवन्तं बहिः कर्तुमर्हति।</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild.Warning" xml:space="preserve">लोपनानन्तरं प्रथमः उपयोगः मन्दः भवितुमर्हति, यतः दत्तांशः पुनर्निर्मीयते।</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles.Warning" xml:space="preserve">अस्मिन् भवतः ताः सञ्चिकाः सन्ति याः पुनः अवारोपयितुं न शक्यन्ते। ताः एकैकशः चिनुत; लोपनात् पूर्वं पुनः पुष्टिः पृच्छ्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Warning.NotRecommended" xml:space="preserve">अयं मदः स्वतः अनुशंसितः नास्ति। चयनात् पूर्वम् अयं किं निष्कासयति इति परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Warning.JumpListPins" xml:space="preserve">Jump Lists-लोपनेन taskbar-Start-सूच्यां च कीलिताः मदाः अपि निष्कास्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.State.Found" xml:space="preserve">लोपयोग्यम्</x:String>
  <x:String x:Key="Text.Cleanup.State.Empty" xml:space="preserve">लोपयोग्यं नास्ति</x:String>
  <x:String x:Key="Text.Cleanup.State.Unmeasurable" xml:space="preserve">सङ्ख्या अज्ञाता</x:String>
  <x:String x:Key="Text.Cleanup.State.Unavailable" xml:space="preserve">अनुपलब्धम्</x:String>
  <x:String x:Key="Text.Cleanup.State.NotDetected" xml:space="preserve">न ज्ञातम्</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeDifferentUser" xml:space="preserve">प्रविष्टः उपयोक्ता उन्नतः उपयोक्ता च भिन्नौ, अतः उपयोक्तुः विन्यासान् दत्तांशं च लक्षयन्तः मदाः निष्क्रियाः।</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeUnknown" xml:space="preserve">प्रविष्टः उपयोक्ता सत्यापयितुं न शक्तः, अतः उपयोक्तुः विन्यासान् दत्तांशं च लक्षयन्तः मदाः निष्क्रियाः।</x:String>
  <x:String x:Key="Text.Cleanup.Reason.TargetRejected" xml:space="preserve">सुरक्षार्थं लक्ष्यं निराकृतम् (रक्षितं स्थानम्, परिचयपत्रम्, सम्बन्धः इत्यादि)।</x:String>
  <x:String x:Key="Text.Cleanup.Reason.ScanFailed" xml:space="preserve">अन्वीक्षणं विफलम्।</x:String>
  <x:String x:Key="Text.Cleanup.Reason.HandlerUnavailable" xml:space="preserve">एतत् अस्मिन् पर्यावरणे चालयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Reason.CustomFolderRejected" xml:space="preserve">इदं स्थानं स्वनिर्मितसञ्चिकाकोशरूपेण अनुमतं नास्ति, अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">सामान्यं परिष्करणम्</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">प्रथमम् अन्वीक्षस्व यत् किं निष्कासयितुं शक्यते, ततः भवता चितान् मदान् एव लोपय। अन्वीक्षणं किमपि न परिवर्तयति।</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">अद्यापि किमपि नान्वीक्षितम्। लोपयोग्यं द्रष्टुम् अन्वीक्षस्व इति नुदत।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">{1}-मध्ये {0} अन्वीक्ष्यते: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">अन्वीक्षणं समाप्तम्: {0} मदाः, {1} सञ्चिकाः, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">अन्वीक्षणं स्थगितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">अन्वीक्षणं विफलम्। अभिलेखं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">विन्यासपरिवर्तनात् अन्यक्रियायाः वा कारणात् अन्वीक्षणफलं जीर्णम्। पुनरन्वीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">लोपयोग्यं किमपि न लब्धम्।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{1}-मध्ये {0} मदाः चिताः (प्रायः {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">भवतः अपवर्जनानां कारणात् {0} मदाः रक्षिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unreadable" xml:space="preserve">{0} मदाः परीक्षितुं न शक्ताः।</x:String>
  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} मदाः सम्बन्धाः सन्ति, अतः अस्पृष्टाः।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">एतत् चालयितुं शक्यते, किन्तु अस्य सङ्ख्या परिमाणं च पूर्वं मातुं न शक्येते।</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">उदाहरणम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">चलति: {0} (लोपनात् पूर्वं तत् पिधातव्यं वा इति पृच्छ्यते)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">लोपनकाले अस्थायिरूपेण स्थगिताः सेवाः: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">लोपनं पुष्टीकुरुत</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">लोपय</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">पृष्ठतः गच्छ</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">चिताः {0} मदाः ({1} सञ्चिकाः, प्रायः {2}) स्थायिरूपेण लोपयिष्यन्ते। ते Recycle Bin-मध्ये न नीयन्ते, पुनः प्रत्यानेतुं च न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">{0} अननुशंसिताः मदाः अन्तर्भूताः। प्रथमं तान् परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">{0} मदाः अन्तर्भूताः ये भवन्तं बहिः कर्तुमर्हन्ति (यथा cookies)।</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} मदेषु भवतः ताः सञ्चिकाः सन्ति याः पुनः अवारोपयितुं न शक्यन्ते। पुनः एकवारं पुष्टिः पृच्छ्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">मम सञ्चिकाः स्थायिरूपेण लोपयिष्यन्ते इति अहं जानामि</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">सुरक्षितलोपनं सक्रियम्। सञ्चिकाः लोपनात् पूर्वम् एकवारं पुनर्लिख्यन्ते (SSD-मध्ये एतत् आश्वासितुं न शक्यते)।</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">केचन उत्पादाः चलन्ति। लोपनकाले तान् पिधातव्यान् वा इति पृच्छ्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">"{0}" चलति ({1})। तस्य दत्तांशलोपनात् पूर्वं तत् पिधातव्यम्।</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">तत् पिधेहि</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">इमं मदं त्यज</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">स्थगय</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">"{0}" सामान्यरूपेण पिधातुं न शक्तम् ({1})। बलात् निर्गमने अरक्षितं सर्वं निवेशनं नश्यति।</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">बलात् निर्गच्छतु</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">बलात् मा निर्गच्छतु</x:String>
  <x:String x:Key="Text.Cleanup.Run.Running" xml:space="preserve">{1}-मध्ये {0} लोप्यते: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Done" xml:space="preserve">{0} सञ्चिकाः लोपिताः, {1} च रिक्तं कृतम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.DonePartial" xml:space="preserve">अंशतः पूर्णम्: {0} सञ्चिकाः लोपिताः, {1} च रिक्तं कृतम्। केचन मदाः विफलाः त्यक्ताः वा।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Canceled" xml:space="preserve">स्थगितम्। {0} सञ्चिकाः ({1}) पूर्वमेव लोपिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Stale" xml:space="preserve">अन्वीक्षणफलं जीर्णम् आसीत्, अतः किमपि न लोपितम्। पुनरन्वीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Retained" xml:space="preserve">अपवर्जनात् अन्वीक्षणानन्तरपरिवर्तनाद् वा {0} मदाः रक्षिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Blocked" xml:space="preserve">{0} मदाः लोपयितुं न शक्ताः (प्रयुक्ताः, अनुमतिः नास्ति इत्यादि)।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Wiped" xml:space="preserve">{0} मदाः लोपनात् पूर्वं पुनर्लिखिताः ({1} पुनर्लेखनं विना लोपिताः)।</x:String>
  <x:String x:Key="Text.Cleanup.Run.ServiceResumeFailed" xml:space="preserve">अस्थायिरूपेण स्थगिता एका सेवा पुनः आरब्धुं न शक्ता। सेवास्थितिं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Succeeded" xml:space="preserve">सफलम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NothingToDo" xml:space="preserve">कर्तव्यं नास्ति</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Partial" xml:space="preserve">अंशतः पूर्णम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Failed" xml:space="preserve">विफलम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Skipped" xml:space="preserve">त्यक्तम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Canceled" xml:space="preserve">स्थगितम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NotRun" xml:space="preserve">न चालितम्</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NotScanned" xml:space="preserve">न अन्वीक्षितम्, अतः न लोपितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NothingFound" xml:space="preserve">लोपयोग्यं किमपि नासीत्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">एतत् अस्मिन् पर्यावरणे चालयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.UserFilesNotConfirmed" xml:space="preserve">भवतः सञ्चिकानां पुष्टिः न दत्ता, अतः न लोपितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessRunningDeclined" xml:space="preserve">उत्पादः चलति इति कारणात् त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessUnverifiable" xml:space="preserve">चलतः प्रक्रमस्य स्वामी सत्यापयितुं न शक्तः, अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessStillRunning" xml:space="preserve">उत्पादः न पिहितः, अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ForceTerminationDeclined" xml:space="preserve">बलात् निर्गमनम् अननुमोदितं, अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessIdentityMismatch" xml:space="preserve">प्रक्रमः न मेलितः, अतः न पिहितः; अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.TerminateFailed" xml:space="preserve">उत्पादः पिधातुं न शक्तः, अतः त्यक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Totals.Last" xml:space="preserve">अन्तिमं चालनम्: {0} सञ्चिकाः, {1} ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Totals.Total" xml:space="preserve">योगः: {0} सञ्चिकाः, {1}</x:String>
  <x:String x:Key="Text.Cleanup.Export.Title" xml:space="preserve">अन्वीक्षणफलानि निर्यातय</x:String>
  <x:String x:Key="Text.Cleanup.Export.Done" xml:space="preserve">{0}-मध्ये निर्यातितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Export.Failed" xml:space="preserve">निर्यातयितुं न शक्तम्: {0}</x:String>
