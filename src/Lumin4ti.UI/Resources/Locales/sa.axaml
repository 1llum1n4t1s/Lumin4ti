  <x:String x:Key="Text.Cleanup.Export.Header.State" xml:space="preserve">स्थितिः</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Files" xml:space="preserve">सञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Items" xml:space="preserve">मदाः</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Bytes" xml:space="preserve">Bytes</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Retained" xml:space="preserve">रक्षितम्</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Status" xml:space="preserve">अवस्था</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Details" xml:space="preserve">विवरणानि</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Total" xml:space="preserve">योगः</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">उन्नतं परिष्करणम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">चितेषु drives-मध्ये प्रतिरूपेण ताः सञ्चिकाः अन्विष्यन्ते याः प्रायः निर्भयं निष्कास्याः। अन्वीक्षणं किमपि न परिवर्तयति। फलानि परीक्ष्य भवता चितानि एव लोपयतु।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">अन्वीक्षणीयाः drives</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">निष्कासनीयः</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">स्थिरः</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">शून्यबाइट-सञ्चिकाः अन्तर्भावय</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">लक्ष्यहीनान् shortcuts अन्तर्भावय</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">निर्दिष्टदिनसङ्ख्यायाः पुरातनीः सञ्चिकाः अन्तर्भावय</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">दिनानि</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">निर्भयान् मदान् एव चिनुत</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">पूर्वनिर्धारितम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">अतिरिक्तम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">उपयोक्तृनिर्दिष्टम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">निर्भयम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">निर्णेतुं न शक्यते</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">उपयोक्तृनिर्दिष्टम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">FOUND-सञ्चिकाकोशात् बहिः .chk सञ्चिका अस्ति। एषा ESE checkpoint भवितुमर्हति, अतः परीक्षणात् पूर्वम् अचिता तिष्ठति।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">गतेषु २४ होरासु परिवर्तिता, अतः स्वतः न चिता।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">शून्यबाइट-सञ्चिका, अतः स्वतः न चिता।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">केवलं पुरातनत्वात् मेलिता, अतः स्वतः न चिता।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">भवता निर्दिष्टेन प्रतिरूपेण मेलिता, अतः स्वतः न चिता।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">नामप्रतिरूपम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">शून्यबाइट्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">अमान्यः shortcut</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">पुरातना सञ्चिका</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">{0} सञ्चिकाकोशाः {1} सञ्चिकाः च परीक्षिताः; {2} मेलिताः ({3}): {4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">अन्वीक्षणं समाप्तम्: परीक्षितासु {2} सञ्चिकासु {0} मेलिताः ({1})।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">मेलनानि अतिबहूनि, अतः प्रथमाः {0} एव दर्श्यन्ते। अन्ये {1} ({2}) न दर्श्यन्ते न च लोप्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">अन्वीक्षितुं न शक्तम्: {0} ({1})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">{0} सञ्चिकाकोशाः रक्षिताः वर्जिताः वा इति कारणात् न परीक्षिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">काचिदपि सञ्चिका न मेलिता।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">{1}-मध्ये {0} सञ्चिकाः चिताः ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">स्वनिर्मिताः सञ्चिकाकोशाः</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">सञ्चिकाकोशस्य अन्तर्गतं केवलं रिक्तीक्रियते। सञ्चिकाकोशः स्वयं तिष्ठति।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">न लब्धम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} सञ्चिकाः, {1}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">चिताः {0} सञ्चिकाः ({1}) {2} स्वनिर्मितसञ्चिकाकोशानाम् अन्तर्गतं च स्थायिरूपेण लोपयिष्यन्ते। ते Recycle Bin-मध्ये न नीयन्ते, पुनः प्रत्यानेतुं च न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">"निर्णेतुं न शक्यते" इति चिह्निताः {0} सञ्चिकाः अन्तर्भूताः। यान् न परीक्षितवान् तान् चयनात् निष्कासयतु।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">गतेषु २४ होरासु परिवर्तिताः {0} सञ्चिकाः अन्तर्भूताः।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Done" xml:space="preserve">{0} सञ्चिकाः {1} सञ्चिकाकोशाश्च लोपिताः, {2} रिक्तं कृतम्</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Partial" xml:space="preserve">अंशतः पूर्णम्: {0} सञ्चिकाः {1} सञ्चिकाकोशाश्च लोपिताः, {2} रिक्तं कृतम्। केचन मदाः रक्षिताः लोपयितुं न शक्ताः वा।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Expired" xml:space="preserve">अन्वीक्षणफलं जीर्णम् आसीत्, अतः किमपि न लोपितम्। पुनरन्वीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Cancelled" xml:space="preserve">स्थगितम्। {0} सञ्चिकाः ({1}) पूर्वमेव लोपिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Blocked" xml:space="preserve">{0} सञ्चिकाः लोपयितुं न शक्ताः (प्रयुक्ताः, अनुमतिः नास्ति इत्यादि)।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Retained" xml:space="preserve">अपवर्जनात् अन्वीक्षणानन्तरपरिवर्तनाद् वा {0} सञ्चिकाः रक्षिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Gone" xml:space="preserve">{0} सञ्चिकाः अधुना न सन्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} सञ्चिकाः चितस्य स्वनिर्मितसञ्चिकाकोशस्य अन्तः सन्ति, अतः पृथक् न संसाधिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">{0} मदाः सुरक्षापरीक्षया निराकृताः।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">अयं पथः सञ्चिकाकोशरूपेण प्रयोक्तुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">drive-मूलं प्रयोक्तुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">Windows-सञ्चिकाकोशः तस्य जनकाः अपत्यानि च प्रयोक्तुं न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">Program Files तस्य जनकाः अपत्यानि च प्रयोक्तुं न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">ProgramData तस्य जनकाः अपत्यानि च प्रयोक्तुं न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">अन्यस्य उपयोक्तुः प्रोफाइलं प्रयोक्तुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">भवतः प्रोफाइल-सञ्चिकाकोशः AppData च प्रयोक्तुं न शक्येते, यतः तयोः रिक्तीकरणे भवतः सर्वः दत्तांशः नश्येत्।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">परिचयपत्राणि कुञ्जिकाः वा यत्र सन्ति तानि स्थानानि प्रयोक्तुं न शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Added" xml:space="preserve">स्वनिर्मितः सञ्चिकाकोशः योजितः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">लघूकरणम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Windows-मध्ये अनावश्यकं दत्तांशं निष्कास्य डिस्क्-स्थानं रिक्तीकरोति। केचन मदाः प्रत्यावर्तयितुं न शक्यन्ते वा भाविमरम्मतं प्रभावयितुम् अर्हन्ति, अतः स्वतः किमपि न चितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">चितानि चालय</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">चालनात् पूर्वं restore point निर्मिणुत</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">मदः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">अवस्था</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">अनुमानितं स्थानम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">प्रायः {0} (अनुमानम्)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">अज्ञातम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">अद्यापि किमपि नान्वीक्षितम्। प्रत्येकं मदः कियत् स्थानं रिक्तीकर्तुं शक्नोति इति द्रष्टुम् अन्वीक्षस्व इति नुदत।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">लघूकरणमदाः परीक्ष्यन्ते…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">अन्वीक्षणं समाप्तम्। {0} मदाः चालयितुं शक्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">अन्वीक्षणं विफलम्। अभिलेखं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">अन्वीक्षणफलं जीर्णम् आसीत्, अतः किमपि न चालितम्। पुनरन्वीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">DISM-उपयोगिनः मदाः कतिपयनिमेषान् अधिकं वा समयं गृह्णन्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">सज्जम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">परिष्करणीयं नास्ति</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">अनुपलब्धम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">सूचना</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">सावधानता</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">प्रत्यावर्तयितुं न शक्यम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">पञ्जीकरणदत्तांशः पूर्णतया पठितुं न शक्तः, अतः निर्भयतया निर्णेतुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows एतानि सञ्चिकाः रक्षति, अतः निष्कासनीयं किमपि नास्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">प्रदर्शनभाषया, भाषासूच्या, कुञ्जीपटविन्यासेन वा उपयुज्यते, अतः निष्कासयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">केषाञ्चित् उपयोक्तॄणां दत्तांशः न आरोपितः, अतः उपयोगः सत्यापयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">लक्ष्यं न स्थापितं न लब्धं वा।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">DISM-फलं पठितुं बोद्धुं वा न शक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">सुरक्षापरीक्षया लक्ष्यं निराकृतम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">सफलम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">अंशतः पूर्णम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">विफलम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">त्यक्तम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">स्थगितम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">लघूकरणं पुष्टीकुरुत</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">चिताः {0} मदाः (अनुमानितं स्थानम्: {1}) चालयिष्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">चालनात् पूर्वं restore point निर्मीयते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">restore point न निर्मीयते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">प्रत्यावर्तयितुम् अशक्यां क्रियां पुष्टीकुरुत</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">update-प्रत्यावर्तनदत्तांशस्य निष्कासनानन्तरं स्थापिताः updates पुनः अनिस्थापयितुं न शक्यन्ते। एतत् प्रत्यावर्तयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">स्थापिताः updates पुनः अनिस्थापयितुं न शक्यन्ते इति अहं जानामि</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">restore point निर्मितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">{0} काले निर्मितं विद्यमानं restore point प्रयुज्यते (२४ होरासु नूतनं न निर्मीयते)।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">restore point उपलब्धं नास्ति</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">restore point निर्मातुं न शक्तम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">तन्त्रसुरक्षा निष्क्रिया, अतः restore point निर्मातुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">तं विना अनुवर्तस्व</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">स्थगय</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">तन्त्रसुरक्षां सक्रियां कृत्वा पुनः प्रयतस्व</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">{1}-मध्ये {0} चल्यते: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">समाप्तम्। रिक्तीकृतं स्थानम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">केचन मदाः न समाप्ताः। प्रत्येकस्य मदस्य फलं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">परिवर्तनानां प्रभावार्थं पुनरारम्भः आवश्यकः।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">परिष्करणविन्यासाः</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">विन्यासाः रक्षिताः।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">विन्यासाः रक्षितुं न शक्ताः। अभिलेखं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">अपवर्जनानि</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">अपवर्जिताः मदाः अस्पृष्टाः तिष्ठन्ति: न अन्वीक्ष्यन्ते न लोप्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">योजय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">सूचितः निष्कासय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">आयातय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">निर्यातय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">अपवर्जनानि आयातय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">अपवर्जनानि निर्यातय</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">सञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">उदाहरणम्: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">सञ्चिकाकोशाः</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">उदाहरणम्: C:\Users\me\Projects (उपसञ्चिकाकोशाः अपि)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">विस्तारणानि सञ्चिकानामानि च</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">उदाहरणम्: *.log अथवा cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Cookie-डोमेन्स्</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">उदाहरणम्: example.com (उपडोमेन्स् अपि)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">योजितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">पूर्वमेव सूच्याम् अस्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">प्रारूपं मान्यं नास्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">{0} प्रविष्टीनां सीमा प्राप्ता।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">सञ्चिका अतिबृहती।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">सञ्चिका पठितुं न शक्ता।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">सञ्चिकाप्रारूपं मान्यं नास्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">इदं संस्करणं तत् प्रारूपं पठितुं न शक्नोति।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">प्रविष्टयः अतिबहूः, अतः किमपि नायातितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} योजितानि (द्विरुक्तानि: {1}, निराकृतानि: {2})।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">{0}-मध्ये निर्यातितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">निर्यातयितुं न शक्तम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">सञ्चिकानां लोपनप्रकारः</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">सुरक्षितलोपनम् (एकवारं पुनर्लिख्य लोपय)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">सञ्चिकायाः अन्तर्गतं लोपनात् पूर्वम् एकवारं पुनर्लिख्यते। SSD-मध्ये उच्छेदः आश्वासितुं न शक्यते। hard link-युक्ताः सञ्चिकाः सम्पीडिताः विरलाः गूढीकृताः वा सञ्चिकाः पुनर्लेखनं विना लोप्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">लघूकरणात् पूर्वं restore point निर्मिणुत</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">गतेषु २४ होरासु निर्मितं विद्यमानं restore point पुनः प्रयुज्यते। तन्त्रसुरक्षा निष्क्रिया चेत्, पुष्टेः अनन्तरं तां सक्रियां कर्तुं शक्नोति।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">System Restore विवृणु</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">स्वनिर्मिताः सञ्चिकाकोशाः</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">यासां सञ्चिकाकोशानाम् अन्तर्गतम् उन्नतं परिष्करणं रिक्तीकर्तुं शक्नोति। Windows, Program Files, ProgramData, अन्येषाम् उपयोक्तॄणां प्रोफाइलानि, drive-मूलानि, परिचयपत्रयुक्तानि स्थानानि च अनुमतानि न सन्ति। योजिताः सञ्चिकाकोशाः सदा अचिताः आरभन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">सञ्चिकाकोशं योजय…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">स्वनिर्मितं सञ्चिकाकोशं चिनुत</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">उपयोक्तृनिर्दिष्टानि विस्तारणानि सञ्चिकानामानि च</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">उन्नतपरिष्करणस्य अन्वेषणे योज्यन्ते। मेलनानि सदा अचितानि आरभन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">उदाहरणम्: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">अन्तर्निहितानि प्रतिरूपाणि</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">मदं प्रति पूर्वचयनम्</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">सामान्यपरिष्करणे मदस्य अनुशंसितं पूर्वनिर्धारितं चयनं प्रतिस्थापयति।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">पूर्वनिर्धारितं प्रत्यानय</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">अनुशंसां पालय</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">सदा चिनुत</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">कदापि मा चिनुत</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">अद्यावधि फलानि</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">अद्यापि किमपि न चालितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Run-संवादस्य इतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">अधुनातनमदाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Remote Desktop-सम्बन्धेतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Open तथा Save संवादानाम् इतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">File Explorer-अन्वेषणेतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Map network drive-इतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Jump Lists</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Internet Explorer-इतिहासः टङ्कितानि पत्तनानि च</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">प्रचालितकार्यक्रमाणाम् इतिहासः (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">वर्तमानप्रयोक्तुः Windows-दोषप्रतिवेदनानि</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">उपयोक्तुः अस्थायिसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">तन्त्रस्य अस्थायिसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">उपयोक्तृ-स्तरीय crash dumps</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">तन्त्रस्मृति-dumps</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Windows Error Reporting-प्रतिवेदनानि</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Windows Update orchestrator-अभिलेखाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">ETL trace-अभिलेखाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Microsoft Defender-निदानाभिलेखाः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">लघुचित्रसंग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">प्रतीकसंग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Windows-अक्षरसंग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Remote Desktop bitmap-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">DirectX shader-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">पुरातनः Prefetch-दत्तांशः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Recycle Bin</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">DNS-resolver-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">जालोपयोगेतिहासः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">अमान्याः shortcuts Start-सूचिप्रविष्टयश्च</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">अमान्यानि निर्धारितकार्याणि</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Internet-संग्रहः (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Office add-in-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">प्रमाणपत्र-URL-संग्रहः (CryptnetUrlCache)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">अनाथानि Windows Installer-सञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Windows Installer-सञ्चिकाकोशे ये .msi .msp च सञ्चिके कस्यचित् उत्पादस्य patch-स्य वा कृते पञ्जीकृते न स्तः, ३० दिनेभ्यः पुरातने च, ते लोपयति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">पञ्जीकरणदत्तांशः पूर्णतया पठितुं न शक्तः चेत् अयं मदः अनुपलब्धः। लोपनात् अव्यवहितं पूर्वं पञ्जीकरणानि पुनः परीक्ष्यन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">update-प्रत्यावर्तनदत्तांशः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">स्थापितानाम् updates-नां प्रत्यावर्तनार्थम् आवश्यकं दत्तांशं निष्कासयितुं DISM /StartComponentCleanup /ResetBase प्रयुनक्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">एतस्य चालनानन्तरं स्थापिताः updates पुनः अनिस्थापयितुं न शक्यन्ते। एतत् प्रत्यावर्तयितुं न शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">update-प्रतिलिपयः (component store)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">प्रतिस्थापितान् घटकान् परिष्कर्तुं DISM /StartComponentCleanup प्रयुनक्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">दर्शितं स्थानं DISM-इत्यस्य अनुमानम्, वस्तुतः रिक्तीकृतात् भिन्नं भवितुमर्हति। एतत् कतिपयनिमेषान् गृह्णीयात्।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Windows Update-अवारोपणसंग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">SoftwareDistribution\Download-इत्यस्य अन्तर्गतं लोपयति। चालनकाले Windows Update BITS च सेवे स्थगिते, पश्चात् पुनःस्थापिते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">अवशिष्टः patch-संग्रहः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Windows Installer-सेवां स्थगयित्वा Installer\$PatchCache$-इत्यस्य अन्तर्गतं लोपयति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">भाविमरम्मतम् अनिस्थापनं वा मूलस्थापनमाध्यमं याचितुमर्हति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">भाषादानसुविधाः (जापानी)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">DISM Remove-Capability प्रयुज्य जापानी Language.Basic सुविधाः (वर्णविन्यासः, पाठानुमानम् इत्यादि) निष्कासयति। एषा IME स्वयं न। भाषा प्रदर्शनभाषया, भाषासूच्या, कुञ्जीपटविन्यासेन वा अप्रयुक्ता चेदेव एतत् चालयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">एताः भाषासुविधाः पुनः प्रयोक्तुं ताः पुनः योजनीयाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">भाषादानसुविधाः (कोरियन्)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">DISM Remove-Capability प्रयुज्य कोरियन् Language.Basic सुविधाः (वर्णविन्यासः, पाठानुमानम् इत्यादि) निष्कासयति। एषा IME स्वयं न। भाषा प्रदर्शनभाषया, भाषासूच्या, कुञ्जीपटविन्यासेन वा अप्रयुक्ता चेदेव एतत् चालयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">एताः भाषासुविधाः पुनः प्रयोक्तुं ताः पुनः योजनीयाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">भाषादानसुविधाः (चीनी, पारम्परिकी)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">DISM Remove-Capability प्रयुज्य पारम्परिक-चीनी Language.Basic सुविधाः (वर्णविन्यासः, पाठानुमानम् इत्यादि) निष्कासयति। एषा IME स्वयं न। भाषा प्रदर्शनभाषया, भाषासूच्या, कुञ्जीपटविन्यासेन वा अप्रयुक्ता चेदेव एतत् चालयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">एताः भाषासुविधाः पुनः प्रयोक्तुं ताः पुनः योजनीयाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">भाषादानसुविधाः (चीनी, सरलीकृता)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">DISM Remove-Capability प्रयुज्य सरलीकृत-चीनी Language.Basic सुविधाः (वर्णविन्यासः, पाठानुमानम् इत्यादि) निष्कासयति। एषा IME स्वयं न। भाषा प्रदर्शनभाषया, भाषासूच्या, कुञ्जीपटविन्यासेन वा अप्रयुक्ता चेदेव एतत् चालयितुं शक्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">एताः भाषासुविधाः पुनः प्रयोक्तुं ताः पुनः योजनीयाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Windows-साहाय्यसञ्चिकाः</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Windows-साहाय्यसञ्चिकाः लोपयति। Windows 10/11-मध्ये ताः Windows Resource Protection-द्वारा रक्षिताः, अतः प्रायः लोपयोग्यं नास्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Windows-द्वारा रक्षिताः TrustedInstaller-स्वामिकाः वा सञ्चिकाः अस्पृष्टाः। स्वामित्वं कदापि न गृह्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">पूर्वनिर्धारितानि भित्तिचित्राणि</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Windows-इत्यस्य पूर्वनिर्धारितानि भित्तिचित्राणि लोपयति। Windows 10/11-मध्ये तानि Windows Resource Protection-द्वारा रक्षितानि, अतः प्रायः लोपयोग्यं नास्ति।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Windows-द्वारा रक्षिताः TrustedInstaller-स्वामिकाः वा सञ्चिकाः अस्पृष्टाः। स्वामित्वं कदापि न गृह्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">नमूनासङ्गीतम्</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Windows 7-सहितानि ज्ञातानि नमूनागीतानि एव लोपयति। सञ्चिकाकोशे अन्याः सञ्चिकाः अस्पृष्टाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">नमूनाचित्राणि</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Windows 7-सहितानि ज्ञातानि नमूनाचित्राणि एव लोपयति। सञ्चिकाकोशे अन्याः सञ्चिकाः अस्पृष्टाः।</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">नमूनाचलचित्राणि</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Windows 7-सहितं ज्ञातं नमूनाचलचित्रम् एव लोपयति। सञ्चिकाकोशे अन्याः सञ्चिकाः अस्पृष्टाः।</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">{0} विस्तारय सङ्कोचय वा</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">लोपनं पूर्णं कर्तुं न शक्तम्। अभिलेखं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">विन्यासाः पठितुं न शक्ताः, अतः मूलसञ्चिकायाः रक्षणार्थं रक्षणं निष्क्रियम्। परिवर्तनानि अस्मिन् सत्रे एव प्रवर्तन्ते।</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">System Restore विवर्तितुं न शक्तम्।</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} अपवर्जनेषु योजितम्। विन्यासाः परिवर्तिताः, अतः पुनरन्वीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} पूर्वमेव अपवर्जितम्।</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">{0} अपवर्जनेषु योजयितुं न शक्तम् (प्रारूपम् अमान्यं सीमा वा प्राप्ता)।</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">{0} अपवर्जनेषु योजितम्, किन्तु रक्षितुं न शक्तम्। एतत् अनुप्रयोगस्य पिधानपर्यन्तम् एव प्रवर्तते।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">अन्वीक्षितुं drive स्वनिर्मितं सञ्चिकाकोशं वा चिनुत।</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">सर्वान् प्रकारान् दर्शय</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Action.IgnoreFolder" xml:space="preserve">एतं सञ्चिकाकोशम् उपेक्षस्व</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Kinds" xml:space="preserve">प्रकारानुसारं फलानि</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Failed" xml:space="preserve">लोपनकाले दोषः जातः। अभिलेखं परीक्षताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserScopeUnavailable" xml:space="preserve">उपयोक्तृ-परिधिनियमाः प्रयोक्तुं न शक्यन्ते (संवादी उपयोक्ता उन्नतः उपयोक्ता च भिन्नौ, अथवा पुष्टिः न जाता)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejectedAtRun" xml:space="preserve">स्वनिर्मितः सञ्चिकाकोशः चालनकाले परीक्षया निराकृतः</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseOutsideProfile" xml:space="preserve">पर्यावरणचरः %{0}% वर्तमानप्रयोक्तुः प्रोफाइलात् बहिः सूचयति (अथवा प्रोफाइलं सत्यापयितुं न शक्तम्), अतः एतत् लक्ष्यं न प्रयुज्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseProtectedLocation" xml:space="preserve">पर्यावरणचरः %{0}% संरक्षितस्थानं सूचयति (ड्राइव्-मूलम्, Windows, Program Files, ProgramData, अन्यप्रयोक्तुः प्रोफाइलं वा), अतः एतत् लक्ष्यं न प्रयुज्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseMachineMismatch" xml:space="preserve">पर्यावरणचरः %{0}% तन्त्रस्य पूर्वनिर्धारितस्थानात् भिन्नः अस्ति, अतः एतत् लक्ष्यं न प्रयुज्यते।</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejected" xml:space="preserve">स्वनिर्मितः सञ्चिकाकोशः निराकृतः ({0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceStopFailed" xml:space="preserve">सेवा स्थगयितुं न शक्ता, अतः किमपि न लोपितम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DeleteFailed" xml:space="preserve">लोपनं पूर्णं कर्तुं न शक्तम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceResumeFailedList" xml:space="preserve">एका सेवा मूलस्थितौ प्रत्यानेतुं न शक्ता ({0}): {1}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceResumeFailed" xml:space="preserve">एका सेवा मूलस्थितौ प्रत्यानेतुं न शक्ता: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserRegistryOpenFailed" xml:space="preserve">उपयोक्तुः registry विवर्तितुं न शक्तम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.HandlerUnavailable" xml:space="preserve">handler {0} अनुपलब्धः</x:String>
  <x:String x:Key="Text.Cleanup.Msg.PathReason" xml:space="preserve">{0}: {1}{2}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniContentUnverified" xml:space="preserve"> (सञ्चिकाया अन्तर्गतं सत्यापयितुं न शक्तम्)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ExpansionTruncated" xml:space="preserve">विस्तारितानि लक्ष्याणि सीमां प्राप्तानि ({0}); शेषाणि न अन्तर्भूतानि</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbOpenFailed" xml:space="preserve">database विवर्तितुं न शक्तम् (SQLite {0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbConfigFailed" xml:space="preserve">सुरक्षाविन्यासः प्रयोक्तुं न शक्तः, अतः स्थगितम् ({0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbSqliteError" xml:space="preserve">SQLite दोषः {0}: {1}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbPinFailed" xml:space="preserve">database निर्भयतया कीलयितुं न शक्तम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbHardLinked" xml:space="preserve">hard link-युक्तं database लक्ष्यं न</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbTooLarge" xml:space="preserve">database लक्ष्यत्वाय अतिबृहत्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbIdentityUnverified" xml:space="preserve">database-सञ्चिका सत्यापयितुं न शक्ता</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbJournalPending" xml:space="preserve">अप्रक्रियमाणं journal अस्ति (प्रयुक्तं पुनःप्राप्तं वा न), अतः त्यक्तम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbIntegrityFailed" xml:space="preserve">database-इत्यस्य अखण्डतापरीक्षा विफला</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbVirtualTable" xml:space="preserve">virtual table-युक्तं database लक्ष्यं न</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbUnknownTable" xml:space="preserve">अपेक्षितं table {0} नास्ति (अज्ञातं schema)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbUnknownColumn" xml:space="preserve">table {0}-मध्ये अपेक्षितः column {1} नास्ति (अज्ञातं schema)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniUnconvertible" xml:space="preserve">सञ्चिका UTF-8, UTF-16 वा तन्त्रस्य ANSI code page-रूपेण निर्हानिः परिवर्तयितुं न शक्यते, अतः त्यक्ता</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniTooLarge" xml:space="preserve">सञ्चिका 1 MB-तः बृहती, अतः त्यक्ता</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniAmbiguousSection" xml:space="preserve">बहूनां sections-नां समानं नाम अस्ति लक्ष्यं च ज्ञातुं न शक्यते, अतः न परिवर्तितम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniRestored" xml:space="preserve">{0} (मूलपाठः पुनःस्थापितः)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniNotRestored" xml:space="preserve">{0} (मूलपाठः पुनःस्थापयितुं न शक्तः, अन्तर्गतम् अनिश्चितम्)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniChangedWhileReading" xml:space="preserve">पठनकाले अन्तर्गतं परिवर्तितम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniLengthChangedWhileReading" xml:space="preserve">पठनकाले दैर्घ्यं परिवर्तितम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniLengthChangedBeforeWrite" xml:space="preserve">लेखनात् पूर्वं दैर्घ्यं परिवर्तितम्</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniVerifyMismatch" xml:space="preserve">लेखनानन्तरं पुनःपठनं न मिलति</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistrySymlink" xml:space="preserve">registry symbolic link इति कारणात् वर्जितम्: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryDepthLimit" xml:space="preserve">सुरक्षितायाः पुनरावर्तनगभीरतायाः सीमा अतिक्रान्ता</x:String>
