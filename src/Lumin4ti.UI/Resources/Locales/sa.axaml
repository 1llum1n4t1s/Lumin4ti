  <x:String x:Key="Text.Cleanup.Msg.IeUrlHistoryFailed" xml:space="preserve">URL-इतिहासः मार्जयितुं न शक्तः (HRESULT=0x{0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IeClearFailed" xml:space="preserve">{0} मार्जयितुं न शक्तम् (Win32={1})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RecycleQueryFailed" xml:space="preserve">Recycle Bin पृष्टुं न शक्तम् (HRESULT=0x{0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RecycleVerifyFailed" xml:space="preserve">रिक्तीकरणानन्तरं Recycle Bin परीक्षितुं न शक्तम् (HRESULT=0x{0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RecycleRemaining" xml:space="preserve">Recycle Bin-मध्ये {0} मदाः अवशिष्टाः (HRESULT=0x{1})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.NetworkDpsResumeFailed" xml:space="preserve">DPS-सेवा मूलस्थितौ प्रत्यानेतुं न शक्ता: {0}। Windows Services-मध्ये Diagnostic Policy Service आरभताम्।</x:String>
  <x:String x:Key="Text.Cleanup.Msg.NetworkDeleteFailed" xml:space="preserve">जालोपयोगदत्तांशः लोपयितुं न शक्तः: {0}</x:String>
