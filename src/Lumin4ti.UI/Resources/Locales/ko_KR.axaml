  <x:String x:Key="Text.Cleanup.Column.Size" xml:space="preserve">크기</x:String>
  <x:String x:Key="Text.Cleanup.Column.Impact" xml:space="preserve">영향</x:String>
  <x:String x:Key="Text.Cleanup.Column.Folder" xml:space="preserve">폴더</x:String>
  <x:String x:Key="Text.Cleanup.Column.Modified" xml:space="preserve">수정한 날짜</x:String>
  <x:String x:Key="Text.Cleanup.Column.Rule" xml:space="preserve">규칙</x:String>
