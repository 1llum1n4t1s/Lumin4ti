  <x:String x:Key="Text.Cleanup.A11y.Row" xml:space="preserve">{0}, {1}, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Category.Windows" xml:space="preserve">Windows 시스템</x:String>
  <x:String x:Key="Text.Cleanup.Category.StoreApps" xml:space="preserve">Store 앱</x:String>
