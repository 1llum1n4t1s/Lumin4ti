  <x:String x:Key="Text.Cleanup.Category.BrowserTrace" xml:space="preserve">브라우저 기록 및 흔적</x:String>
  <x:String x:Key="Text.Cleanup.Category.Cookies" xml:space="preserve">쿠키</x:String>
  <x:String x:Key="Text.Cleanup.Category.Traces" xml:space="preserve">사용 흔적</x:String>
  <x:String x:Key="Text.Cleanup.Category.Components" xml:space="preserve">Windows 구성 요소</x:String>
  <x:String x:Key="Text.Cleanup.Category.Apps" xml:space="preserve">기타 앱</x:String>
  <x:String x:Key="Text.Cleanup.Category.Custom" xml:space="preserve">사용자 지정 폴더</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Cache" xml:space="preserve">{0} 캐시</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Log" xml:space="preserve">{0} 로그</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Temp" xml:space="preserve">{0} 임시 파일</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Dump" xml:space="preserve">{0} 덤프</x:String>
