<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    日本語はコード内の日本語マスター (各アクションの Label/Description、カテゴリ Caption、ステータス文言) を
    フォールバックとして使うため、ここには XAML の {DynamicResource} が直接参照するシェル文言だけを持つ。
    (Category/Status/Result/Action.* は App.Text のフォールバックで日本語になる)
  -->
  <x:String x:Key="Text.Tab.Update" xml:space="preserve">更新・セキュリティ</x:String>
  <x:String x:Key="Text.Tab.Cleanup" xml:space="preserve">クリーンアップ</x:String>
  <x:String x:Key="Text.Tab.Repair" xml:space="preserve">修復</x:String>
  <x:String x:Key="Text.Tab.Performance" xml:space="preserve">パフォーマンス</x:String>
  <x:String x:Key="Text.Tab.System" xml:space="preserve">システム設定</x:String>
  <x:String x:Key="Text.Tab.Organize" xml:space="preserve">整理・ソート</x:String>
  <x:String x:Key="Text.Tab.Version" xml:space="preserve">バージョン情報</x:String>
  <x:String x:Key="Text.Tab.Devices" xml:space="preserve">未接続デバイス</x:String>

  <!-- ===== 未接続デバイス ===== -->
  <x:String x:Key="Text.DeviceCleanup.Title" xml:space="preserve">未接続デバイス</x:String>
  <x:String x:Key="Text.DeviceCleanup.Description" xml:space="preserve">過去にインストールされたものの、現在は接続されていない Plug and Play デバイスを一覧表示します。個別選択または全選択して削除できます。</x:String>
  <x:String x:Key="Text.DeviceCleanup.Warning" xml:space="preserve">ソフトウェア／仮想デバイスを含む未接続デバイスを表示します。削除するとドライバーやデバイス固有の設定が初期化される場合があるため、不要と判断できる項目だけを選択してください。</x:String>
  <x:String x:Key="Text.DeviceCleanup.Refresh" xml:space="preserve">再読み込み</x:String>
  <x:String x:Key="Text.DeviceCleanup.SelectAll" xml:space="preserve">すべて選択</x:String>
  <x:String x:Key="Text.DeviceCleanup.ClearSelection" xml:space="preserve">選択解除</x:String>
  <x:String x:Key="Text.DeviceCleanup.RemoveSelected" xml:space="preserve">選択項目を削除</x:String>
  <x:String x:Key="Text.DeviceCleanup.Empty" xml:space="preserve">未接続のハードウェアデバイスは見つかりませんでした。</x:String>
  <x:String x:Key="Text.DeviceCleanup.ConfirmRemove" xml:space="preserve">デバイスを削除</x:String>
  <x:String x:Key="Text.DeviceCleanup.Loading" xml:space="preserve">未接続デバイスを検索しています…</x:String>
  <x:String x:Key="Text.DeviceCleanup.Selection" xml:space="preserve">{0} / {1} 件を選択中</x:String>
  <x:String x:Key="Text.DeviceCleanup.ConfirmText" xml:space="preserve">選択した {0} 件のデバイスを削除しますか？ 再接続するとドライバーは再検出されますが、デバイス固有の設定は初期化される場合があります。</x:String>
  <x:String x:Key="Text.DeviceCleanup.Loaded" xml:space="preserve">未接続デバイスを {0} 件検出しました。</x:String>
  <x:String x:Key="Text.DeviceCleanup.LoadFailed" xml:space="preserve">未接続デバイスを読み込めませんでした (ログを確認してください)。</x:String>
  <x:String x:Key="Text.DeviceCleanup.Removing" xml:space="preserve">削除中 {0} / {1}: {2}</x:String>
  <x:String x:Key="Text.DeviceCleanup.Completed" xml:space="preserve">{0} 件を削除、{1} 件をスキップ、{2} 件失敗しました。</x:String>
  <x:String x:Key="Text.DeviceCleanup.CompletedRestart" xml:space="preserve">{0} 件を削除、{1} 件をスキップ、{2} 件失敗しました。反映には PC の再起動が必要です。</x:String>

  <x:String x:Key="Text.Note.RequiresReboot" xml:space="preserve">※ 反映には PC の再起動が必要です</x:String>
  <x:String x:Key="Text.Note.LongRunning" xml:space="preserve">※ 実行に数分かかることがあります</x:String>
  <x:String x:Key="Text.Note.AffectsExplorer" xml:space="preserve">※ 変更時にエクスプローラーを自動再起動します</x:String>

  <x:String x:Key="Text.Button.Run" xml:space="preserve">実行</x:String>
  <x:String x:Key="Text.Button.Cancel" xml:space="preserve">中断</x:String>

  <x:String x:Key="Text.Version.Subtitle" xml:space="preserve">Windows を自分好みに整えるカスタマイズツール</x:String>
  <x:String x:Key="Text.Version.VersionLabel" xml:space="preserve">バージョン:</x:String>
  <x:String x:Key="Text.Version.CheckUpdate" xml:space="preserve">更新を確認</x:String>
  <x:String x:Key="Text.Version.ShowSkipped" xml:space="preserve">スキップした更新を再表示</x:String>
  <x:String x:Key="Text.Version.CheckOnStartup" xml:space="preserve">起動時に自動で更新を確認する</x:String>
  <x:String x:Key="Text.Version.LanguageHeader" xml:space="preserve">言語</x:String>
  <x:String x:Key="Text.Version.LanguageHint" xml:space="preserve">表示言語を選びます。</x:String>
  <x:String x:Key="Text.Version.FoldersHeader" xml:space="preserve">フォルダ</x:String>
  <x:String x:Key="Text.Version.OpenLogs" xml:space="preserve">ログフォルダを開く</x:String>
  <x:String x:Key="Text.Version.OpenSettings" xml:space="preserve">設定フォルダを開く</x:String>
  <x:String x:Key="Text.Action.edge-background-off.Label" xml:space="preserve">Edge のバックグラウンド常駐を無効化 (メモリ節約 100〜300MB)</x:String>
  <x:String x:Key="Text.Action.edge-background-off.Desc" xml:space="preserve">Microsoft Edge のバックグラウンドモードと Startup Boost をポリシーで無効化します。Edge を常用しない場合は約 100〜300MB のメモリを節約できます。Edge の起動が少し遅くなり、拡張機能の通知が届かなくなる場合があります。OFF にするとポリシーを削除して Edge の既定値へ戻します。</x:String>
  <x:String x:Key="Text.Status.Busy" xml:space="preserve">別のメンテナンス操作が実行中です。完了後にもう一度お試しください。</x:String>
  <x:String x:Key="Text.Result.Partial" xml:space="preserve">⚠ 一部完了しました</x:String>
  <x:String x:Key="Text.CheckList.Targets" xml:space="preserve">削除する対象を選ぶ</x:String>
  <x:String x:Key="Text.CheckList.SaveFailed" xml:space="preserve">この選択の前回の保存に失敗しました（ログを確認してください）。</x:String>
  <!-- ===== Update dialog / operation status ===== -->
  <x:String x:Key="Text.UpdateDialog.Title" xml:space="preserve">アップデート</x:String>
  <x:String x:Key="Text.UpdateDialog.AvailableHeader" xml:space="preserve">新しいバージョンがあります</x:String>
  <x:String x:Key="Text.UpdateDialog.DownloadAndInstall" xml:space="preserve">ダウンロードしてインストール</x:String>
  <x:String x:Key="Text.UpdateDialog.IgnoreThisVersion" xml:space="preserve">このバージョンをスキップ</x:String>
  <x:String x:Key="Text.UpdateDialog.UpToDateMessage" xml:space="preserve">お使いのバージョンは最新です</x:String>
  <x:String x:Key="Text.UpdateDialog.ErrorHeader" xml:space="preserve">更新の確認に失敗しました</x:String>
  <x:String x:Key="Text.UpdateDialog.Close" xml:space="preserve">閉じる</x:String>
  <x:String x:Key="Text.UpdateDialog.CheckingMessage" xml:space="preserve">更新を確認しています…</x:String>
  <x:String x:Key="Text.UpdateDialog.DevelopmentBuild" xml:space="preserve">開発ビルドのため更新確認はスキップされます (インストール版でのみ動作)</x:String>
  <x:String x:Key="Text.UpdateDialog.CheckFailed" xml:space="preserve">更新の確認に失敗しました: {0}</x:String>
  <x:String x:Key="Text.Status.Applying" xml:space="preserve">{0} を適用中…</x:String>
  <x:String x:Key="Text.Status.Applied" xml:space="preserve">{0} を変更しました</x:String>
  <x:String x:Key="Text.Status.ApplyFailed" xml:space="preserve">{0} の変更に失敗しました (ログを確認してください)</x:String>
  <x:String x:Key="Text.Shutdown.BlockReason" xml:space="preserve">Lumin4ti がメンテナンス操作の完了を待っています…</x:String>
  <x:String x:Key="Text.Toggle.RecallQueryFailed" xml:space="preserve">DISM で Recall の状態を取得できません。非対応環境や管理者権限の不足などが考えられます。詳細はログを確認してください。</x:String>
  <x:String x:Key="Text.Setting.DefaultFormat" xml:space="preserve">既定: {0}</x:String>
  <x:String x:Key="Text.Setting.DefaultEnvironment" xml:space="preserve">環境による／不明</x:String>
  <x:String x:Key="Text.Toggle.CustomState" xml:space="preserve">カスタム（ON/OFFを選択）</x:String>
  <x:String x:Key="Text.Toggle.CustomPlaceholder" xml:space="preserve">カスタム</x:String>
  <x:String x:Key="Text.Toggle.RecallStateMissing" xml:space="preserve">DISM の出力に Recall の状態が見つかりません。詳細はログを確認してください。</x:String>
  <x:String x:Key="Text.Toggle.RecallStateUnsupported" xml:space="preserve">DISM が返した Recall の状態を判定できません。詳細はログを確認してください。</x:String>
  <x:String x:Key="Text.Button.BatchOn" xml:space="preserve">一括ON</x:String>
  <x:String x:Key="Text.Button.BatchOff" xml:space="preserve">一括OFF</x:String>
  <x:String x:Key="Text.Action.uwp-background-off.Label" xml:space="preserve">UWPバックグラウンド実行</x:String>
  <x:String x:Key="Text.Action.uwp-background-off.Desc" xml:space="preserve">現在インストールされているStore（UWP）アプリを、一括OFFでバックグラウンド実行禁止、一括ONで明示的に許可します。ONはWindowsの標準設定へ戻す操作ではありません。新しいアプリを追加した後は再実行してください。以前のアプリ別設定は保存・復元しません。 変更するのはアプリ別設定です。実効の許可・禁止は、Windows全体の設定、組織ポリシー、各アプリの制約にも従います。</x:String>
  <x:String x:Key="Text.Setting.DefaultSystemManaged" xml:space="preserve">Windows / 各アプリの標準設定</x:String>
  <x:String x:Key="Text.Version.DevelopmentBuild" xml:space="preserve">開発ビルド</x:String>
  <x:String x:Key="Text.Version.Unavailable" xml:space="preserve">バージョンを取得できませんでした</x:String>
  <x:String x:Key="Text.Settings.SaveFailed" xml:space="preserve">言語・更新設定の前回の保存に失敗しました（ログを確認してください）。</x:String>
  <x:String x:Key="Text.Settings.SaveSuppressed" xml:space="preserve">設定を読み込めないため、原本を保護して保存を停止します。変更はこの起動中だけ有効です。</x:String>
  <x:String x:Key="Text.CheckList.Empty" xml:space="preserve">前回の確認では、対象が見つかりませんでした。</x:String>
  <x:String x:Key="Text.CheckList.RefreshHint" xml:space="preserve">一覧は開き直すと更新されます。実行時は除外されていない新しい対象も含みます。</x:String>
  <x:String x:Key="Text.Processing.Title" xml:space="preserve">処理中</x:String>
  <x:String x:Key="Text.Processing.Wait" xml:space="preserve">処理が完了するまでお待ちください。</x:String>
  <x:String x:Key="Text.Processing.Cancelling" xml:space="preserve">キャンセル後の後処理が完了するまでお待ちください。</x:String>

  <!-- ===== Cleanup (standard / advanced / slim / settings) ===== -->

  <!-- 内側タブ -->
  <x:String x:Key="Text.Cleanup.Tab.Common" xml:space="preserve">通常</x:String>
  <x:String x:Key="Text.Cleanup.Tab.Advanced" xml:space="preserve">高度</x:String>
  <x:String x:Key="Text.Cleanup.Tab.Slim" xml:space="preserve">スリム化</x:String>
  <x:String x:Key="Text.Cleanup.Tab.Settings" xml:space="preserve">設定</x:String>
  <x:String x:Key="Text.Cleanup.Tab.Other" xml:space="preserve">その他</x:String>
  <x:String x:Key="Text.Cleanup.Tab.Registry" xml:space="preserve">レジストリ</x:String>

  <!-- レジストリタブ -->
  <x:String x:Key="Text.Cleanup.Registry.View.Title" xml:space="preserve">レジストリ</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ExcludedFromSelectAll" xml:space="preserve">「すべて選択」の対象外です。必要な項目だけ個別に選んでください。</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.RequiresApproval" xml:space="preserve">削除するには、確認の画面で項目ごとの承認が必要です。</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.NoCandidates" xml:space="preserve">候補はありません。</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ValueName" xml:space="preserve">値名:</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Approval.Title" xml:space="preserve">次の項目は個別の承認が必要です。内容を確認し、削除してよい項目にチェックしてください。</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Refresh" xml:space="preserve">一覧を更新</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Empty" xml:space="preserve">バックアップはありません。</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Restore" xml:space="preserve">復元</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Delete" xml:space="preserve">バックアップを削除</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title" xml:space="preserve">バックアップを削除しますか</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteRun" xml:space="preserve">削除</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Confirm.Title" xml:space="preserve">レジストリの削除の確認</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Cancel" xml:space="preserve">キャンセル</x:String>

  <!-- 共通の操作・列見出し -->
  <x:String x:Key="Text.Cleanup.Action.Scan" xml:space="preserve">走査</x:String>
  <x:String x:Key="Text.Cleanup.Action.Rescan" xml:space="preserve">再走査</x:String>
  <x:String x:Key="Text.Cleanup.Action.CancelScan" xml:space="preserve">走査を中断</x:String>
  <x:String x:Key="Text.Cleanup.Action.Clean" xml:space="preserve">選択した項目を削除</x:String>
  <x:String x:Key="Text.Cleanup.Action.ExportText" xml:space="preserve">テキストで書き出す</x:String>
  <x:String x:Key="Text.Cleanup.Action.OpenLocation" xml:space="preserve">場所を開く</x:String>
  <x:String x:Key="Text.Cleanup.Action.Ignore" xml:space="preserve">無視（今後の走査から除外）</x:String>
  <x:String x:Key="Text.Cleanup.Select.Recommended" xml:space="preserve">おすすめ</x:String>
  <x:String x:Key="Text.Cleanup.Select.All" xml:space="preserve">すべて選択</x:String>
  <x:String x:Key="Text.Cleanup.Select.None" xml:space="preserve">すべて解除</x:String>
  <x:String x:Key="Text.Cleanup.Select.Invert" xml:space="preserve">選択を反転</x:String>
  <x:String x:Key="Text.Cleanup.Filter.Placeholder" xml:space="preserve">項目を絞り込む</x:String>
  <x:String x:Key="Text.Cleanup.Filter.HideEmpty" xml:space="preserve">削除できるものがない項目を隠す</x:String>
  <x:String x:Key="Text.Cleanup.Column.Name" xml:space="preserve">項目</x:String>
  <x:String x:Key="Text.Cleanup.Column.Category" xml:space="preserve">分類</x:String>
  <x:String x:Key="Text.Cleanup.Column.State" xml:space="preserve">状態</x:String>
  <x:String x:Key="Text.Cleanup.Column.Files" xml:space="preserve">ファイル数</x:String>
  <x:String x:Key="Text.Cleanup.Column.Size" xml:space="preserve">サイズ</x:String>
  <x:String x:Key="Text.Cleanup.Column.Impact" xml:space="preserve">影響</x:String>
  <x:String x:Key="Text.Cleanup.Column.Folder" xml:space="preserve">フォルダー</x:String>
  <x:String x:Key="Text.Cleanup.Column.Modified" xml:space="preserve">更新日時</x:String>
  <x:String x:Key="Text.Cleanup.Column.Rule" xml:space="preserve">規則</x:String>
  <x:String x:Key="Text.Cleanup.Column.Safety" xml:space="preserve">安全度</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Results" xml:space="preserve">走査結果の一覧</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Progress" xml:space="preserve">走査の進捗</x:String>

  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">通常のクリーンアップ</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">削除できるものを走査で調べてから、選んだ項目だけを削除します。走査では何も変更しません。</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">削除の確認</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">削除する</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">戻る</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">利用者のファイルが完全に削除されることを理解しました</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">終了する</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">この項目を飛ばす</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">中止</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">強制終了する</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">強制終了しない</x:String>

  <!-- 書き出し・場所を開く -->
  <x:String x:Key="Text.Cleanup.Export.Title" xml:space="preserve">走査結果を書き出す</x:String>

  <!-- 高度: 画面 -->
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">高度なクリーンアップ</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">選んだドライブ全体から、不要になりやすいファイルをパターンで探します。走査では何も変更しません。結果を確かめてから、選んだファイルだけを削除します。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">走査するドライブ</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">0 バイトのファイルを含める</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">リンク先がないショートカットを含める</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">指定した日数より古いファイルを含める</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">日数</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">安全なものだけ選ぶ</x:String>

  <!-- 高度: 走査・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">カスタムフォルダー</x:String>

  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">スリム化</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Windows の不要なデータを整理して容量を空けます。元に戻せない項目や、以後の修復に影響し得る項目があるため、すべて未選択から始まります。</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">選択した項目を実行</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">実行前に復元ポイントを作成する</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">項目</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">状態</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">空きの見込み</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">スリム化の確認</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">元に戻せない操作の確認</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">更新プログラムをアンインストールできなくなることを理解しました</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">復元ポイントを利用できません</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">復元ポイントなしで続行</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">中止</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">システムの保護を有効にして再試行</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">クリーンアップの設定</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">除外</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">除外したものは、走査にも削除にも使われず、そのまま残ります。</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">追加</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">リストから外す</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">インポート</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">エクスポート</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">除外のインポート</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">除外のエクスポート</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">削除の方法</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">安全な削除（1 回上書きしてから削除）</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">ファイルの内容を 1 回上書きしてから削除します。SSD では完全な消去を保証しません。ハードリンクのあるファイルと、圧縮・スパース・暗号化されたファイルは上書きせず、削除だけを行います。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">スリム化の前に復元ポイントを作成する</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">24 時間以内に作成された復元ポイントがあれば、それを利用します。システムの保護が無効なときは、確認のうえで有効にできます。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">システムの復元を開く</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">カスタムフォルダー</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">高度なクリーンアップで、中身だけを空にするフォルダーを指定します。Windows・Program Files・ProgramData・ほかの利用者のプロファイル・ドライブ直下・認証情報を含む場所は指定できません。追加したフォルダーは、毎回未選択から始まります。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">フォルダーを追加…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">カスタムフォルダーを選択</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">ユーザー定義の拡張子・ファイル名</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">高度なクリーンアップの検索に追加します。一致したものは、毎回未選択から始まります。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">組み込みのパターン</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">項目ごとの既定の選択</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">通常のクリーンアップで、おすすめに従う既定の選択を項目ごとに上書きします。</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">既定に戻す</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">実績</x:String>
  <x:String x:Key="Text.Cleanup.Ui.SelectMenu" xml:space="preserve">選択</x:String>
  <x:String x:Key="Text.Cleanup.Ui.MoreActions" xml:space="preserve">その他の操作</x:String>
  <x:String x:Key="Text.Cleanup.Ui.RowActions" xml:space="preserve">この項目の操作</x:String>
  <x:String x:Key="Text.Cleanup.Ui.NotScanned.Title" xml:space="preserve">まだ走査していません</x:String>
  <x:String x:Key="Text.Cleanup.Ui.NotScanned.Body" xml:space="preserve">走査だけでは何も削除されません</x:String>
  <x:String x:Key="Text.Cleanup.Ui.Sort" xml:space="preserve">並べ替え</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanScope" xml:space="preserve">走査する場所と条件</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Section.Clean" xml:space="preserve">不要な登録を削除</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Section.Backups" xml:space="preserve">バックアップから戻す</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.RestoreConfirm.Title" xml:space="preserve">このバックアップから戻しますか？</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.RestoreRun" xml:space="preserve">戻す</x:String>
  <!-- ===== /Cleanup ===== -->
</ResourceDictionary>
