  <x:String x:Key="Text.Cleanup.Run.Skip.NothingFound" xml:space="preserve">Não havia nada para excluir.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">Isso não pode ser executado neste ambiente.</x:String>
