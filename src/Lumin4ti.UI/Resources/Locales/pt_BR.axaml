  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Restored" xml:space="preserve">Restaurada</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.AlreadyPresent" xml:space="preserve">Já presente</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Conflict" xml:space="preserve">Conflito</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.NotLoaded" xml:space="preserve">A lista de backups não foi carregada.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Loaded" xml:space="preserve">{0} backups</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.ListFailed" xml:space="preserve">Não foi possível obter a lista de backups.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Count" xml:space="preserve">{0} entradas</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.CountUnknown" xml:space="preserve">Número de entradas desconhecido</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.HasResult" xml:space="preserve">Com arquivo de resultado</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.NoResult" xml:space="preserve">Sem arquivo de resultado</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteConfirm" xml:space="preserve">O backup de {0} será excluído. Depois de excluído, nada poderá ser restaurado a partir dele.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Deleting" xml:space="preserve">Excluindo o backup…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Deleted" xml:space="preserve">O backup foi excluído.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteFailed" xml:space="preserve">Não foi possível excluir o backup.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Restoring" xml:space="preserve">Restaurando o backup…</x:String>
