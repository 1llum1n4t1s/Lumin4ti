  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Enxugar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Libera espaço em disco removendo dados de que o Windows não precisa. Alguns itens não podem ser desfeitos ou podem afetar reparos futuros, por isso nada vem selecionado por padrão.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Executar selecionados</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Criar um ponto de restauração antes de executar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Item</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">Status</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Espaço estimado</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">Cerca de {0} (estimativa)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Desconhecido</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Nada foi verificado ainda. Pressione Verificar para ver quanto espaço cada item pode liberar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Verificando os itens para enxugar…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Verificação concluída. {0} itens podem ser executados.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">Falha na verificação. Consulte o log.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">Nada foi executado porque o resultado da verificação estava desatualizado. Verifique novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Itens que usam o DISM podem levar vários minutos ou mais.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Pronto</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Nada para limpar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">Indisponível</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Aviso</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Cuidado</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">Não pode ser desfeito</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">Os dados de registro não puderam ser lidos por completo, então isso não pode ser avaliado com segurança.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">O Windows protege esses arquivos, então não há nada para remover.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">É usado pelo idioma de exibição, pela lista de idiomas ou por um layout de teclado, então não pode ser removido.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">Os dados de alguns usuários não estão carregados, então o uso não pode ser verificado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">O destino não está instalado ou não foi encontrado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">Não foi possível ler ou entender o resultado do DISM.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">Uma verificação de segurança rejeitou o destino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Concluído</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Concluído em parte</x:String>
