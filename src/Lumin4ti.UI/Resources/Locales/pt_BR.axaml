  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Confirmar enxugamento</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">Os {0} itens selecionados serão executados (espaço estimado: {1}).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Um ponto de restauração é criado antes de executar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Nenhum ponto de restauração é criado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Confirmar uma ação que não pode ser desfeita</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Depois que os dados de reversão de atualizações forem removidos, as atualizações já instaladas não poderão mais ser desinstaladas. Isso não pode ser desfeito.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Entendo que as atualizações instaladas não poderão mais ser desinstaladas</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">Um ponto de restauração foi criado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Usando o ponto de restauração existente criado {0} (um novo não é criado em 24 horas).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">Nenhum ponto de restauração disponível</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">Não foi possível criar um ponto de restauração: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">A Proteção do Sistema está desativada, então não é possível criar um ponto de restauração.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Continuar sem ele</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Parar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Ativar a Proteção do Sistema e tentar novamente</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Executando {0} de {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Concluído. Espaço liberado: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Alguns itens não terminaram. Confira o resultado de cada item.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">É necessário reiniciar para que as alterações entrem em vigor.</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Configurações de limpeza</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Configurações salvas.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">Não foi possível salvar as configurações. Consulte o log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Exclusões</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Os itens excluídos são deixados em paz: não são verificados nem apagados.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Adicionar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Remover da lista</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Importar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Exportar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Importar exclusões</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Exportar exclusões</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">Arquivos</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Exemplo: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Pastas</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Exemplo: C:\Users\me\Projects (e subpastas)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Extensões e nomes de arquivo</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Exemplo: *.log ou cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Domínios de cookies</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Exemplo: example.com (e subdomínios)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Adicionado.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Já está na lista.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">O formato não é válido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">O limite de {0} entradas foi atingido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">O arquivo é grande demais.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">Não foi possível ler o arquivo.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">O formato do arquivo não é válido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Esta versão não consegue ler esse formato.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Há entradas demais, então nada foi importado.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} adicionados (duplicados: {1}, rejeitados: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Exportado para {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Não foi possível exportar: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Como os arquivos são excluídos</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Exclusão segura (sobrescrever uma vez e depois excluir)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Sobrescreve uma vez o conteúdo de um arquivo antes de excluí-lo. Isso não garante o apagamento em SSDs. Arquivos com links físicos e arquivos compactados, esparsos ou criptografados são excluídos sem sobrescrever.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Criar um ponto de restauração antes de enxugar</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Um ponto de restauração existente das últimas 24 horas é reutilizado. Se a Proteção do Sistema estiver desativada, você pode ativá-la após confirmar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Abrir Restauração do Sistema</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Pastas personalizadas</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Pastas cujo conteúdo a limpeza avançada pode esvaziar. Windows, Program Files, ProgramData, perfis de outros usuários, raízes de unidade e locais com credenciais não são permitidos. As pastas adicionadas sempre começam desmarcadas.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Adicionar uma pasta…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Escolher uma pasta personalizada</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Extensões e nomes de arquivo definidos pelo usuário</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Adicionados à busca da limpeza avançada. As correspondências sempre começam desmarcadas.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Exemplo: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Padrões internos</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Seleção padrão por item</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Substitui a seleção padrão recomendada de um item na limpeza padrão.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Restaurar padrão</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Seguir a recomendação</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Sempre selecionar</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Nunca selecionar</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Resultados até agora</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Nada foi executado ainda.</x:String>

  <!-- Windows 項目の名称 (Definitions の nameKey) -->
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Histórico da caixa Executar</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Itens recentes</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Histórico de conexões da Área de Trabalho Remota</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Histórico das caixas Abrir e Salvar</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Histórico de pesquisa do Explorador de Arquivos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Histórico de Mapear unidade de rede</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Listas de Atalhos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Histórico do Internet Explorer e endereços digitados</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Histórico de programas iniciados (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Relatórios de erros do Windows do usuário atual</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">Arquivos temporários do usuário</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">Arquivos temporários do sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Despejos de falha em modo de usuário</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Despejos de memória do sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Relatórios do Relatório de Erros do Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Logs do orquestrador do Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">Logs de rastreamento ETL</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Logs de diagnóstico do Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Cache de miniaturas</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Cache de ícones</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Cache de fontes do Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Cache de bitmaps da Área de Trabalho Remota</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">Cache de shaders do DirectX</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Dados antigos do Prefetch</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Lixeira</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">Cache do resolvedor de DNS</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Histórico de uso da rede</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Atalhos e entradas do menu Iniciar inválidos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Tarefas agendadas inválidas</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Cache da Internet (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Cache de suplementos do Office</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Cache de URLs de certificados (CryptnetUrlCache)</x:String>

  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Arquivos órfãos do Windows Installer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Exclui os arquivos .msi e .msp da pasta do Windows Installer que não estão registrados em nenhum produto ou patch e têm mais de 30 dias.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Se os dados de registro não puderem ser lidos por completo, este item fica indisponível. Os registros são verificados novamente logo antes de excluir.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Dados de reversão de atualizações</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Usa DISM /StartComponentCleanup /ResetBase para remover os dados necessários para reverter as atualizações já instaladas.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Depois de executar, as atualizações instaladas não poderão mais ser desinstaladas. Isso não pode ser desfeito.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Backups de atualizações (repositório de componentes)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Usa DISM /StartComponentCleanup para limpar os componentes substituídos.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">O espaço mostrado é uma estimativa do DISM e pode diferir do que realmente é liberado. Pode levar vários minutos.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Cache de download do Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Exclui o conteúdo de SoftwareDistribution\Download. Os serviços Windows Update e BITS são parados durante a execução e restaurados depois.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Cache de patches remanescente</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Para o serviço Windows Installer e exclui o conteúdo de Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Reparos ou desinstalações futuros podem pedir a mídia de instalação original.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Recursos de entrada de idioma (japonês)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Usa DISM Remove-Capability para remover os recursos Language.Basic do japonês (verificação ortográfica, previsão de texto etc.). Não é o IME em si. Só pode ser executado quando o idioma não é usado pelo idioma de exibição, pela lista de idiomas nem por um layout de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Para voltar a usar esses recursos de idioma, será preciso adicioná-los novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Recursos de entrada de idioma (coreano)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Usa DISM Remove-Capability para remover os recursos Language.Basic do coreano (verificação ortográfica, previsão de texto etc.). Não é o IME em si. Só pode ser executado quando o idioma não é usado pelo idioma de exibição, pela lista de idiomas nem por um layout de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Para voltar a usar esses recursos de idioma, será preciso adicioná-los novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Recursos de entrada de idioma (chinês tradicional)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Usa DISM Remove-Capability para remover os recursos Language.Basic do chinês tradicional (verificação ortográfica, previsão de texto etc.). Não é o IME em si. Só pode ser executado quando o idioma não é usado pelo idioma de exibição, pela lista de idiomas nem por um layout de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Para voltar a usar esses recursos de idioma, será preciso adicioná-los novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Recursos de entrada de idioma (chinês simplificado)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Usa DISM Remove-Capability para remover os recursos Language.Basic do chinês simplificado (verificação ortográfica, previsão de texto etc.). Não é o IME em si. Só pode ser executado quando o idioma não é usado pelo idioma de exibição, pela lista de idiomas nem por um layout de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Para voltar a usar esses recursos de idioma, será preciso adicioná-los novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Arquivos de Ajuda do Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Exclui os arquivos de Ajuda do Windows. No Windows 10/11 eles são protegidos pela Proteção de Recursos do Windows, então normalmente não há nada para excluir.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Arquivos protegidos pelo Windows ou pertencentes ao TrustedInstaller são deixados em paz. A propriedade nunca é assumida.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Papéis de parede padrão</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Exclui os papéis de parede padrão do Windows. No Windows 10/11 eles são protegidos pela Proteção de Recursos do Windows, então normalmente não há nada para excluir.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Arquivos protegidos pelo Windows ou pertencentes ao TrustedInstaller são deixados em paz. A propriedade nunca é assumida.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Músicas de exemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Exclui apenas as músicas de exemplo conhecidas que acompanhavam o Windows 7. Os demais arquivos da pasta são deixados em paz.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Imagens de exemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Exclui apenas as imagens de exemplo conhecidas que acompanhavam o Windows 7. Os demais arquivos da pasta são deixados em paz.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Vídeos de exemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Exclui apenas o vídeo de exemplo conhecido que acompanhava o Windows 7. Os demais arquivos da pasta são deixados em paz.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Expandir ou recolher {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">Não foi possível concluir a exclusão. Consulte o log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">Não foi possível ler as configurações, então o salvamento está desativado para proteger o arquivo original. As alterações valem apenas nesta sessão.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">Não foi possível abrir a Restauração do Sistema.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} foi adicionado às exclusões. As configurações mudaram; verifique novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} já está excluído.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">Não foi possível adicionar {0} às exclusões (formato inválido ou limite atingido).</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">{0} foi adicionado às exclusões, mas não foi possível salvar. Vale apenas até você fechar o aplicativo.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">Selecione uma unidade ou uma pasta personalizada para verificar.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">Mostrar todos os tipos</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Action.IgnoreFolder" xml:space="preserve">Ignorar esta pasta</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Kinds" xml:space="preserve">Resultados por tipo</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Failed" xml:space="preserve">Ocorreu um erro durante a exclusão. Consulte o log.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserScopeUnavailable" xml:space="preserve">Regras de escopo de usuário não podem ser usadas (o usuário interativo e o usuário com privilégios elevados são diferentes, ou não foi possível confirmar)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejectedAtRun" xml:space="preserve">A pasta personalizada foi rejeitada pela verificação em tempo de execução</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseOutsideProfile" xml:space="preserve">A variável de ambiente %{0}% aponta para fora do perfil do usuário atual (ou o perfil não pôde ser verificado); este destino não é usado.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseProtectedLocation" xml:space="preserve">A variável de ambiente %{0}% aponta para um local protegido (raiz da unidade, Windows, Program Files, ProgramData ou perfil de outro usuário); este destino não é usado.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseMachineMismatch" xml:space="preserve">A variável de ambiente %{0}% difere do local padrão do sistema; este destino não é usado.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejected" xml:space="preserve">A pasta personalizada foi rejeitada ({0})</x:String>
