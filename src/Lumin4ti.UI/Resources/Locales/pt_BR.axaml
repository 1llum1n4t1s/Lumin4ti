  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Limpeza padrão</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Verifique primeiro o que pode ser removido e depois exclua apenas os itens que você selecionar. A verificação não altera nada.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Nada foi verificado ainda. Pressione Verificar para encontrar o que pode ser excluído.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Verificando {0} de {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Verificação concluída: {0} itens, {1} arquivos, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">A verificação foi interrompida.</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">Falha na verificação. Consulte o log.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">O resultado da verificação está desatualizado porque as configurações mudaram ou outra operação foi executada. Verifique novamente.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Nada que possa ser excluído foi encontrado.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{0} de {1} itens selecionados (cerca de {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">{0} itens foram mantidos por causa das suas exclusões.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unreadable" xml:space="preserve">Não foi possível verificar {0} itens.</x:String>
  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} itens são links e não são alterados.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">Isso pode ser executado, mas a quantidade e o tamanho não podem ser medidos antes.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">Exemplo: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">Em execução: {0} (será perguntado se deseja fechá-lo antes de excluir)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">Serviços parados temporariamente durante a exclusão: {0}</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Confirmar exclusão</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Excluir</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Voltar</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">Os {0} itens selecionados ({1} arquivos, cerca de {2}) serão excluídos permanentemente. Eles não vão para a Lixeira e não podem ser restaurados.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">Inclui {0} itens não recomendados. Revise-os antes.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">Inclui {0} itens que podem desconectar você (como cookies).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} itens incluem arquivos seus que não podem ser baixados novamente. Será pedida mais uma confirmação.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">Entendo que meus arquivos serão excluídos permanentemente</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">A exclusão segura está ativada. Os arquivos são sobrescritos uma vez antes de serem excluídos (não é possível garantir isso em SSDs).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Alguns produtos estão em execução. Será perguntado se deseja fechá-los durante a exclusão.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">"{0}" está em execução ({1}). Ele precisa ser fechado antes de seus dados serem excluídos.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Fechar</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Ignorar este item</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Parar</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">Não foi possível fechar "{0}" normalmente ({1}). Forçar o encerramento faz perder o que não foi salvo.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Forçar encerramento</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">Não forçar encerramento</x:String>

  <!-- 通常: 実行・結果 -->
  <x:String x:Key="Text.Cleanup.Run.Running" xml:space="preserve">Excluindo {0} de {1}: {2}</x:String>
