  <x:String x:Key="Text.Cleanup.Registry.Ui.Confirm.WithRestorePoint" xml:space="preserve">Um ponto de restauração é criado antes da execução.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Nenhum ponto de restauração é criado.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Running" xml:space="preserve">Excluindo {0} entradas…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.RunFailed" xml:space="preserve">A execução falhou.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Success" xml:space="preserve">{0} entradas excluídas.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Partial" xml:space="preserve">{0} entradas excluídas; {1} não foram excluídas.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Failed" xml:space="preserve">Não foi possível excluir nada ({0} excluídas, {1} não excluídas).</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Result.Canceled" xml:space="preserve">Cancelado ({0} excluídas, {1} não excluídas).</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ReasonLine" xml:space="preserve">{0}: {1} ({2} itens)</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ReasonMore" xml:space="preserve">Há mais {0} tipos de motivos.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.BackupSaved" xml:space="preserve">Backup salvo: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.View32" xml:space="preserve">Visualização de 32 bits</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Retained" xml:space="preserve">{0} entradas foram mantidas porque não podem ser avaliadas ou estão protegidas: {1}</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Deleted" xml:space="preserve">Excluída</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Retained" xml:space="preserve">Mantida</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.State.Skipped" xml:space="preserve">Ignorada</x:String>
