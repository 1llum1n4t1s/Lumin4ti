  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} arquivos estão dentro de uma pasta personalizada selecionada e não foram tratados separadamente.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">{0} itens foram rejeitados por uma verificação de segurança.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">Este caminho não pode ser usado como pasta.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">A raiz de uma unidade não pode ser usada.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">A pasta do Windows e suas pastas superiores ou inferiores não podem ser usadas.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">Program Files e suas pastas superiores ou inferiores não podem ser usadas.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">ProgramData e suas pastas superiores ou inferiores não podem ser usadas.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">O perfil de outro usuário não pode ser usado.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">Sua pasta de perfil e o AppData não podem ser usados, pois esvaziá-los faria você perder todos os seus dados.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">Locais que contêm credenciais ou chaves não podem ser usados.</x:String>
