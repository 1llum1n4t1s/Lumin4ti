  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">Added {0} (duplicates: {1}, rejected: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Exported to {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Could not export: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">How files are deleted</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Secure delete (overwrite once, then delete)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Overwrites a file's contents once before deleting it. This cannot guarantee erasure on SSDs. Files with hard links, and compressed, sparse or encrypted files, are deleted without overwriting.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Create a restore point before slimming down</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">An existing restore point from the last 24 hours is reused. If system protection is off, you can turn it on after confirming.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Open System Restore</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Custom folders</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Folders whose contents the advanced cleanup can empty. Windows, Program Files, ProgramData, other users' profiles, drive roots and locations with credentials are not allowed. Added folders always start unselected.</x:String>
