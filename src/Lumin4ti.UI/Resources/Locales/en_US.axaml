  <!-- 高度: 画面 -->
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">Advanced cleanup</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">Searches the selected drives for files that are usually safe to remove, by pattern. Scanning changes nothing. Review the results, then delete only what you select.</x:String>
