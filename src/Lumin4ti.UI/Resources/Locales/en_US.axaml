  <x:String x:Key="Text.Cleanup.Run.Status.Succeeded" xml:space="preserve">Succeeded</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NothingToDo" xml:space="preserve">Nothing to do</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Partial" xml:space="preserve">Partly done</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Failed" xml:space="preserve">Failed</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Skipped" xml:space="preserve">Skipped</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Canceled" xml:space="preserve">Stopped</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NotRun" xml:space="preserve">Not run</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NotScanned" xml:space="preserve">Not scanned, so it is not deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NothingFound" xml:space="preserve">There was nothing to delete.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">This cannot run in this environment.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.UserFilesNotConfirmed" xml:space="preserve">Not deleted because the confirmation for your files was not given.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessRunningDeclined" xml:space="preserve">Skipped because the product is running.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessUnverifiable" xml:space="preserve">Skipped because the owner of a running process could not be verified.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessStillRunning" xml:space="preserve">Skipped because the product did not close.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ForceTerminationDeclined" xml:space="preserve">Skipped because force quit was not approved.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessIdentityMismatch" xml:space="preserve">Skipped because the process could not be matched, so it was not closed.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.TerminateFailed" xml:space="preserve">Skipped because the product could not be closed.</x:String>
