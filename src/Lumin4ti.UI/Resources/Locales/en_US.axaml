  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">User-defined</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">Safe</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">Cannot tell</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">User-defined</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">A .chk file outside a FOUND folder. It may be an ESE checkpoint, so it stays unselected until you check it.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">Modified within the last 24 hours, so it is not selected by default.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">A zero-byte file, so it is not selected by default.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">Matched only because it is old, so it is not selected by default.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">Matched a pattern you defined, so it is not selected by default.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">Name pattern</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">Zero bytes</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">Invalid shortcut</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">Old file</x:String>

  <!-- 高度: 走査・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">Checked {0} folders and {1} files; {2} matches ({3}): {4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">Scan complete: {0} matches ({1}) among {2} files checked.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">There are too many matches, so only the first {0} are shown. The other {1} ({2}) are neither shown nor deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">Could not scan: {0} ({1})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">{0} folders were not checked because they are protected or excluded.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">No files matched.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">{0} of {1} files selected ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">Custom folders</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">Only the contents of the folder are emptied. The folder itself stays.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">Not found</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} files, {1}</x:String>

  <!-- 高度: 確認・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">The {0} selected files ({1}) and the contents of {2} custom folders will be deleted permanently. They are not moved to the Recycle Bin and cannot be restored.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">Includes {0} files marked "cannot tell". Deselect any you have not checked.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">Includes {0} files modified within the last 24 hours.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Done" xml:space="preserve">Deleted {0} files and {1} folders, freeing {2}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Partial" xml:space="preserve">Partly done: deleted {0} files and {1} folders, freeing {2}. Some items were kept or could not be deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Expired" xml:space="preserve">Nothing was deleted because the scan result was out of date. Scan again.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Cancelled" xml:space="preserve">Stopped. {0} files ({1}) were already deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Blocked" xml:space="preserve">{0} files could not be deleted (in use, no permission, and so on).</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Retained" xml:space="preserve">{0} files were kept because of exclusions or changes after the scan.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Gone" xml:space="preserve">{0} files no longer existed.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} files are inside a selected custom folder and were not handled separately.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">{0} items were rejected by a safety check.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">This path cannot be used as a folder.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">A drive root cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">The Windows folder and its parents or children cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">Program Files and its parents or children cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">ProgramData and its parents or children cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">Another user's profile cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">Your profile folder and AppData cannot be used because emptying them would lose all your data.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">Locations that contain credentials or keys cannot be used.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Added" xml:space="preserve">The custom folder was added.</x:String>

  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Slim down</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Frees disk space by removing data Windows does not need. Some items cannot be undone or can affect later repairs, so nothing is selected by default.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Run selected</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Create a restore point before running</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Item</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">Status</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Estimated space</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">About {0} (estimate)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Unknown</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Nothing has been scanned yet. Press Scan to check how much space each item can free.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Checking the slim-down items…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Scan complete. {0} items can be run.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">Scanning failed. Check the log.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">Nothing was run because the scan result was out of date. Scan again.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Items that use DISM can take several minutes or more.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Ready</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Nothing to clean</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">Unavailable</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Note</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Caution</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">Cannot be undone</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">Registration data could not be read completely, so this cannot be judged safely.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows protects these files, so there is nothing to remove.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">It is used by the display language, the language list, or a keyboard layout, so it cannot be removed.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">Some users' data is not loaded, so usage cannot be verified.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">The target is not installed or was not found.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">The DISM result could not be read or understood.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">A safety check rejected the target.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Succeeded</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Partly done</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">Failed</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">Skipped</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">Stopped</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Confirm slim down</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">The {0} selected items (estimated space: {1}) will run.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">A restore point is created before running.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">No restore point is created.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Confirm an action that cannot be undone</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">After the update rollback data is removed, already installed updates can no longer be uninstalled. This cannot be undone.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">I understand that installed updates can no longer be uninstalled</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">A restore point was created.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Using the existing restore point created {0} (a new one is not created within 24 hours).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">No restore point is available</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">A restore point could not be created: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">System protection is off, so a restore point cannot be created.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Continue without one</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Stop</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Turn on system protection and retry</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Running {0} of {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Done. Space freed: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Some items did not finish. Check each item's result.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">A restart is required for the changes to take effect.</x:String>

