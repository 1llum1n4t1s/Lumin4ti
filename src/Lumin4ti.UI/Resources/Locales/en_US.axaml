  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Standard cleanup</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Scan first to see what can be removed, then delete only the items you select. Scanning changes nothing.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Nothing has been scanned yet. Press Scan to find what can be deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Scanning {0} of {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Scan complete: {0} items, {1} files, {2}</x:String>
