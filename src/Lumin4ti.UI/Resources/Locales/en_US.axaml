  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">Scanning failed. Check the log.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">The scan result is out of date because settings changed or another operation ran. Scan again.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Nothing that can be deleted was found.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{0} of {1} items selected (about {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">{0} items are kept because of your exclusions.</x:String>
