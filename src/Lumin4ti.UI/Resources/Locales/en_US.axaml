  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} items are links and are left untouched.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">This can run, but its count and size cannot be measured beforehand.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">Example: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">Running: {0} (you are asked whether to close it before deleting)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">Services stopped temporarily during deletion: {0}</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Confirm deletion</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Delete</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Go back</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">The {0} selected items ({1} files, about {2}) will be deleted permanently. They are not moved to the Recycle Bin and cannot be restored.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">Includes {0} items that are not recommended. Review them first.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">Includes {0} items that can sign you out (such as cookies).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} items include files of yours that cannot be downloaded again. You are asked to confirm once more.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">I understand that my files will be deleted permanently</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">Secure delete is on. Files are overwritten once before deletion (this cannot be guaranteed on SSDs).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Some products are running. You are asked whether to close them while deleting.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">"{0}" is running ({1}). It must be closed before its data is deleted.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Close it</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Skip this item</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Stop</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">"{0}" could not be closed normally ({1}). Forcing it to quit loses any unsaved input.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Force quit</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">Do not force quit</x:String>

  <!-- 通常: 実行・結果 -->
  <x:String x:Key="Text.Cleanup.Run.Running" xml:space="preserve">Deleting {0} of {1}: {2}</x:String>
