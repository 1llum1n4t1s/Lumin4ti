  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Orphaned Windows Installer files</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Deletes .msi and .msp files in the Windows Installer folder that are not registered to any product or patch and are older than 30 days.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">If registration data cannot be read completely, this item is unavailable. Registrations are checked again just before deleting.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Update rollback data</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Uses DISM /StartComponentCleanup /ResetBase to remove the data needed to roll back updates that are already installed.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">After this runs, installed updates can no longer be uninstalled. This cannot be undone.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Update backups (component store)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Uses DISM /StartComponentCleanup to clean up superseded components.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">The space shown is a DISM estimate and can differ from what is actually freed. This can take several minutes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Windows Update download cache</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Deletes the contents of SoftwareDistribution\Download. The Windows Update and BITS services are stopped during the run and restored afterwards.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Leftover patch cache</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Stops the Windows Installer service and deletes the contents of Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Later repairs or uninstalls may ask for the original installation media.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Language input features (Japanese)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Uses DISM Remove-Capability to remove the Japanese Language.Basic features (spelling, text prediction and so on). It is not the IME itself. It can run only when the language is not used by the display language, the language list or a keyboard layout.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">To use these language features again, you need to add them back.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Language input features (Korean)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Uses DISM Remove-Capability to remove the Korean Language.Basic features (spelling, text prediction and so on). It is not the IME itself. It can run only when the language is not used by the display language, the language list or a keyboard layout.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">To use these language features again, you need to add them back.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Language input features (Chinese, Traditional)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Uses DISM Remove-Capability to remove the Traditional Chinese Language.Basic features (spelling, text prediction and so on). It is not the IME itself. It can run only when the language is not used by the display language, the language list or a keyboard layout.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">To use these language features again, you need to add them back.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Language input features (Chinese, Simplified)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Uses DISM Remove-Capability to remove the Simplified Chinese Language.Basic features (spelling, text prediction and so on). It is not the IME itself. It can run only when the language is not used by the display language, the language list or a keyboard layout.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">To use these language features again, you need to add them back.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Windows Help files</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Deletes Windows Help files. On Windows 10/11 these are protected by Windows Resource Protection, so there is usually nothing to delete.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Files protected by Windows or owned by TrustedInstaller are left alone. Ownership is never taken.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Default wallpapers</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Deletes the default Windows wallpapers. On Windows 10/11 these are protected by Windows Resource Protection, so there is usually nothing to delete.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Files protected by Windows or owned by TrustedInstaller are left alone. Ownership is never taken.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Sample music</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Deletes only the known sample songs that shipped with Windows 7. Other files in the folder are left alone.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Sample pictures</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Deletes only the known sample pictures that shipped with Windows 7. Other files in the folder are left alone.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Sample videos</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Deletes only the known sample video that shipped with Windows 7. Other files in the folder are left alone.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Expand or collapse {0}</x:String>
