  <!-- ===== Tabs ===== -->
  <x:String x:Key="Text.Tab.Update" xml:space="preserve">Pembaruan &amp; Keamanan</x:String>
  <x:String x:Key="Text.Tab.Cleanup" xml:space="preserve">Pembersihan</x:String>
  <x:String x:Key="Text.Tab.Repair" xml:space="preserve">Perbaikan</x:String>
