  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">{0} item yang dipilih (perkiraan ruang: {1}) akan dijalankan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Titik pemulihan dibuat sebelum menjalankan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Titik pemulihan tidak dibuat.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Konfirmasi tindakan yang tidak dapat dibatalkan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Setelah data pemutaran balik pembaruan dihapus, pembaruan yang sudah terinstal tidak dapat lagi dicopot. Tindakan ini tidak dapat dibatalkan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Saya memahami bahwa pembaruan yang terinstal tidak dapat lagi dicopot</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">Titik pemulihan dibuat.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Menggunakan titik pemulihan yang ada, dibuat {0} (titik baru tidak dibuat dalam 24 jam).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">Tidak ada titik pemulihan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">Titik pemulihan tidak dapat dibuat: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">Perlindungan sistem nonaktif, sehingga titik pemulihan tidak dapat dibuat.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Lanjutkan tanpa titik pemulihan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Hentikan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Aktifkan perlindungan sistem lalu coba lagi</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Menjalankan {0} dari {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Selesai. Ruang yang dibebaskan: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Beberapa item tidak selesai. Periksa hasil setiap item.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">Mulai ulang diperlukan agar perubahan berlaku.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Pengaturan pembersihan</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Pengaturan disimpan.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">Pengaturan tidak dapat disimpan. Periksa log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Pengecualian</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Item yang dikecualikan dibiarkan: tidak dipindai dan tidak dihapus.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Tambah</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Hapus dari daftar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Impor</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Ekspor</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Impor pengecualian</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Ekspor pengecualian</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Contoh: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Folder</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Contoh: C:\Users\me\Projects (termasuk subfolder)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Ekstensi dan nama file</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Contoh: *.log atau cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Domain cookie</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Contoh: example.com (termasuk subdomain)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Ditambahkan.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Sudah ada dalam daftar.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">Format tidak valid.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">Batas {0} entri tercapai.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">File terlalu besar.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">File tidak dapat dibaca.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">Format file tidak valid.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Versi ini tidak dapat membaca format tersebut.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Entri terlalu banyak, sehingga tidak ada yang diimpor.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} ditambahkan (duplikat: {1}, ditolak: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Diekspor ke {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Tidak dapat mengekspor: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Cara file dihapus</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Penghapusan aman (timpa sekali, lalu hapus)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Menimpa isi file satu kali sebelum menghapusnya. Ini tidak dapat menjamin data terhapus pada SSD. File dengan hard link, serta file terkompresi, sparse, atau terenkripsi, dihapus tanpa ditimpa.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Buat titik pemulihan sebelum meringkas</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Titik pemulihan yang ada dari 24 jam terakhir akan digunakan kembali. Jika perlindungan sistem nonaktif, Anda dapat mengaktifkannya setelah konfirmasi.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Buka Pemulihan Sistem</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Folder kustom</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Folder yang isinya dapat dikosongkan oleh pembersihan lanjutan. Windows, Program Files, ProgramData, profil pengguna lain, root drive, dan lokasi berisi kredensial tidak diizinkan. Folder yang ditambahkan selalu dimulai dalam keadaan tidak dipilih.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Tambah folder…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Pilih folder kustom</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Ekstensi dan nama file buatan pengguna</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Ditambahkan ke pencarian pembersihan lanjutan. Kecocokan selalu dimulai dalam keadaan tidak dipilih.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Contoh: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Pola bawaan</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Pilihan bawaan per item</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Menggantikan pilihan bawaan yang direkomendasikan untuk suatu item dalam pembersihan standar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Setel ulang ke bawaan</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Ikuti rekomendasi</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Selalu pilih</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Jangan pernah pilih</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Hasil sejauh ini</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Belum ada yang dijalankan.</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Riwayat dialog Run</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Item terbaru</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Riwayat koneksi Remote Desktop</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Riwayat dialog Buka dan Simpan</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Riwayat pencarian File Explorer</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Riwayat Map network drive</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Jump List</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Riwayat Internet Explorer dan alamat yang diketik</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Riwayat program yang dijalankan (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Laporan Windows Error Reporting pengguna saat ini</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">File sementara pengguna</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">File sementara sistem</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Dump crash mode pengguna</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Dump memori sistem</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Laporan Windows Error Reporting</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Log orkestrator Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">Log pelacakan ETL</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Log diagnostik Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Cache gambar mini</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Cache ikon</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Cache fon Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Cache bitmap Remote Desktop</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">Cache shader DirectX</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Data Prefetch lama</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Recycle Bin</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">Cache resolver DNS</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Riwayat penggunaan jaringan</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Pintasan dan entri menu Start yang tidak valid</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Tugas terjadwal yang tidak valid</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Cache internet (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Cache add-in Office</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Cache URL sertifikat (CryptnetUrlCache)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">File Windows Installer yatim</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Menghapus file .msi dan .msp di folder Windows Installer yang tidak terdaftar pada produk atau patch mana pun dan berusia lebih dari 30 hari.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Jika data pendaftaran tidak dapat dibaca sepenuhnya, item ini tidak tersedia. Pendaftaran diperiksa ulang tepat sebelum penghapusan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Data pemutaran balik pembaruan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Menggunakan DISM /StartComponentCleanup /ResetBase untuk menghapus data yang diperlukan guna memutar balik pembaruan yang sudah terinstal.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Setelah ini dijalankan, pembaruan yang terinstal tidak dapat lagi dicopot. Tindakan ini tidak dapat dibatalkan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Cadangan pembaruan (component store)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Menggunakan DISM /StartComponentCleanup untuk membersihkan komponen yang sudah digantikan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">Ruang yang ditampilkan adalah perkiraan DISM dan dapat berbeda dari yang sebenarnya dibebaskan. Ini dapat memakan waktu beberapa menit.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Cache unduhan Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Menghapus isi SoftwareDistribution\Download. Layanan Windows Update dan BITS dihentikan selama proses dan dipulihkan setelahnya.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Sisa cache patch</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Menghentikan layanan Windows Installer dan menghapus isi Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Perbaikan atau pencopotan di kemudian hari mungkin meminta media instalasi asli.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Fitur input bahasa (Jepang)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Menggunakan DISM Remove-Capability untuk menghapus fitur Language.Basic bahasa Jepang (pemeriksa ejaan, prediksi teks, dan sebagainya). Ini bukan IME itu sendiri. Hanya dapat dijalankan jika bahasa tidak digunakan oleh bahasa tampilan, daftar bahasa, atau tata letak keyboard.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Untuk memakai fitur bahasa ini lagi, Anda perlu menambahkannya kembali.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Fitur input bahasa (Korea)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Menggunakan DISM Remove-Capability untuk menghapus fitur Language.Basic bahasa Korea (pemeriksa ejaan, prediksi teks, dan sebagainya). Ini bukan IME itu sendiri. Hanya dapat dijalankan jika bahasa tidak digunakan oleh bahasa tampilan, daftar bahasa, atau tata letak keyboard.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Untuk memakai fitur bahasa ini lagi, Anda perlu menambahkannya kembali.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Fitur input bahasa (Mandarin, Tradisional)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Menggunakan DISM Remove-Capability untuk menghapus fitur Language.Basic bahasa Mandarin Tradisional (pemeriksa ejaan, prediksi teks, dan sebagainya). Ini bukan IME itu sendiri. Hanya dapat dijalankan jika bahasa tidak digunakan oleh bahasa tampilan, daftar bahasa, atau tata letak keyboard.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Untuk memakai fitur bahasa ini lagi, Anda perlu menambahkannya kembali.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Fitur input bahasa (Mandarin, Sederhana)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Menggunakan DISM Remove-Capability untuk menghapus fitur Language.Basic bahasa Mandarin Sederhana (pemeriksa ejaan, prediksi teks, dan sebagainya). Ini bukan IME itu sendiri. Hanya dapat dijalankan jika bahasa tidak digunakan oleh bahasa tampilan, daftar bahasa, atau tata letak keyboard.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Untuk memakai fitur bahasa ini lagi, Anda perlu menambahkannya kembali.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">File Bantuan Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Menghapus file Bantuan Windows. Pada Windows 10/11 file ini dilindungi Windows Resource Protection, sehingga biasanya tidak ada yang dihapus.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">File yang dilindungi Windows atau dimiliki TrustedInstaller dibiarkan. Kepemilikan tidak pernah diambil alih.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Wallpaper bawaan</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Menghapus wallpaper bawaan Windows. Pada Windows 10/11 file ini dilindungi Windows Resource Protection, sehingga biasanya tidak ada yang dihapus.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">File yang dilindungi Windows atau dimiliki TrustedInstaller dibiarkan. Kepemilikan tidak pernah diambil alih.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Musik contoh</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Hanya menghapus lagu contoh yang dikenal dan disertakan dengan Windows 7. File lain di folder dibiarkan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Gambar contoh</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Hanya menghapus gambar contoh yang dikenal dan disertakan dengan Windows 7. File lain di folder dibiarkan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Video contoh</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Hanya menghapus video contoh yang dikenal dan disertakan dengan Windows 7. File lain di folder dibiarkan.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Luaskan atau ciutkan {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">Penghapusan tidak dapat diselesaikan. Periksa log.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">Pengaturan tidak dapat dibaca, sehingga penyimpanan dinonaktifkan untuk melindungi file asli. Perubahan hanya berlaku selama sesi ini.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">Pemulihan Sistem tidak dapat dibuka.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} ditambahkan ke pengecualian. Pengaturan berubah, jadi pindai ulang.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} sudah dikecualikan.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">{0} tidak dapat ditambahkan ke pengecualian (format tidak valid atau batas tercapai).</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">{0} ditambahkan ke pengecualian, tetapi tidak dapat disimpan. Hanya berlaku sampai aplikasi ditutup.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">Pilih drive atau folder kustom untuk dipindai.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">Tampilkan semua jenis</x:String>
