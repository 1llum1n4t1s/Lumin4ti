  <x:String x:Key="Text.Cleanup.Impact.Trace" xml:space="preserve">Jejak penggunaan</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout" xml:space="preserve">Mengeluarkan Anda dari akun</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild" xml:space="preserve">Perlu dibangun ulang</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles" xml:space="preserve">File Anda</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace.Warning" xml:space="preserve">Riwayat penggunaan Anda akan hilang.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout.Warning" xml:space="preserve">Menghapus cookie dapat mengeluarkan Anda dari situs web.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild.Warning" xml:space="preserve">Penggunaan pertama setelah penghapusan dapat lebih lambat selagi data dibangun ulang.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles.Warning" xml:space="preserve">Mencakup file Anda yang tidak dapat diunduh lagi. Pilih satu per satu; Anda akan diminta mengonfirmasi lagi sebelum penghapusan.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.NotRecommended" xml:space="preserve">Item ini tidak direkomendasikan secara bawaan. Periksa dulu apa yang dihapusnya sebelum memilihnya.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.JumpListPins" xml:space="preserve">Menghapus Jump List juga menghapus item yang Anda sematkan ke bilah tugas dan menu Start.</x:String>
  <x:String x:Key="Text.Cleanup.State.Found" xml:space="preserve">Dapat dihapus</x:String>
  <x:String x:Key="Text.Cleanup.State.Empty" xml:space="preserve">Tidak ada yang dihapus</x:String>
  <x:String x:Key="Text.Cleanup.State.Unmeasurable" xml:space="preserve">Jumlah tidak diketahui</x:String>
  <x:String x:Key="Text.Cleanup.State.Unavailable" xml:space="preserve">Tidak tersedia</x:String>
  <x:String x:Key="Text.Cleanup.State.NotDetected" xml:space="preserve">Tidak terdeteksi</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeDifferentUser" xml:space="preserve">Pengguna yang masuk dan pengguna dengan hak tinggi berbeda, sehingga item yang menyasar pengaturan dan data pengguna dinonaktifkan.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeUnknown" xml:space="preserve">Pengguna yang masuk tidak dapat diverifikasi, sehingga item yang menyasar pengaturan dan data pengguna dinonaktifkan.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.TargetRejected" xml:space="preserve">Target ditolak demi keamanan (lokasi terlindungi, kredensial, tautan, dan sebagainya).</x:String>
  <x:String x:Key="Text.Cleanup.Reason.ScanFailed" xml:space="preserve">Pemindaian gagal.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.HandlerUnavailable" xml:space="preserve">Ini tidak dapat dijalankan di lingkungan ini.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.CustomFolderRejected" xml:space="preserve">Lokasi ini tidak diizinkan sebagai folder kustom, sehingga dilewati.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Pembersihan standar</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Pindai dulu untuk melihat apa yang dapat dihapus, lalu hapus hanya item yang Anda pilih. Pemindaian tidak mengubah apa pun.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Belum ada yang dipindai. Tekan Pindai untuk menemukan apa yang dapat dihapus.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Memindai {0} dari {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Pemindaian selesai: {0} item, {1} file, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">Pemindaian dihentikan.</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">Pemindaian gagal. Periksa log.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">Hasil pemindaian sudah usang karena pengaturan berubah atau operasi lain berjalan. Pindai ulang.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Tidak ditemukan apa pun yang dapat dihapus.</x:String>
