  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Name" xml:space="preserve">Startup</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Description" xml:space="preserve">Pendaftaran yang berjalan saat Windows dimulai dan file eksekusinya tidak ada. Pengaturan aktif/nonaktif startup ikut dihapus bersamanya.</x:String>
