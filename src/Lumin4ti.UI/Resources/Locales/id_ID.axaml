  <x:String x:Key="Text.Cleanup.Kind.Backup" xml:space="preserve">Cadangan {0}</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Downloads" xml:space="preserve">File yang diunduh {0}</x:String>
