  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Exportari non potuit: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Quomodo fasciculi delentur</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Deletio tuta (semel superscribe, deinde dele)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Contenta fasciculi semel superscribit antequam eum delet. In SSD deletionem praestare non potest. Fasciculi cum nexibus duris et fasciculi compressi, rari vel cryptati sine superscriptione delentur.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Punctum restitutionis ante extenuationem crea</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Punctum restitutionis exstans ultimarum 24 horarum iterum adhibetur. Si tutela systematis inactiva est, post confirmationem eam activare potes.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Restitutionem systematis aperi</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Directoria propria</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Directoria quorum contenta purgatio provecta vacuare potest. Windows, Program Files, ProgramData, profila aliorum usorum, radices unitatum et loci cum credentialibus non permittuntur. Directoria addita semper non selecta incipiunt.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Directorium adde…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Directorium proprium elige</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Extensiones et nomina fasciculorum ab usore definita</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Ad quaesitionem purgationis provectae adduntur. Congruentiae semper non selectae incipiunt.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Exemplum: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Exemplaria inbuta</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Electio praefinita per elementum</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Electionem praefinitam commendatam elementi in purgatione vulgari supervenit.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Ad praefinita restitue</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Commendationem sequere</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Semper selige</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Numquam selige</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Eventus hactenus</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Nihil adhuc exsecutum est.</x:String>

