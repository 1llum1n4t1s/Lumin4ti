  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Name" xml:space="preserve">Registra televisifica exempli gratia</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Description" xml:space="preserve">Registrum exempli gratia notum tantum delet quod cum Windows 7 veniebat. Reliqui fasciculi in directorio intacti relinquuntur.</x:String>
