  <x:String x:Key="Text.Cleanup.Impact.Signout" xml:space="preserve">Te exire facit</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild" xml:space="preserve">Reaedificatio requiritur</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles" xml:space="preserve">Fasciculi tui</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace.Warning" xml:space="preserve">Historia usus tui amittetur.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout.Warning" xml:space="preserve">Crustula delere potest te ex locis interretialibus exire facere.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild.Warning" xml:space="preserve">Primus usus post deletionem tardior esse potest dum data reaedificantur.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles.Warning" xml:space="preserve">Fasciculos tuos continet qui iterum deponi non possunt. Eos singillatim selige; antequam delentur, iterum confirmare rogaberis.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.NotRecommended" xml:space="preserve">Hoc elementum ex defectu non commendatur. Quid removeat inspice antequam id seligis.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.JumpListPins" xml:space="preserve">Deletio Jump Lists etiam elementa quae in tabula operum et in menu Initii affixisti removet.</x:String>

  <!-- 通常: 状態・理由 -->
  <x:String x:Key="Text.Cleanup.State.Found" xml:space="preserve">Deleri potest</x:String>
  <x:String x:Key="Text.Cleanup.State.Empty" xml:space="preserve">Nihil delendum</x:String>
  <x:String x:Key="Text.Cleanup.State.Unmeasurable" xml:space="preserve">Numerus ignotus</x:String>
  <x:String x:Key="Text.Cleanup.State.Unavailable" xml:space="preserve">Non praesto</x:String>
  <x:String x:Key="Text.Cleanup.State.NotDetected" xml:space="preserve">Non repertum</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeDifferentUser" xml:space="preserve">Usor introitus et usor privilegiis auctus diversi sunt, itaque elementa quae optiones et data usoris tangunt inhabilia fiunt.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeUnknown" xml:space="preserve">Usor introitus verificari non potuit, itaque elementa quae optiones et data usoris tangunt inhabilia fiunt.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.TargetRejected" xml:space="preserve">Finis ob securitatem repudiatus est (locus protectus, credentialia, nexus et cetera).</x:String>
  <x:String x:Key="Text.Cleanup.Reason.ScanFailed" xml:space="preserve">Perscrutatio defecit.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.HandlerUnavailable" xml:space="preserve">Hoc in hoc ambitu exsequi non potest.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.CustomFolderRejected" xml:space="preserve">Hic locus ut directorium proprium non permittitur, itaque praetermittitur.</x:String>

  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Purgatio vulgaris</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Primum perscrutare ut videas quid removeri possit, deinde ea tantum elementa dele quae selegeris. Perscrutatio nihil mutat.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Nihil adhuc perscrutatum est. Preme Perscrutare ut quae deleri possint inveniantur.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Perscrutatur {0} ex {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Perscrutatio absoluta: {0} elementa, {1} fasciculi, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">Perscrutatio sistita est.</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">Perscrutatio defecit. Acta inspice.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">Eventus perscrutationis obsoletus est quia optiones mutatae sunt vel alia operatio exsecuta est. Iterum perscrutare.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Nihil quod deleri possit inventum est.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{0} ex {1} elementis selecta (circa {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">{0} elementa ob exclusiones tuas servantur.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unreadable" xml:space="preserve">{0} elementa inspici non potuerunt.</x:String>
  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} elementa nexus sunt et intacta relinquuntur.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">Hoc exsequi potest, sed numerus et magnitudo antea metiri non possunt.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">Exemplum: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">Exsequitur: {0} (rogaberis num ante deletionem claudatur)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">Servitia inter deletionem ad tempus sistita: {0}</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Deletionem confirma</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Dele</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Redi</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">Elementa selecta {0} ({1} fasciculi, circa {2}) in perpetuum delebuntur. In Corbem reciclabilem non moventur nec restitui possunt.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">{0} elementa non commendata continet. Ea prius inspice.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">{0} elementa continet quae te exire facere possunt (sicut crustula).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} elementa fasciculos tuos continent qui iterum deponi non possunt. Iterum confirmare rogaberis.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">Intellego fasciculos meos in perpetuum deletum iri</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">Deletio tuta activa est. Fasciculi semel superscribuntur antequam delentur (in SSD id praestari non potest).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Quaedam producta exsequuntur. Rogaberis num ea inter deletionem claudantur.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">"{0}" exsequitur ({1}). Claudendum est antequam data eius delentur.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Claude</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Hoc elementum praetermitte</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Siste</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">"{0}" more solito claudi non potuit ({1}). Vi claudere omnia non servata amittit.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Vi claude</x:String>
