  <x:String x:Key="Text.Cleanup.Msg.IniContentUnverified" xml:space="preserve"> (contenta fasciculi verificari non potuerunt)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ExpansionTruncated" xml:space="preserve">Fines expansi terminum attigerunt ({0}); reliqui non includuntur</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbOpenFailed" xml:space="preserve">Basis datorum aperiri non potuit (SQLite {0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbConfigFailed" xml:space="preserve">Sistitum quia optio securitatis applicari non potuit ({0})</x:String>
