  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Lumin4ti.UI/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- ===== Tabs ===== -->
  <x:String x:Key="Text.Tab.Update" xml:space="preserve">Renovatio &amp; Securitas</x:String>
  <x:String x:Key="Text.Tab.Cleanup" xml:space="preserve">Purgatio</x:String>
