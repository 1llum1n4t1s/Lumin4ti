  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Fasciculi orbati Windows Installer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Fasciculos .msi et .msp in directorio Windows Installer delet qui nulli producto vel emendationi registrati sunt et triginta dies vetustiores sunt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Si data registrationis perfecte legi non possunt, hoc elementum non praesto est. Registrationes iterum inspiciuntur paulo ante deletionem.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Data reversionis renovationum</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">DISM /StartComponentCleanup /ResetBase adhibet ad data removenda quae ad renovationes iam institutas reversandas necessaria sunt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Postquam exsecutum est, renovationes institutae iam non exstirpari possunt. Hoc infectum fieri non potest.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Exemplaria tuta renovationum (copia partium)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">DISM /StartComponentCleanup adhibet ad partes superatas purgandas.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">Spatium monstratum aestimatio DISM est et ab eo quod re vera liberatur differre potest. Aliquot minuta durare potest.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Cella depositionum Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Contenta SoftwareDistribution\Download delet. Servitia Windows Update et BITS inter exsecutionem sistuntur et postea restituuntur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Cella emendationum reliqua</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Servitium Windows Installer sistit et contenta Installer\$PatchCache$ delet.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Reparationes vel exstirpationes posteriores media institutionis originalia poscere possunt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Facultates introitus linguae (Iaponica)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">DISM Remove-Capability adhibet ad facultates Language.Basic linguae Iaponicae removendas (correctio orthographiae, praedictio textus et cetera). Ipse IME non est. Exsequi potest tantum cum lingua a lingua monstrandi, ab indice linguarum vel a dispositione clavium non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Ut his facultatibus linguae iterum utaris, eas iterum addere debes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Facultates introitus linguae (Coreana)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">DISM Remove-Capability adhibet ad facultates Language.Basic linguae Coreanae removendas (correctio orthographiae, praedictio textus et cetera). Ipse IME non est. Exsequi potest tantum cum lingua a lingua monstrandi, ab indice linguarum vel a dispositione clavium non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Ut his facultatibus linguae iterum utaris, eas iterum addere debes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Facultates introitus linguae (Sinica traditionalis)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">DISM Remove-Capability adhibet ad facultates Language.Basic linguae Sinicae traditionalis removendas (correctio orthographiae, praedictio textus et cetera). Ipse IME non est. Exsequi potest tantum cum lingua a lingua monstrandi, ab indice linguarum vel a dispositione clavium non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Ut his facultatibus linguae iterum utaris, eas iterum addere debes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Facultates introitus linguae (Sinica simplificata)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">DISM Remove-Capability adhibet ad facultates Language.Basic linguae Sinicae simplificatae removendas (correctio orthographiae, praedictio textus et cetera). Ipse IME non est. Exsequi potest tantum cum lingua a lingua monstrandi, ab indice linguarum vel a dispositione clavium non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Ut his facultatibus linguae iterum utaris, eas iterum addere debes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Fasciculi auxilii Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Fasciculos auxilii Windows delet. In Windows 10/11 a Windows Resource Protection protecti sunt, itaque plerumque nihil delendum est.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Fasciculi a Windows protecti vel TrustedInstaller proprii intacti relinquuntur. Dominium numquam sumitur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Imagines scaenae praefinitae</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Imagines scaenae praefinitas Windows delet. In Windows 10/11 a Windows Resource Protection protectae sunt, itaque plerumque nihil delendum est.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Fasciculi a Windows protecti vel TrustedInstaller proprii intacti relinquuntur. Dominium numquam sumitur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Musica exempli gratia</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Cantus exempli gratia notos tantum delet qui cum Windows 7 veniebant. Reliqui fasciculi in directorio intacti relinquuntur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Imagines exempli gratia</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Imagines exempli gratia notas tantum delet quae cum Windows 7 veniebant. Reliqui fasciculi in directorio intacti relinquuntur.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Pelliculae exempli gratia</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Pelliculam exempli gratia notam tantum delet quae cum Windows 7 veniebat. Reliqui fasciculi in directorio intacti relinquuntur.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Expande vel contrahe {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">Deletio perfici non potuit. Acta inspice.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">Optiones legi non potuerunt, itaque servatio inhabilis est ad fasciculum originalem tuendum. Mutationes in hac sessione tantum valent.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">Restitutio systematis aperiri non potuit.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} ad exclusiones additum est. Optiones mutatae sunt; iterum perscrutare.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} iam exclusum est.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">{0} ad exclusiones addi non potuit (forma invalida vel terminus attactus).</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">{0} ad exclusiones additum est, sed servari non potuit. Valet tantum donec applicationem claudas.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">Unitatem vel directorium proprium ad perscrutandum selige.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">Omnia genera monstra</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Action.IgnoreFolder" xml:space="preserve">Hoc directorium praetermitte</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Kinds" xml:space="preserve">Eventus per genus</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Failed" xml:space="preserve">Error in deletione accidit. Acta inspice.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserScopeUnavailable" xml:space="preserve">Regulae ad usorem pertinentes adhiberi non possunt (usor interactivus et usor privilegiis auctus diversi sunt vel confirmari non potuerunt)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejectedAtRun" xml:space="preserve">Directorium proprium a probatione tempore exsecutionis repudiatum est</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseOutsideProfile" xml:space="preserve">Variabilis ambitus %{0}% extra profilum usoris praesentis monstrat (aut profilum verificari non potuit); hoc obiectum non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseProtectedLocation" xml:space="preserve">Variabilis ambitus %{0}% ad locum tutum monstrat (radicem exagoni, Windows, Program Files, ProgramData, aut profilum alterius usoris); hoc obiectum non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseMachineMismatch" xml:space="preserve">Variabilis ambitus %{0}% a loco systematis praestituto differt; hoc obiectum non adhibetur.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejected" xml:space="preserve">Directorium proprium repudiatum est ({0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceStopFailed" xml:space="preserve">Nihil deletum est quia servitium sisti non potuit: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DeleteFailed" xml:space="preserve">Deletio perfici non potuit: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceResumeFailedList" xml:space="preserve">Servitium ad statum originalem reduci non potuit ({0}): {1}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceResumeFailed" xml:space="preserve">Servitium ad statum originalem reduci non potuit: {0}</x:String>
