  <x:String x:Key="Text.Cleanup.Msg.DbPinFailed" xml:space="preserve">Basis datorum tuto figi non potuit: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbHardLinked" xml:space="preserve">Basis datorum cum nexu duro finis non est</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbTooLarge" xml:space="preserve">Basis datorum nimis magna est ut finis sit</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbIdentityUnverified" xml:space="preserve">Fasciculus basis datorum verificari non potuit</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbJournalPending" xml:space="preserve">Praetermissum quia diarium non tractatum exstat (in usu vel non recuperatum)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbIntegrityFailed" xml:space="preserve">Probatio integritatis basis datorum defecit</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbVirtualTable" xml:space="preserve">Basis datorum quae tabulam virtualem continet finis non est</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbUnknownTable" xml:space="preserve">Tabula exspectata {0} non exstat (schema ignotum)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DbUnknownColumn" xml:space="preserve">Tabula {0} columnam exspectatam {1} non habet (schema ignotum)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniUnconvertible" xml:space="preserve">Praetermissum quia fasciculus sine damno ut UTF-8, UTF-16 vel pagina codicis ANSI systematis converti non potest</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniTooLarge" xml:space="preserve">Praetermissum quia fasciculus maior est quam 1 MB</x:String>
  <x:String x:Key="Text.Cleanup.Msg.IniAmbiguousSection" xml:space="preserve">Non mutatum quia plures sectiones idem nomen habent et finis dignosci non potest</x:String>
