  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Description" xml:space="preserve">Associationes ut "Aperire cum" quarum applicatio iam non exstat. Optiones applicationis praefinitae non mutantur.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Name" xml:space="preserve">Informationes deinstallationis</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Description" xml:space="preserve">Ingressus deinstallationis quorum deinstallator et locus installationis ambo non exstant. Praefinite inactivum est.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Name" xml:space="preserve">DLL communes</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Description" xml:space="preserve">Numeri referentiarum DLL communium quarum DLL non exstat. Praefinite inactivum est.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Title" xml:space="preserve">Registrum</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ExcludedFromSelectAll" xml:space="preserve">In "Omnia selige" non includitur. Elementa necessaria tantum singillatim selige.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.RequiresApproval" xml:space="preserve">Ad delendum, quodque elementum approbationem tuam in tabula confirmationis requirit.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.NoCandidates" xml:space="preserve">Nulla candidata.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ValueName" xml:space="preserve">Nomen valoris:</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Approval.Title" xml:space="preserve">Haec elementa singillatim approbari debent. Inspice ea et signa quae deleri possunt.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Title" xml:space="preserve">Exemplaria tuta et restitutio</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Refresh" xml:space="preserve">Indicem renova</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Empty" xml:space="preserve">Nulla exemplaria tuta sunt.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Restore" xml:space="preserve">Restitue</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Delete" xml:space="preserve">Exemplar tutum dele</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title" xml:space="preserve">Hocne exemplar tutum delere?</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteRun" xml:space="preserve">Dele</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Confirm.Title" xml:space="preserve">Deletionem registri confirma</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.CancelRun" xml:space="preserve">Deletionem siste</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Cancel" xml:space="preserve">Cancella</x:String>
