  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Dominia crustulorum</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Exemplum: example.com (cum subdominiis)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Additum.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Iam in indice est.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">Forma non valet.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">Terminus {0} ingressuum attactus est.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">Fasciculus nimis magnus est.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">Fasciculus legi non potuit.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">Forma fasciculi non valet.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Haec versio illam formam legere non potest.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Nimii ingressus sunt, itaque nihil importatum est.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} addita (duplicata: {1}, repudiata: {2}).</x:String>
