  <x:String x:Key="Text.Cleanup.Registry.Ui.Restore.Failed" xml:space="preserve">Falló la restauración.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Name" xml:space="preserve">Registros de aplicaciones (App Paths)</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Description" xml:space="preserve">Registros de inicio de aplicaciones cuyo ejecutable de destino no existe.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Name" xml:space="preserve">Inicio</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Description" xml:space="preserve">Registros que se ejecutan al iniciar Windows y cuyo ejecutable no existe. El ajuste de activado/desactivado del inicio se elimina junto con ellos.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Name" xml:space="preserve">Fuentes</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Description" xml:space="preserve">Registros de fuentes cuyo archivo de fuente no existe.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Name" xml:space="preserve">Asociaciones de archivos</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Description" xml:space="preserve">Asociaciones como «Abrir con» cuya aplicación ya no existe. La configuración de aplicaciones predeterminadas no se modifica.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Name" xml:space="preserve">Información de desinstalación</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Description" xml:space="preserve">Entradas de desinstalación cuyo desinstalador y ubicación de instalación no existen. Desactivado de forma predeterminada, y cada elemento requiere tu aprobación.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Name" xml:space="preserve">DLL compartidas</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Description" xml:space="preserve">Contadores de referencias de DLL compartidas cuya DLL no existe. Desactivado de forma predeterminada y no incluido en «Seleccionar todo».</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Title" xml:space="preserve">Registro</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ExcludedFromSelectAll" xml:space="preserve">No incluido en «Seleccionar todo». Selecciona uno por uno solo los elementos que necesites.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.RequiresApproval" xml:space="preserve">Para eliminar, cada elemento requiere tu aprobación en la pantalla de confirmación.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.NoCandidates" xml:space="preserve">No hay candidatos.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ValueName" xml:space="preserve">Nombre del valor:</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Approval.Title" xml:space="preserve">Los siguientes elementos requieren aprobación individual. Revísalos y marca los que se puedan eliminar.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Title" xml:space="preserve">Copias de seguridad y restauración</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Refresh" xml:space="preserve">Actualizar lista</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Empty" xml:space="preserve">No hay copias de seguridad.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Restore" xml:space="preserve">Restaurar</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.Delete" xml:space="preserve">Eliminar copia de seguridad</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteConfirm.Title" xml:space="preserve">¿Eliminar esta copia de seguridad?</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Backups.DeleteRun" xml:space="preserve">Eliminar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Name" xml:space="preserve">Grabaciones de TV de ejemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleRecordedTv.Description" xml:space="preserve">Elimina solo la grabación de ejemplo conocida que incluía Windows 7. Los demás archivos de la carpeta no se tocan.</x:String>
