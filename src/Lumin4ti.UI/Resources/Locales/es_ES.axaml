  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteConfirm" xml:space="preserve">Se eliminará la copia de seguridad del {0}. Una vez eliminada, no se podrá restaurar nada desde ella.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.Deleting" xml:space="preserve">Eliminando la copia de seguridad…</x:String>
