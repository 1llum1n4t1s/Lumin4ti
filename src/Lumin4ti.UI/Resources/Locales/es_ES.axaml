  <x:String x:Key="Text.Cleanup.Export.Failed" xml:space="preserve">No se pudo exportar: {0}</x:String>
  <x:String x:Key="Text.Cleanup.OpenLocation.Failed" xml:space="preserve">No se pudo abrir la ubicación: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Name" xml:space="preserve">Nombre</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Category" xml:space="preserve">Categoría</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.State" xml:space="preserve">Estado</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Files" xml:space="preserve">Archivos</x:String>
