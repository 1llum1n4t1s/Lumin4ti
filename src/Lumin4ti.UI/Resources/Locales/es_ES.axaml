  <x:String x:Key="Text.Cleanup.Export.Header.Bytes" xml:space="preserve">Bytes</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Retained" xml:space="preserve">Conservados</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Status" xml:space="preserve">Estado</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Details" xml:space="preserve">Detalles</x:String>
  <x:String x:Key="Text.Cleanup.Export.Header.Total" xml:space="preserve">Total</x:String>

  <!-- 高度: 画面 -->
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">Limpieza avanzada</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">Busca por patrones, en las unidades seleccionadas, archivos que normalmente se pueden quitar sin riesgo. El análisis no cambia nada. Revisa los resultados y elimina solo lo que selecciones.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">Unidades que analizar</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">Extraíble</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">Fija</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">Incluir archivos de cero bytes</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">Incluir accesos directos cuyo destino no existe</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">Incluir archivos más antiguos que el número de días indicado</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">Días</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">Seleccionar solo elementos seguros</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">Predeterminados</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">Adicionales</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">Definidos por el usuario</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">Seguro</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">No se puede determinar</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">Definido por el usuario</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">Un archivo .chk fuera de una carpeta FOUND. Podría ser un punto de control de ESE, por lo que permanece sin seleccionar hasta que lo compruebes.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">Modificado en las últimas 24 horas, por lo que no se selecciona de forma predeterminada.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">Archivo de cero bytes, por lo que no se selecciona de forma predeterminada.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">Coincide solo por su antigüedad, por lo que no se selecciona de forma predeterminada.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">Coincide con un patrón que definiste, por lo que no se selecciona de forma predeterminada.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">Patrón de nombre</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">Cero bytes</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">Acceso directo no válido</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">Archivo antiguo</x:String>

  <!-- 高度: 走査・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">Se comprobaron {0} carpetas y {1} archivos; {2} coincidencias ({3}): {4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">Análisis completado: {0} coincidencias ({1}) entre {2} archivos comprobados.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">Hay demasiadas coincidencias, así que solo se muestran las primeras {0}. Las otras {1} ({2}) no se muestran ni se eliminan.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">No se pudo analizar: {0} ({1})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">No se comprobaron {0} carpetas porque están protegidas o excluidas.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">Ningún archivo coincide.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">{0} de {1} archivos seleccionados ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">Carpetas personalizadas</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">Solo se vacía el contenido de la carpeta. La carpeta en sí se conserva.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">No encontrada</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} archivos, {1}</x:String>

  <!-- 高度: 確認・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">Los {0} archivos seleccionados ({1}) y el contenido de {2} carpetas personalizadas se eliminarán de forma permanente. No se mueven a la Papelera de reciclaje y no se pueden restaurar.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">Incluye {0} archivos marcados como «no se puede determinar». Deselecciona los que no hayas comprobado.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">Incluye {0} archivos modificados en las últimas 24 horas.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Done" xml:space="preserve">Se eliminaron {0} archivos y {1} carpetas, y se liberaron {2}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Partial" xml:space="preserve">Completado en parte: se eliminaron {0} archivos y {1} carpetas, y se liberaron {2}. Algunos elementos se conservaron o no se pudieron eliminar.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Expired" xml:space="preserve">No se eliminó nada porque el resultado del análisis estaba desactualizado. Analiza de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Cancelled" xml:space="preserve">Detenido. Ya se habían eliminado {0} archivos ({1}).</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Blocked" xml:space="preserve">No se pudieron eliminar {0} archivos (en uso, sin permiso, etc.).</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Retained" xml:space="preserve">{0} archivos se conservaron por exclusiones o por cambios posteriores al análisis.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Gone" xml:space="preserve">{0} archivos ya no existían.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} archivos están dentro de una carpeta personalizada seleccionada y no se trataron por separado.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">Una comprobación de seguridad rechazó {0} elementos.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">Esta ruta no se puede usar como carpeta.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">No se puede usar la raíz de una unidad.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">No se puede usar la carpeta de Windows ni sus carpetas superiores o inferiores.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">No se puede usar Program Files ni sus carpetas superiores o inferiores.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">No se puede usar ProgramData ni sus carpetas superiores o inferiores.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">No se puede usar el perfil de otro usuario.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">No se pueden usar tu carpeta de perfil ni AppData porque vaciarlas haría perder todos tus datos.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">No se pueden usar ubicaciones que contengan credenciales o claves.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Added" xml:space="preserve">Se agregó la carpeta personalizada.</x:String>

  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Aligerar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Libera espacio en disco quitando datos que Windows no necesita. Algunos elementos no se pueden deshacer o pueden afectar a reparaciones posteriores, por lo que no hay nada seleccionado de forma predeterminada.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Ejecutar selección</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Crear un punto de restauración antes de ejecutar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Elemento</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">Estado</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Espacio estimado</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">Unos {0} (estimación)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Desconocido</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Aún no se ha analizado nada. Pulsa Analizar para comprobar cuánto espacio puede liberar cada elemento.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Comprobando los elementos para aligerar…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Análisis completado. Se pueden ejecutar {0} elementos.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">Error al analizar. Revisa el registro.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">No se ejecutó nada porque el resultado del análisis estaba desactualizado. Analiza de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Los elementos que usan DISM pueden tardar varios minutos o más.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Listo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Nada que limpiar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">No disponible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Aviso</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Precaución</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">No se puede deshacer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">No se pudieron leer por completo los datos de registro, por lo que no se puede evaluar con seguridad.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows protege estos archivos, así que no hay nada que quitar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">Lo usan el idioma de visualización, la lista de idiomas o una distribución de teclado, por lo que no se puede quitar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">Los datos de algunos usuarios no están cargados, por lo que no se puede verificar el uso.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">El destino no está instalado o no se encontró.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">No se pudo leer o interpretar el resultado de DISM.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">Una comprobación de seguridad rechazó el destino.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Correcto</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Completado en parte</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">Error</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">Omitido</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">Detenido</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Confirmar aligerar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">Se ejecutarán los {0} elementos seleccionados (espacio estimado: {1}).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Se crea un punto de restauración antes de ejecutar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">No se crea ningún punto de restauración.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Confirmar una acción que no se puede deshacer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Una vez eliminados los datos de reversión de actualizaciones, ya no se podrán desinstalar las actualizaciones instaladas. Esto no se puede deshacer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Entiendo que ya no se podrán desinstalar las actualizaciones instaladas</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">Se creó un punto de restauración.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Se usa el punto de restauración existente creado {0} (no se crea uno nuevo en 24 horas).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">No hay ningún punto de restauración disponible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">No se pudo crear un punto de restauración: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">La protección del sistema está desactivada, por lo que no se puede crear un punto de restauración.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Continuar sin él</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Detener</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Activar la protección del sistema y reintentar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Ejecutando {0} de {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Hecho. Espacio liberado: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Algunos elementos no terminaron. Revisa el resultado de cada uno.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">Se requiere reiniciar para que los cambios surtan efecto.</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Configuración de limpieza</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Configuración guardada.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">No se pudo guardar la configuración. Revisa el registro.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Exclusiones</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Los elementos excluidos no se tocan: ni se analizan ni se eliminan.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Agregar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Quitar de la lista</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Importar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Exportar</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Importar exclusiones</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Exportar exclusiones</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">Archivos</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Ejemplo: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Carpetas</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Ejemplo: C:\Users\me\Projects (y sus subcarpetas)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Extensiones y nombres de archivo</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Ejemplo: *.log o cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Dominios de cookies</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Ejemplo: example.com (y sus subdominios)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Agregado.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Ya está en la lista.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">El formato no es válido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">Se alcanzó el límite de {0} entradas.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">El archivo es demasiado grande.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">No se pudo leer el archivo.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">El formato del archivo no es válido.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Esta versión no puede leer ese formato.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Hay demasiadas entradas, por lo que no se importó nada.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">Se agregaron {0} (duplicados: {1}, rechazados: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Exportado a {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">No se pudo exportar: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Cómo se eliminan los archivos</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Eliminación segura (sobrescribir una vez y luego eliminar)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Sobrescribe una vez el contenido de un archivo antes de eliminarlo. No puede garantizar el borrado en unidades SSD. Los archivos con vínculos físicos y los archivos comprimidos, dispersos o cifrados se eliminan sin sobrescribir.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Crear un punto de restauración antes de aligerar</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Se reutiliza un punto de restauración existente de las últimas 24 horas. Si la protección del sistema está desactivada, puedes activarla tras confirmar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Abrir Restaurar sistema</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Carpetas personalizadas</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Carpetas cuyo contenido puede vaciar la limpieza avanzada. No se permiten Windows, Program Files, ProgramData, los perfiles de otros usuarios, las raíces de unidad ni las ubicaciones con credenciales. Las carpetas agregadas siempre empiezan sin seleccionar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Agregar una carpeta…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Elegir una carpeta personalizada</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Extensiones y nombres de archivo definidos por el usuario</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Se agregan a la búsqueda de la limpieza avanzada. Las coincidencias siempre empiezan sin seleccionar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Ejemplo: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Patrones integrados</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Selección predeterminada por elemento</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Reemplaza la selección predeterminada recomendada de un elemento en la limpieza estándar.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Restablecer valores predeterminados</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Seguir la recomendación</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Seleccionar siempre</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">No seleccionar nunca</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Resultados hasta ahora</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Aún no se ha ejecutado nada.</x:String>

  <!-- Windows 項目の名称 (Definitions の nameKey) -->
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Historial del cuadro Ejecutar</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Elementos recientes</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Historial de conexiones de Escritorio remoto</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Historial de los cuadros Abrir y Guardar</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Historial de búsqueda del Explorador de archivos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Historial de Conectar a unidad de red</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Listas de salto</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Historial de Internet Explorer y direcciones escritas</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Historial de programas iniciados (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Informes de errores de Windows del usuario actual</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">Archivos temporales del usuario</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">Archivos temporales del sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Volcados de bloqueo en modo usuario</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Volcados de memoria del sistema</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Informes del Informe de errores de Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Registros del orquestador de Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">Registros de seguimiento ETL</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Registros de diagnóstico de Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Caché de miniaturas</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Caché de iconos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Caché de fuentes de Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Caché de mapas de bits de Escritorio remoto</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">Caché de sombreadores de DirectX</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Datos antiguos de Prefetch</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Papelera de reciclaje</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">Caché del solucionador DNS</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Historial de uso de red</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Accesos directos y entradas del menú Inicio no válidos</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Tareas programadas no válidas</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Caché de Internet (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Caché de complementos de Office</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Caché de direcciones URL de certificados (CryptnetUrlCache)</x:String>

  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Archivos huérfanos de Windows Installer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Elimina los archivos .msi y .msp de la carpeta de Windows Installer que no están registrados en ningún producto ni revisión y tienen más de 30 días.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Si los datos de registro no se pueden leer por completo, este elemento no está disponible. Los registros se comprueban de nuevo justo antes de eliminar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Datos de reversión de actualizaciones</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Usa DISM /StartComponentCleanup /ResetBase para quitar los datos necesarios para revertir las actualizaciones ya instaladas.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Tras ejecutarlo, ya no se podrán desinstalar las actualizaciones instaladas. Esto no se puede deshacer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Copias de seguridad de actualizaciones (almacén de componentes)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Usa DISM /StartComponentCleanup para limpiar los componentes reemplazados.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">El espacio mostrado es una estimación de DISM y puede diferir de lo que realmente se libera. Puede tardar varios minutos.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Caché de descargas de Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Elimina el contenido de SoftwareDistribution\Download. Los servicios Windows Update y BITS se detienen durante la ejecución y se restauran después.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Caché de revisiones sobrante</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Detiene el servicio Windows Installer y elimina el contenido de Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Las reparaciones o desinstalaciones posteriores pueden pedir los medios de instalación originales.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Funciones de entrada de idioma (japonés)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Usa DISM Remove-Capability para quitar las funciones Language.Basic del japonés (corrector ortográfico, predicción de texto, etc.). No es el IME en sí. Solo se puede ejecutar si el idioma no lo usan el idioma de visualización, la lista de idiomas ni una distribución de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Para volver a usar estas funciones de idioma, deberás agregarlas de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Funciones de entrada de idioma (coreano)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Usa DISM Remove-Capability para quitar las funciones Language.Basic del coreano (corrector ortográfico, predicción de texto, etc.). No es el IME en sí. Solo se puede ejecutar si el idioma no lo usan el idioma de visualización, la lista de idiomas ni una distribución de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Para volver a usar estas funciones de idioma, deberás agregarlas de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Funciones de entrada de idioma (chino tradicional)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Usa DISM Remove-Capability para quitar las funciones Language.Basic del chino tradicional (corrector ortográfico, predicción de texto, etc.). No es el IME en sí. Solo se puede ejecutar si el idioma no lo usan el idioma de visualización, la lista de idiomas ni una distribución de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Para volver a usar estas funciones de idioma, deberás agregarlas de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Funciones de entrada de idioma (chino simplificado)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Usa DISM Remove-Capability para quitar las funciones Language.Basic del chino simplificado (corrector ortográfico, predicción de texto, etc.). No es el IME en sí. Solo se puede ejecutar si el idioma no lo usan el idioma de visualización, la lista de idiomas ni una distribución de teclado.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Para volver a usar estas funciones de idioma, deberás agregarlas de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Archivos de ayuda de Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Elimina los archivos de ayuda de Windows. En Windows 10/11 están protegidos por la Protección de recursos de Windows, así que normalmente no hay nada que eliminar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Los archivos protegidos por Windows o que pertenecen a TrustedInstaller no se tocan. Nunca se toma la propiedad.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Fondos de pantalla predeterminados</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Elimina los fondos de pantalla predeterminados de Windows. En Windows 10/11 están protegidos por la Protección de recursos de Windows, así que normalmente no hay nada que eliminar.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Los archivos protegidos por Windows o que pertenecen a TrustedInstaller no se tocan. Nunca se toma la propiedad.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Música de ejemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Elimina solo las canciones de ejemplo conocidas que incluía Windows 7. Los demás archivos de la carpeta no se tocan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Imágenes de ejemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Elimina solo las imágenes de ejemplo conocidas que incluía Windows 7. Los demás archivos de la carpeta no se tocan.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Vídeos de ejemplo</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Elimina solo el vídeo de ejemplo conocido que incluía Windows 7. Los demás archivos de la carpeta no se tocan.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Expandir o contraer {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">No se pudo completar la eliminación. Revisa el registro.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">No se pudo leer la configuración, por lo que se desactiva el guardado para proteger el archivo original. Los cambios solo se aplican durante esta sesión.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">No se pudo abrir Restaurar sistema.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">Se agregó {0} a las exclusiones. La configuración cambió; analiza de nuevo.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} ya está excluido.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Failed" xml:space="preserve">No se pudo agregar {0} a las exclusiones (formato no válido o límite alcanzado).</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.SaveFailed" xml:space="preserve">Se agregó {0} a las exclusiones, pero no se pudo guardar. Solo se aplica hasta que cierres la aplicación.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.NoTarget" xml:space="preserve">Selecciona una unidad o una carpeta personalizada para analizar.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Filter.All" xml:space="preserve">Mostrar todos los tipos</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Action.IgnoreFolder" xml:space="preserve">Ignorar esta carpeta</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Kinds" xml:space="preserve">Resultados por tipo</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Failed" xml:space="preserve">Se produjo un error al eliminar. Revisa el registro.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.UserScopeUnavailable" xml:space="preserve">No se pueden usar reglas de ámbito de usuario (el usuario interactivo y el usuario con privilegios elevados son distintos, o no se pudo confirmar)</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejectedAtRun" xml:space="preserve">La comprobación en tiempo de ejecución rechazó la carpeta personalizada</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseOutsideProfile" xml:space="preserve">La variable de entorno %{0}% apunta fuera del perfil del usuario actual (o no se pudo comprobar el perfil); este destino no se usa.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseProtectedLocation" xml:space="preserve">La variable de entorno %{0}% apunta a una ubicación protegida (raíz de unidad, Windows, Program Files, ProgramData o el perfil de otro usuario); este destino no se usa.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.BaseMachineMismatch" xml:space="preserve">La variable de entorno %{0}% difiere de la ubicación predeterminada del sistema; este destino no se usa.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.CustomFolderRejected" xml:space="preserve">Se rechazó la carpeta personalizada ({0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.ServiceStopFailed" xml:space="preserve">No se eliminó nada porque no se pudo detener un servicio: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.DeleteFailed" xml:space="preserve">No se pudo completar la eliminación: {0}</x:String>
