  <x:String x:Key="Text.Cleanup.Msg.RegistryScanEmptyValue" xml:space="preserve">Kann nicht beurteilt werden, weil der Wert leer ist.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryScanNoRegistration" xml:space="preserve">Kann nicht beurteilt werden, weil keine App-Registrierung gefunden wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryScanMsiIndeterminate" xml:space="preserve">Beibehalten, weil der Registrierungsstatus von Windows Installer nicht ermittelt werden konnte.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryScanProgIdUnverifiable" xml:space="preserve">Beibehalten, weil die Registrierung der zugeordneten App (ProgID) nicht überprüft werden konnte.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryScanSubtreeTooLarge" xml:space="preserve">Beibehalten, weil der Inhalt des Schlüssels zu groß oder zu tief verschachtelt ist.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryScanUserScopeUnavailable" xml:space="preserve">Die Registrierung des Benutzers kann nicht geprüft werden ({0})</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanStale" xml:space="preserve">Es wurde nichts ausgeführt, weil das Prüfergebnis veraltet war. Prüfen Sie erneut.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanNothingSelected" xml:space="preserve">Es ist kein ausführbarer Eintrag ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanRestorePointUnavailable" xml:space="preserve">Es wurde nichts ausgeführt, weil kein Wiederherstellungspunkt verfügbar ist: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanCanceledNotRun" xml:space="preserve">Nicht ausgeführt, weil der Vorgang abgebrochen wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanNotInScan" xml:space="preserve">Nicht ausgeführt, weil der Eintrag nicht im Prüfergebnis enthalten ist.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanPathNotAllowed" xml:space="preserve">Nicht ausgeführt, weil das Löschen an diesem Speicherort nicht zulässig ist.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanGone" xml:space="preserve">Beibehalten, weil er seit der Prüfung nicht mehr existiert.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanChanged" xml:space="preserve">Beibehalten, weil er sich nach der Prüfung geändert hat.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanAccessDenied" xml:space="preserve">Nicht gelöscht, weil der Zugriff verweigert wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanTrustedInstaller" xml:space="preserve">Nicht geändert, weil er TrustedInstaller gehört.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanItemFailed" xml:space="preserve">Konnte nicht gelöscht werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanBackupItemFailed" xml:space="preserve">Nicht gelöscht, weil die Sicherung nicht gespeichert werden konnte: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanBackupFailed" xml:space="preserve">Es wurde nichts gelöscht, weil die Sicherung nicht gespeichert werden konnte: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanCoveredByOther" xml:space="preserve">Zusammen mit einem übergeordneten Eintrag gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanCompanionFailed" xml:space="preserve">Ein zugehöriger Eintrag konnte nicht gelöscht werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryCleanResultNotWritten" xml:space="preserve">Die Ergebnisdatei konnte nicht gespeichert werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreNotFound" xml:space="preserve">Die Sicherung wurde nicht gefunden.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreLoadFailed" xml:space="preserve">Die Sicherung konnte nicht geladen werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreRejected" xml:space="preserve">Nicht wiederhergestellt, weil der Inhalt der Sicherung nicht validiert werden konnte: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreSidMismatch" xml:space="preserve">Nicht wiederhergestellt, weil die Sicherung zu einem anderen Benutzer gehört.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreConflict" xml:space="preserve">Nicht überschrieben, weil ein abweichender Wert vorhanden ist.</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreFailed" xml:space="preserve">Konnte nicht wiederhergestellt werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Msg.RegistryRestoreVerifyFailed" xml:space="preserve">Die Überprüfung nach der Wiederherstellung ist fehlgeschlagen.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Purpose" xml:space="preserve">Der Registry-Cleaner macht Ihren PC nicht schneller. Vor dem Löschen wird eine Sicherung gespeichert, sodass Sie die Einträge später wiederherstellen können.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.NotScanned" xml:space="preserve">Noch nicht geprüft.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.Scanning" xml:space="preserve">Registrierung wird geprüft…</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Ui.ScanDone" xml:space="preserve">Prüfung abgeschlossen. {0} Löschkandidaten, {1} beibehalten.</x:String>
