  <x:String x:Key="Text.Cleanup.Registry.Ui.Backup.DeleteConfirm" xml:space="preserve">Die Sicherung vom {0} wird gelöscht. Nach dem Löschen kann daraus nichts mehr wiederhergestellt werden.</x:String>
