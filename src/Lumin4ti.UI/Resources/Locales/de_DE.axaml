  <x:String x:Key="Text.Cleanup.Kind.Form" xml:space="preserve">{0}-Formulardaten</x:String>
  <x:String x:Key="Text.Cleanup.Kind.Session" xml:space="preserve">{0}-Sitzungsdaten</x:String>
