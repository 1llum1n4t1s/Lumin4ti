  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Name" xml:space="preserve">App-Registrierungen (App Paths)</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.AppPaths.Description" xml:space="preserve">App-Startregistrierungen, deren ausführbare Zieldatei nicht existiert.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Name" xml:space="preserve">Autostart</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Startup.Description" xml:space="preserve">Beim Windows-Start ausgeführte Registrierungen, deren ausführbare Datei nicht existiert. Die Einstellung zum Aktivieren/Deaktivieren des Autostarts wird zusammen mit ihnen gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Name" xml:space="preserve">Schriftarten</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Fonts.Description" xml:space="preserve">Schriftartregistrierungen, deren Schriftartdatei nicht existiert.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Name" xml:space="preserve">Dateizuordnungen</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.FileAssociations.Description" xml:space="preserve">Zuordnungen wie „Öffnen mit“, deren App nicht mehr existiert. Die Einstellungen für Standard-Apps werden nicht geändert.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Name" xml:space="preserve">Deinstallationsinformationen</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.Uninstall.Description" xml:space="preserve">Deinstallationseinträge, deren Deinstallationsprogramm und Installationsort beide nicht existieren. Standardmäßig deaktiviert.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Name" xml:space="preserve">Freigegebene DLLs</x:String>
  <x:String x:Key="Text.Cleanup.Registry.Category.SharedDlls.Description" xml:space="preserve">Referenzzähler freigegebener DLLs, deren DLL nicht existiert. Standardmäßig deaktiviert.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.Title" xml:space="preserve">Registrierung</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.ExcludedFromSelectAll" xml:space="preserve">Nicht in „Alle auswählen“ enthalten. Wählen Sie nur die benötigten Einträge einzeln aus.</x:String>
  <x:String x:Key="Text.Cleanup.Registry.View.RequiresApproval" xml:space="preserve">Zum Löschen muss jeder Eintrag im Bestätigungsdialog von Ihnen genehmigt werden.</x:String>
