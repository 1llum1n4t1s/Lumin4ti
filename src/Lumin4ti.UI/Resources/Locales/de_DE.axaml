  <x:String x:Key="Text.Cleanup.Impact.Junk" xml:space="preserve">Überflüssige Dateien</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace" xml:space="preserve">Nutzungsspuren</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout" xml:space="preserve">Meldet Sie ab</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild" xml:space="preserve">Muss neu aufgebaut werden</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles" xml:space="preserve">Ihre Dateien</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Trace.Warning" xml:space="preserve">Ihr Nutzungsverlauf geht verloren.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Signout.Warning" xml:space="preserve">Durch das Löschen von Cookies können Sie auf Websites abgemeldet werden.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.Rebuild.Warning" xml:space="preserve">Die erste Nutzung nach dem Löschen kann langsamer sein, solange die Daten neu aufgebaut werden.</x:String>
  <x:String x:Key="Text.Cleanup.Impact.UserFiles.Warning" xml:space="preserve">Enthält eigene Dateien von Ihnen, die nicht erneut heruntergeladen werden können. Wählen Sie sie einzeln aus; vor dem Löschen müssen Sie noch einmal bestätigen.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.NotRecommended" xml:space="preserve">Dieser Eintrag wird standardmäßig nicht empfohlen. Prüfen Sie vor der Auswahl, was er entfernt.</x:String>
  <x:String x:Key="Text.Cleanup.Warning.JumpListPins" xml:space="preserve">Beim Löschen der Sprunglisten werden auch die an die Taskleiste und das Startmenü angehefteten Elemente entfernt.</x:String>

  <!-- 通常: 状態・理由 -->
  <x:String x:Key="Text.Cleanup.State.Found" xml:space="preserve">Kann gelöscht werden</x:String>
  <x:String x:Key="Text.Cleanup.State.Empty" xml:space="preserve">Nichts zu löschen</x:String>
  <x:String x:Key="Text.Cleanup.State.Unmeasurable" xml:space="preserve">Anzahl unbekannt</x:String>
  <x:String x:Key="Text.Cleanup.State.Unavailable" xml:space="preserve">Nicht verfügbar</x:String>
  <x:String x:Key="Text.Cleanup.State.NotDetected" xml:space="preserve">Nicht erkannt</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeDifferentUser" xml:space="preserve">Der angemeldete Benutzer und der Benutzer mit erhöhten Rechten sind verschieden. Daher sind Einträge, die Einstellungen und Daten eines Benutzers betreffen, deaktiviert.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.UserScopeUnknown" xml:space="preserve">Der angemeldete Benutzer konnte nicht überprüft werden. Daher sind Einträge, die Einstellungen und Daten eines Benutzers betreffen, deaktiviert.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.TargetRejected" xml:space="preserve">Das Ziel wurde aus Sicherheitsgründen abgelehnt (geschützter Speicherort, Anmeldedaten, Verknüpfung usw.).</x:String>
  <x:String x:Key="Text.Cleanup.Reason.ScanFailed" xml:space="preserve">Die Prüfung ist fehlgeschlagen.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.HandlerUnavailable" xml:space="preserve">Dies kann in dieser Umgebung nicht ausgeführt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Reason.CustomFolderRejected" xml:space="preserve">Dieser Speicherort ist als benutzerdefinierter Ordner nicht zulässig und wird übersprungen.</x:String>

  <!-- 通常: 画面・走査 -->
  <x:String x:Key="Text.Cleanup.Common.Title" xml:space="preserve">Standardbereinigung</x:String>
  <x:String x:Key="Text.Cleanup.Common.Description" xml:space="preserve">Prüfen Sie zuerst, was entfernt werden kann, und löschen Sie dann nur die ausgewählten Einträge. Beim Prüfen wird nichts verändert.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NotScanned" xml:space="preserve">Es wurde noch nichts geprüft. Klicken Sie auf „Prüfen“, um löschbare Daten zu finden.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Scanning" xml:space="preserve">Prüfe {0} von {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanDone" xml:space="preserve">Prüfung abgeschlossen: {0} Einträge, {1} Dateien, {2}</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanCanceled" xml:space="preserve">Die Prüfung wurde beendet.</x:String>
  <x:String x:Key="Text.Cleanup.Common.ScanFailed" xml:space="preserve">Die Prüfung ist fehlgeschlagen. Sehen Sie im Protokoll nach.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Stale" xml:space="preserve">Das Prüfergebnis ist veraltet, weil sich Einstellungen geändert haben oder ein anderer Vorgang lief. Prüfen Sie erneut.</x:String>
  <x:String x:Key="Text.Cleanup.Common.NothingFound" xml:space="preserve">Es wurden keine löschbaren Daten gefunden.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Selection" xml:space="preserve">{0} von {1} Einträgen ausgewählt (ca. {2})</x:String>
  <x:String x:Key="Text.Cleanup.Common.Retained" xml:space="preserve">{0} Einträge bleiben aufgrund Ihrer Ausschlüsse erhalten.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unreadable" xml:space="preserve">{0} Einträge konnten nicht geprüft werden.</x:String>
  <x:String x:Key="Text.Cleanup.Common.SkippedLinks" xml:space="preserve">{0} Einträge sind Verknüpfungen und werden nicht angetastet.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Unmeasurable" xml:space="preserve">Dies kann ausgeführt werden, aber Anzahl und Größe lassen sich vorher nicht ermitteln.</x:String>
  <x:String x:Key="Text.Cleanup.Common.Representatives" xml:space="preserve">Beispiel: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Common.RunningProcesses" xml:space="preserve">Läuft: {0} (vor dem Löschen werden Sie gefragt, ob es geschlossen werden soll)</x:String>
  <x:String x:Key="Text.Cleanup.Common.ServiceNote" xml:space="preserve">Während des Löschens vorübergehend beendete Dienste: {0}</x:String>

  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Löschen bestätigen</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Löschen</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Zurück</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">Die {0} ausgewählten Einträge ({1} Dateien, ca. {2}) werden endgültig gelöscht. Sie werden nicht in den Papierkorb verschoben und können nicht wiederhergestellt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">Enthält {0} nicht empfohlene Einträge. Prüfen Sie diese zuerst.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">Enthält {0} Einträge, durch die Sie abgemeldet werden können (z. B. Cookies).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} Einträge enthalten eigene Dateien von Ihnen, die nicht erneut heruntergeladen werden können. Sie müssen noch einmal bestätigen.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">Mir ist bewusst, dass meine Dateien endgültig gelöscht werden</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">Sicheres Löschen ist aktiviert. Dateien werden vor dem Löschen einmal überschrieben (auf SSDs kann dies nicht garantiert werden).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Einige Produkte laufen. Beim Löschen werden Sie gefragt, ob sie geschlossen werden sollen.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">„{0}“ läuft ({1}). Es muss geschlossen werden, bevor seine Daten gelöscht werden.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Schließen</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Diesen Eintrag überspringen</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Beenden</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">„{0}“ ließ sich nicht normal schließen ({1}). Beim erzwungenen Beenden gehen nicht gespeicherte Eingaben verloren.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Beenden erzwingen</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">Nicht erzwingen</x:String>

  <!-- 通常: 実行・結果 -->
  <x:String x:Key="Text.Cleanup.Run.Running" xml:space="preserve">Lösche {0} von {1}: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Done" xml:space="preserve">{0} Dateien gelöscht und {1} freigegeben</x:String>
  <x:String x:Key="Text.Cleanup.Run.DonePartial" xml:space="preserve">Teilweise abgeschlossen: {0} Dateien gelöscht und {1} freigegeben. Einige Einträge sind fehlgeschlagen oder wurden übersprungen.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Canceled" xml:space="preserve">Beendet. {0} Dateien ({1}) waren bereits gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Stale" xml:space="preserve">Es wurde nichts gelöscht, weil das Prüfergebnis veraltet war. Prüfen Sie erneut.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Retained" xml:space="preserve">{0} Einträge blieben aufgrund von Ausschlüssen oder Änderungen nach der Prüfung erhalten.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Blocked" xml:space="preserve">{0} Einträge konnten nicht gelöscht werden (in Verwendung, keine Berechtigung usw.).</x:String>
  <x:String x:Key="Text.Cleanup.Run.Wiped" xml:space="preserve">{0} Einträge wurden vor dem Löschen überschrieben ({1} wurden ohne Überschreiben gelöscht).</x:String>
  <x:String x:Key="Text.Cleanup.Run.ServiceResumeFailed" xml:space="preserve">Ein vorübergehend beendeter Dienst ließ sich nicht neu starten. Prüfen Sie den Dienststatus.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Succeeded" xml:space="preserve">Erfolgreich</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NothingToDo" xml:space="preserve">Nichts zu tun</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Partial" xml:space="preserve">Teilweise abgeschlossen</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Failed" xml:space="preserve">Fehlgeschlagen</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Skipped" xml:space="preserve">Übersprungen</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.Canceled" xml:space="preserve">Beendet</x:String>
  <x:String x:Key="Text.Cleanup.Run.Status.NotRun" xml:space="preserve">Nicht ausgeführt</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NotScanned" xml:space="preserve">Nicht geprüft und daher nicht gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NothingFound" xml:space="preserve">Es gab nichts zu löschen.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">Dies kann in dieser Umgebung nicht ausgeführt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.UserFilesNotConfirmed" xml:space="preserve">Nicht gelöscht, weil die Bestätigung für Ihre Dateien fehlt.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessRunningDeclined" xml:space="preserve">Übersprungen, weil das Produkt läuft.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessUnverifiable" xml:space="preserve">Übersprungen, weil der Besitzer eines laufenden Prozesses nicht überprüft werden konnte.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessStillRunning" xml:space="preserve">Übersprungen, weil das Produkt nicht geschlossen wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ForceTerminationDeclined" xml:space="preserve">Übersprungen, weil das erzwungene Beenden nicht genehmigt wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.ProcessIdentityMismatch" xml:space="preserve">Übersprungen, weil der Prozess nicht zugeordnet werden konnte und daher nicht geschlossen wurde.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.TerminateFailed" xml:space="preserve">Übersprungen, weil das Produkt nicht geschlossen werden konnte.</x:String>
  <x:String x:Key="Text.Cleanup.Totals.Last" xml:space="preserve">Letzter Lauf: {0} Dateien, {1} ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Totals.Total" xml:space="preserve">Gesamt: {0} Dateien, {1}</x:String>

  <!-- 書き出し・場所を開く -->
  <x:String x:Key="Text.Cleanup.Export.Title" xml:space="preserve">Prüfergebnisse exportieren</x:String>
