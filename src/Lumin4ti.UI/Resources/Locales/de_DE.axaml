  <!-- 高度: 画面 -->
  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">Erweiterte Bereinigung</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">Durchsucht die ausgewählten Laufwerke anhand von Mustern nach Dateien, die sich in der Regel gefahrlos entfernen lassen. Beim Prüfen wird nichts verändert. Sehen Sie sich die Ergebnisse an und löschen Sie dann nur die ausgewählten.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">Zu prüfende Laufwerke</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">Wechseldatenträger</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">Fest eingebaut</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">Dateien mit 0 Bytes einbeziehen</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">Verknüpfungen mit fehlendem Ziel einbeziehen</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">Dateien einbeziehen, die älter als die angegebene Anzahl Tage sind</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">Tage</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">Nur sichere Einträge auswählen</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">Standard</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">Zusätzlich</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">Benutzerdefiniert</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">Sicher</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">Nicht feststellbar</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">Benutzerdefiniert</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">Eine .chk-Datei außerhalb eines FOUND-Ordners. Es könnte ein ESE-Prüfpunkt sein; sie bleibt daher abgewählt, bis Sie sie geprüft haben.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">In den letzten 24 Stunden geändert und daher standardmäßig nicht ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">Eine Datei mit 0 Bytes und daher standardmäßig nicht ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">Nur wegen ihres Alters gefunden und daher standardmäßig nicht ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">Entspricht einem von Ihnen definierten Muster und ist daher standardmäßig nicht ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">Namensmuster</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">0 Bytes</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">Ungültige Verknüpfung</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">Alte Datei</x:String>

  <!-- 高度: 走査・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">{0} Ordner und {1} Dateien geprüft; {2} Treffer ({3}): {4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">Prüfung abgeschlossen: {0} Treffer ({1}) unter {2} geprüften Dateien.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">Es gibt zu viele Treffer, daher werden nur die ersten {0} angezeigt. Die übrigen {1} ({2}) werden weder angezeigt noch gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">Prüfung nicht möglich: {0} ({1})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">{0} Ordner wurden nicht geprüft, weil sie geschützt oder ausgeschlossen sind.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">Keine Datei entspricht den Kriterien.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">{0} von {1} Dateien ausgewählt ({2})</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">Benutzerdefinierte Ordner</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">Es wird nur der Inhalt des Ordners geleert. Der Ordner selbst bleibt bestehen.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">Nicht gefunden</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} Dateien, {1}</x:String>

  <!-- 高度: 確認・結果 -->
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">Die {0} ausgewählten Dateien ({1}) und der Inhalt von {2} benutzerdefinierten Ordnern werden endgültig gelöscht. Sie werden nicht in den Papierkorb verschoben und können nicht wiederhergestellt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">Enthält {0} als „nicht feststellbar“ markierte Dateien. Heben Sie die Auswahl der Dateien auf, die Sie nicht geprüft haben.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">Enthält {0} Dateien, die in den letzten 24 Stunden geändert wurden.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Done" xml:space="preserve">{0} Dateien und {1} Ordner gelöscht, {2} freigegeben</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Partial" xml:space="preserve">Teilweise abgeschlossen: {0} Dateien und {1} Ordner gelöscht, {2} freigegeben. Einige Einträge blieben erhalten oder ließen sich nicht löschen.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Expired" xml:space="preserve">Es wurde nichts gelöscht, weil das Prüfergebnis veraltet war. Prüfen Sie erneut.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Cancelled" xml:space="preserve">Beendet. {0} Dateien ({1}) waren bereits gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Blocked" xml:space="preserve">{0} Dateien konnten nicht gelöscht werden (in Verwendung, keine Berechtigung usw.).</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Retained" xml:space="preserve">{0} Dateien blieben aufgrund von Ausschlüssen oder Änderungen nach der Prüfung erhalten.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Gone" xml:space="preserve">{0} Dateien waren nicht mehr vorhanden.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Covered" xml:space="preserve">{0} Dateien liegen in einem ausgewählten benutzerdefinierten Ordner und wurden nicht gesondert behandelt.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Result.Rejected" xml:space="preserve">{0} Einträge wurden von einer Sicherheitsprüfung abgelehnt.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Invalid" xml:space="preserve">Dieser Pfad kann nicht als Ordner verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.DriveRoot" xml:space="preserve">Das Stammverzeichnis eines Laufwerks kann nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Windows" xml:space="preserve">Der Windows-Ordner sowie seine übergeordneten und untergeordneten Ordner können nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramFiles" xml:space="preserve">Program Files sowie die übergeordneten und untergeordneten Ordner können nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProgramData" xml:space="preserve">ProgramData sowie die übergeordneten und untergeordneten Ordner können nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.OtherUserProfile" xml:space="preserve">Das Profil eines anderen Benutzers kann nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.ProfileRoot" xml:space="preserve">Ihr Profilordner und AppData können nicht verwendet werden, weil das Leeren alle Ihre Daten vernichten würde.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Reject.Credential" xml:space="preserve">Speicherorte mit Anmeldedaten oder Schlüsseln können nicht verwendet werden.</x:String>
  <x:String x:Key="Text.Cleanup.CustomFolder.Added" xml:space="preserve">Der benutzerdefinierte Ordner wurde hinzugefügt.</x:String>

  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Verschlanken</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Schafft Speicherplatz, indem Daten entfernt werden, die Windows nicht benötigt. Einige Einträge lassen sich nicht rückgängig machen oder können spätere Reparaturen beeinträchtigen. Daher ist standardmäßig nichts ausgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Auswahl ausführen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Vor der Ausführung einen Wiederherstellungspunkt erstellen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Eintrag</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">Status</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Geschätzter Speicherplatz</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">Ca. {0} (Schätzung)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Unbekannt</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Es wurde noch nichts geprüft. Klicken Sie auf „Prüfen“, um zu sehen, wie viel Speicherplatz jeder Eintrag freigeben kann.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Prüfe die Einträge zum Verschlanken …</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Prüfung abgeschlossen. {0} Einträge können ausgeführt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">Die Prüfung ist fehlgeschlagen. Sehen Sie im Protokoll nach.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">Es wurde nichts ausgeführt, weil das Prüfergebnis veraltet war. Prüfen Sie erneut.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Einträge, die DISM verwenden, können mehrere Minuten oder länger dauern.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Bereit</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Nichts zu bereinigen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">Nicht verfügbar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Hinweis</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Vorsicht</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">Nicht rückgängig zu machen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">Die Registrierungsdaten konnten nicht vollständig gelesen werden, daher lässt sich dies nicht sicher beurteilen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows schützt diese Dateien, daher gibt es nichts zu entfernen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">Die Sprache wird von der Anzeigesprache, der Sprachliste oder einem Tastaturlayout verwendet und kann nicht entfernt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">Die Daten einiger Benutzer sind nicht geladen, daher lässt sich die Verwendung nicht überprüfen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">Das Ziel ist nicht installiert oder wurde nicht gefunden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">Das Ergebnis von DISM konnte nicht gelesen oder verstanden werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">Eine Sicherheitsprüfung hat das Ziel abgelehnt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Erfolgreich</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Teilweise abgeschlossen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">Fehlgeschlagen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">Übersprungen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">Beendet</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Verschlanken bestätigen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">Die {0} ausgewählten Einträge (geschätzter Speicherplatz: {1}) werden ausgeführt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Vor der Ausführung wird ein Wiederherstellungspunkt erstellt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Es wird kein Wiederherstellungspunkt erstellt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Nicht rückgängig zu machende Aktion bestätigen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Nach dem Entfernen der Daten zum Zurücksetzen von Updates lassen sich bereits installierte Updates nicht mehr deinstallieren. Dies kann nicht rückgängig gemacht werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Mir ist bewusst, dass sich installierte Updates dann nicht mehr deinstallieren lassen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">Ein Wiederherstellungspunkt wurde erstellt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Der vorhandene Wiederherstellungspunkt vom {0} wird verwendet (innerhalb von 24 Stunden wird kein neuer erstellt).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">Kein Wiederherstellungspunkt verfügbar</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">Ein Wiederherstellungspunkt konnte nicht erstellt werden: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">Der Systemschutz ist deaktiviert, daher kann kein Wiederherstellungspunkt erstellt werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Ohne fortfahren</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Beenden</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Systemschutz aktivieren und erneut versuchen</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Führe {0} von {1} aus: {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Fertig. Freigegebener Speicherplatz: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Einige Einträge wurden nicht abgeschlossen. Prüfen Sie das Ergebnis der einzelnen Einträge.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">Ein Neustart ist erforderlich, damit die Änderungen wirksam werden.</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Bereinigungseinstellungen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Einstellungen gespeichert.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">Die Einstellungen konnten nicht gespeichert werden. Sehen Sie im Protokoll nach.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Ausschlüsse</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Ausgeschlossene Einträge bleiben unberührt: Sie werden weder geprüft noch gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Hinzufügen</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Aus der Liste entfernen</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Importieren</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Exportieren</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Ausschlüsse importieren</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Ausschlüsse exportieren</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">Dateien</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Beispiel: C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Ordner</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Beispiel: C:\Users\me\Projects (einschließlich Unterordner)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Erweiterungen und Dateinamen</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Beispiel: *.log oder cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Cookie-Domänen</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Beispiel: example.com (einschließlich Subdomänen)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Hinzugefügt.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Bereits in der Liste.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">Das Format ist ungültig.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">Das Limit von {0} Einträgen wurde erreicht.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">Die Datei ist zu groß.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">Die Datei konnte nicht gelesen werden.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">Das Dateiformat ist ungültig.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Diese Version kann dieses Format nicht lesen.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Es gibt zu viele Einträge, daher wurde nichts importiert.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} hinzugefügt (Duplikate: {1}, abgelehnt: {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Nach {0} exportiert.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Export nicht möglich: {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Art des Löschens</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Sicheres Löschen (einmal überschreiben, dann löschen)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Überschreibt den Inhalt einer Datei einmal, bevor sie gelöscht wird. Auf SSDs lässt sich das Löschen damit nicht garantieren. Dateien mit Hardlinks sowie komprimierte, Sparse- oder verschlüsselte Dateien werden ohne Überschreiben gelöscht.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Vor dem Verschlanken einen Wiederherstellungspunkt erstellen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Ein vorhandener Wiederherstellungspunkt der letzten 24 Stunden wird wiederverwendet. Ist der Systemschutz deaktiviert, können Sie ihn nach einer Bestätigung aktivieren.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Systemwiederherstellung öffnen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Benutzerdefinierte Ordner</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Ordner, deren Inhalt die erweiterte Bereinigung leeren kann. Windows, Program Files, ProgramData, Profile anderer Benutzer, Laufwerks-Stammverzeichnisse und Speicherorte mit Anmeldedaten sind nicht zulässig. Hinzugefügte Ordner sind zunächst immer abgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Ordner hinzufügen …</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Benutzerdefinierten Ordner auswählen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Benutzerdefinierte Erweiterungen und Dateinamen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Werden der Suche der erweiterten Bereinigung hinzugefügt. Treffer sind zunächst immer abgewählt.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Beispiel: *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Integrierte Muster</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Standardauswahl pro Eintrag</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Überschreibt die empfohlene Standardauswahl eines Eintrags in der Standardbereinigung.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Auf Standard zurücksetzen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Empfehlung übernehmen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Immer auswählen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Nie auswählen</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Bisherige Ergebnisse</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Es wurde noch nichts ausgeführt.</x:String>

  <!-- Windows 項目の名称 (Definitions の nameKey) -->
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Verlauf des Ausführen-Dialogs</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Zuletzt verwendete Elemente</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Verlauf der Remotedesktopverbindungen</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Verlauf der Dialoge „Öffnen“ und „Speichern unter“</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Suchverlauf des Datei-Explorers</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Verlauf von „Netzlaufwerk verbinden“</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Sprunglisten</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Internet-Explorer-Verlauf und eingegebene Adressen</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Verlauf gestarteter Programme (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Fehlerberichte des Benutzers (Windows-Fehlerberichterstattung)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">Temporäre Benutzerdateien</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">Temporäre Systemdateien</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Absturzabbilder im Benutzermodus</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Systemspeicherabbilder</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Berichte der Windows-Fehlerberichterstattung</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Protokolle des Windows-Update-Orchestrators</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">ETL-Ablaufverfolgungsprotokolle</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Diagnoseprotokolle von Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Miniaturansichts-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Symbol-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Windows-Schriftart-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Bitmap-Cache des Remotedesktops</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">DirectX-Shader-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Alte Prefetch-Daten</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Papierkorb</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">DNS-Resolver-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Verlauf der Netzwerknutzung</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Ungültige Verknüpfungen und Startmenüeinträge</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Ungültige geplante Aufgaben</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Internet-Cache (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Cache der Office-Add-Ins</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Zertifikats-URL-Cache (CryptnetUrlCache)</x:String>

  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Verwaiste Windows-Installer-Dateien</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Löscht .msi- und .msp-Dateien im Windows-Installer-Ordner, die keinem Produkt und keinem Patch zugeordnet und älter als 30 Tage sind.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Wenn die Registrierungsdaten nicht vollständig gelesen werden können, ist dieser Eintrag nicht verfügbar. Die Registrierungen werden unmittelbar vor dem Löschen erneut geprüft.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Daten zum Zurücksetzen von Updates</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Entfernt mit DISM /StartComponentCleanup /ResetBase die Daten, die zum Zurücksetzen bereits installierter Updates nötig sind.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Danach lassen sich installierte Updates nicht mehr deinstallieren. Dies kann nicht rückgängig gemacht werden.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Update-Sicherungen (Komponentenspeicher)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Bereinigt mit DISM /StartComponentCleanup ersetzte Komponenten.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">Der angezeigte Speicherplatz ist eine DISM-Schätzung und kann vom tatsächlich freigegebenen abweichen. Dies kann mehrere Minuten dauern.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Download-Cache von Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Löscht den Inhalt von SoftwareDistribution\Download. Die Dienste Windows Update und BITS werden während des Vorgangs beendet und anschließend wiederhergestellt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Übrig gebliebener Patch-Cache</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Beendet den Windows-Installer-Dienst und löscht den Inhalt von Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Spätere Reparaturen oder Deinstallationen verlangen möglicherweise die ursprünglichen Installationsmedien.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Spracheingabefunktionen (Japanisch)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Entfernt mit DISM Remove-Capability die japanischen Funktionen von Language.Basic (Rechtschreibung, Textvorhersage usw.). Der IME selbst ist nicht betroffen. Dies ist nur möglich, wenn die Sprache nicht von der Anzeigesprache, der Sprachliste oder einem Tastaturlayout verwendet wird.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Um diese Sprachfunktionen wieder zu nutzen, müssen Sie sie erneut hinzufügen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Spracheingabefunktionen (Koreanisch)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Entfernt mit DISM Remove-Capability die koreanischen Funktionen von Language.Basic (Rechtschreibung, Textvorhersage usw.). Der IME selbst ist nicht betroffen. Dies ist nur möglich, wenn die Sprache nicht von der Anzeigesprache, der Sprachliste oder einem Tastaturlayout verwendet wird.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Um diese Sprachfunktionen wieder zu nutzen, müssen Sie sie erneut hinzufügen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Spracheingabefunktionen (Chinesisch, traditionell)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Entfernt mit DISM Remove-Capability die Funktionen von Language.Basic für traditionelles Chinesisch (Rechtschreibung, Textvorhersage usw.). Der IME selbst ist nicht betroffen. Dies ist nur möglich, wenn die Sprache nicht von der Anzeigesprache, der Sprachliste oder einem Tastaturlayout verwendet wird.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Um diese Sprachfunktionen wieder zu nutzen, müssen Sie sie erneut hinzufügen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Spracheingabefunktionen (Chinesisch, vereinfacht)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Entfernt mit DISM Remove-Capability die Funktionen von Language.Basic für vereinfachtes Chinesisch (Rechtschreibung, Textvorhersage usw.). Der IME selbst ist nicht betroffen. Dies ist nur möglich, wenn die Sprache nicht von der Anzeigesprache, der Sprachliste oder einem Tastaturlayout verwendet wird.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Um diese Sprachfunktionen wieder zu nutzen, müssen Sie sie erneut hinzufügen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Windows-Hilfedateien</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Löscht Windows-Hilfedateien. Unter Windows 10/11 werden sie vom Windows-Ressourcenschutz geschützt, daher gibt es in der Regel nichts zu löschen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Von Windows geschützte oder TrustedInstaller gehörende Dateien bleiben unberührt. Besitzrechte werden nie übernommen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Standardhintergrundbilder</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Löscht die Standardhintergrundbilder von Windows. Unter Windows 10/11 werden sie vom Windows-Ressourcenschutz geschützt, daher gibt es in der Regel nichts zu löschen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Von Windows geschützte oder TrustedInstaller gehörende Dateien bleiben unberührt. Besitzrechte werden nie übernommen.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Beispielmusik</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Löscht nur die bekannten Beispiellieder, die mit Windows 7 geliefert wurden. Andere Dateien im Ordner bleiben unberührt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Beispielbilder</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Löscht nur die bekannten Beispielbilder, die mit Windows 7 geliefert wurden. Andere Dateien im Ordner bleiben unberührt.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Beispielvideos</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Löscht nur das bekannte Beispielvideo, das mit Windows 7 geliefert wurde. Andere Dateien im Ordner bleiben unberührt.</x:String>
