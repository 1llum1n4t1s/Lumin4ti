  <x:String x:Key="Text.Cleanup.Run.Status.NotRun" xml:space="preserve">Non exécuté</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.NotScanned" xml:space="preserve">Non analysé, donc non supprimé.</x:String>
