  <!-- 通常: 確認 -->
  <x:String x:Key="Text.Cleanup.Confirm.Title" xml:space="preserve">Confirmer la suppression</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Run" xml:space="preserve">Supprimer</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Back" xml:space="preserve">Retour</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Common.Body" xml:space="preserve">Les {0} éléments sélectionnés ({1} fichiers, environ {2}) seront supprimés définitivement. Ils ne sont pas placés dans la Corbeille et ne peuvent pas être restaurés.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.NotRecommended" xml:space="preserve">Comprend {0} éléments non recommandés. Vérifiez-les d'abord.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.Signout" xml:space="preserve">Comprend {0} éléments qui peuvent vous déconnecter (comme les cookies).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles" xml:space="preserve">{0} éléments comprennent des fichiers personnels qui ne peuvent pas être téléchargés à nouveau. Une confirmation supplémentaire vous est demandée.</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.UserFiles.Check" xml:space="preserve">Je comprends que mes fichiers seront supprimés définitivement</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.SecureDelete" xml:space="preserve">La suppression sécurisée est activée. Les fichiers sont écrasés une fois avant d'être supprimés (cela ne peut pas être garanti sur les SSD).</x:String>
  <x:String x:Key="Text.Cleanup.Confirm.RunningProcess" xml:space="preserve">Certains produits sont en cours d'exécution. Il vous sera demandé s'il faut les fermer pendant la suppression.</x:String>

  <!-- 通常: 実行中のプロセスの確認 -->
  <x:String x:Key="Text.Cleanup.Process.Body" xml:space="preserve">« {0} » est en cours d'exécution ({1}). Il doit être fermé avant la suppression de ses données.</x:String>
  <x:String x:Key="Text.Cleanup.Process.Close" xml:space="preserve">Le fermer</x:String>
  <x:String x:Key="Text.Cleanup.Process.Skip" xml:space="preserve">Ignorer cet élément</x:String>
  <x:String x:Key="Text.Cleanup.Process.Abort" xml:space="preserve">Arrêter</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceBody" xml:space="preserve">« {0} » n'a pas pu être fermé normalement ({1}). Le forcer à quitter fait perdre toute saisie non enregistrée.</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceYes" xml:space="preserve">Forcer à quitter</x:String>
  <x:String x:Key="Text.Cleanup.Process.ForceNo" xml:space="preserve">Ne pas forcer</x:String>

