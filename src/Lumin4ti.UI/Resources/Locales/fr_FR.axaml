  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">Trouvé uniquement parce qu'il est ancien ; il n'est donc pas sélectionné par défaut.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">Correspond à un motif que vous avez défini ; il n'est donc pas sélectionné par défaut.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">Motif de nom</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">0 octet</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">Raccourci non valide</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">Fichier ancien</x:String>

