  <x:String x:Key="Text.Cleanup.Run.Skip.Unavailable" xml:space="preserve">Cette opération ne peut pas s'exécuter dans cet environnement.</x:String>
  <x:String x:Key="Text.Cleanup.Run.Skip.UserFilesNotConfirmed" xml:space="preserve">Non supprimé, car la confirmation pour vos fichiers n'a pas été donnée.</x:String>
