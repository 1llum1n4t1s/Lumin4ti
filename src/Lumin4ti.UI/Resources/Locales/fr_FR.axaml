  <!-- スリム化: 画面 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Title" xml:space="preserve">Allègement</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Description" xml:space="preserve">Libère de l'espace disque en supprimant des données dont Windows n'a pas besoin. Certains éléments sont irréversibles ou peuvent affecter des réparations ultérieures ; aucun n'est donc sélectionné par défaut.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Run" xml:space="preserve">Exécuter la sélection</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.CreateRestorePoint" xml:space="preserve">Créer un point de restauration avant l'exécution</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Item" xml:space="preserve">Élément</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Status" xml:space="preserve">État</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Column.Size" xml:space="preserve">Espace estimé</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Estimate" xml:space="preserve">Environ {0} (estimation)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.SizeUnknown" xml:space="preserve">Inconnu</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.NotScanned" xml:space="preserve">Aucune analyse n'a encore été effectuée. Cliquez sur Analyser pour voir combien d'espace chaque élément peut libérer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Scanning" xml:space="preserve">Vérification des éléments d'allègement…</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanDone" xml:space="preserve">Analyse terminée. {0} éléments peuvent être exécutés.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.ScanFailed" xml:space="preserve">L'analyse a échoué. Consultez le journal.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Stale" xml:space="preserve">Rien n'a été exécuté car le résultat de l'analyse était obsolète. Analysez à nouveau.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.LongRunning" xml:space="preserve">Les éléments qui utilisent DISM peuvent prendre plusieurs minutes, voire davantage.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Available" xml:space="preserve">Prêt</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.NothingToClean" xml:space="preserve">Rien à nettoyer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Status.Unavailable" xml:space="preserve">Indisponible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Notice" xml:space="preserve">Remarque</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Caution" xml:space="preserve">Attention</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Level.Irreversible" xml:space="preserve">Irréversible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.EnumerationFailed" xml:space="preserve">Les données d'enregistrement n'ont pas pu être lues entièrement ; il est donc impossible de juger en toute sécurité.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ProtectedByWindows" xml:space="preserve">Windows protège ces fichiers ; il n'y a donc rien à supprimer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.LanguageInUse" xml:space="preserve">Elle est utilisée par la langue d'affichage, la liste des langues ou une disposition de clavier ; elle ne peut donc pas être supprimée.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.UserHiveNotLoaded" xml:space="preserve">Les données de certains utilisateurs ne sont pas chargées ; l'utilisation ne peut donc pas être vérifiée.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.NotPresent" xml:space="preserve">La cible n'est pas installée ou est introuvable.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.ToolFailed" xml:space="preserve">Le résultat de DISM n'a pas pu être lu ou compris.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Reason.Rejected" xml:space="preserve">Un contrôle de sécurité a rejeté la cible.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Succeeded" xml:space="preserve">Réussi</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Partial" xml:space="preserve">Terminé en partie</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Failed" xml:space="preserve">Échec</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Skipped" xml:space="preserve">Ignoré</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Result.Cancelled" xml:space="preserve">Arrêté</x:String>

  <!-- スリム化: 確認・復元ポイント・結果 -->
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Title" xml:space="preserve">Confirmer l'allègement</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Body" xml:space="preserve">Les {0} éléments sélectionnés (espace estimé : {1}) vont être exécutés.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithRestorePoint" xml:space="preserve">Un point de restauration est créé avant l'exécution.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.WithoutRestorePoint" xml:space="preserve">Aucun point de restauration n'est créé.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Title" xml:space="preserve">Confirmer une action irréversible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Body" xml:space="preserve">Une fois les données de restauration des mises à jour supprimées, les mises à jour déjà installées ne pourront plus être désinstallées. Cette action est irréversible.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Confirm.Irreversible.Check" xml:space="preserve">Je comprends que les mises à jour installées ne pourront plus être désinstallées</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Created" xml:space="preserve">Un point de restauration a été créé.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Reused" xml:space="preserve">Utilisation du point de restauration existant créé le {0} (aucun nouveau point n'est créé dans les 24 heures).</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Title" xml:space="preserve">Aucun point de restauration disponible</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Unavailable.Body" xml:space="preserve">Un point de restauration n'a pas pu être créé : {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Disabled.Body" xml:space="preserve">La protection du système est désactivée ; un point de restauration ne peut donc pas être créé.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.ContinueWithout" xml:space="preserve">Continuer sans point de restauration</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.Abort" xml:space="preserve">Arrêter</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RestorePoint.EnableAndRetry" xml:space="preserve">Activer la protection du système et réessayer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Running" xml:space="preserve">Exécution de {0} sur {1} : {2}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.Done" xml:space="preserve">Terminé. Espace libéré : {0}</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.DonePartial" xml:space="preserve">Certains éléments ne sont pas allés au bout. Vérifiez le résultat de chaque élément.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Ui.RebootRequired" xml:space="preserve">Un redémarrage est nécessaire pour que les modifications prennent effet.</x:String>

  <!-- 設定 -->
  <x:String x:Key="Text.Cleanup.Settings.Title" xml:space="preserve">Paramètres de nettoyage</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Saved" xml:space="preserve">Paramètres enregistrés.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveFailed" xml:space="preserve">Les paramètres n'ont pas pu être enregistrés. Consultez le journal.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions" xml:space="preserve">Exclusions</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Exclusions.Description" xml:space="preserve">Les éléments exclus sont laissés intacts : ils ne sont ni analysés ni supprimés.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add" xml:space="preserve">Ajouter</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Remove" xml:space="preserve">Retirer de la liste</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import" xml:space="preserve">Importer</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export" xml:space="preserve">Exporter</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Title" xml:space="preserve">Importer les exclusions</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Title" xml:space="preserve">Exporter les exclusions</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.File" xml:space="preserve">Fichiers</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.File" xml:space="preserve">Exemple : C:\Users\me\notes.txt</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Folder" xml:space="preserve">Dossiers</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Folder" xml:space="preserve">Exemple : C:\Users\me\Projects (sous-dossiers compris)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.Name" xml:space="preserve">Extensions et noms de fichiers</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.Name" xml:space="preserve">Exemple : *.log ou cache.db</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Kind.CookieDomain" xml:space="preserve">Domaines de cookies</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Hint.CookieDomain" xml:space="preserve">Exemple : example.com (sous-domaines compris)</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Added" xml:space="preserve">Ajouté.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Duplicate" xml:space="preserve">Déjà dans la liste.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.Invalid" xml:space="preserve">Le format n'est pas valide.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Add.LimitReached" xml:space="preserve">La limite de {0} entrées est atteinte.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooLarge" xml:space="preserve">Le fichier est trop volumineux.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.Unreadable" xml:space="preserve">Le fichier n'a pas pu être lu.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.InvalidFormat" xml:space="preserve">Le format du fichier n'est pas valide.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.UnsupportedSchema" xml:space="preserve">Cette version ne peut pas lire ce format.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Failure.TooManyEntries" xml:space="preserve">Il y a trop d'entrées ; rien n'a été importé.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Import.Done" xml:space="preserve">{0} ajoutées (doublons : {1}, rejetées : {2}).</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Done" xml:space="preserve">Exporté vers {0}.</x:String>
  <x:String x:Key="Text.Cleanup.Exclusion.Export.Failed" xml:space="preserve">Exportation impossible : {0}</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Options" xml:space="preserve">Mode de suppression des fichiers</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete" xml:space="preserve">Suppression sécurisée (écraser une fois, puis supprimer)</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SecureDelete.Note" xml:space="preserve">Écrase une fois le contenu d'un fichier avant de le supprimer. Cela ne garantit pas l'effacement sur les SSD. Les fichiers avec des liens physiques, ainsi que les fichiers compressés, fragmentés (sparse) ou chiffrés, sont supprimés sans écrasement.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint" xml:space="preserve">Créer un point de restauration avant l'allègement</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CreateRestorePoint.Note" xml:space="preserve">Un point de restauration existant datant de moins de 24 heures est réutilisé. Si la protection du système est désactivée, vous pouvez l'activer après confirmation.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.OpenSystemRestore" xml:space="preserve">Ouvrir la restauration du système</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders" xml:space="preserve">Dossiers personnalisés</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Description" xml:space="preserve">Dossiers dont le nettoyage avancé peut vider le contenu. Windows, Program Files, ProgramData, les profils d'autres utilisateurs, les racines de lecteurs et les emplacements contenant des identifiants ne sont pas autorisés. Les dossiers ajoutés commencent toujours désélectionnés.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Add" xml:space="preserve">Ajouter un dossier…</x:String>
  <x:String x:Key="Text.Cleanup.Settings.CustomFolders.Pick" xml:space="preserve">Choisir un dossier personnalisé</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns" xml:space="preserve">Extensions et noms de fichiers définis par l'utilisateur</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Description" xml:space="preserve">Ajoutés à la recherche du nettoyage avancé. Les correspondances commencent toujours désélectionnées.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.Hint" xml:space="preserve">Exemple : *.xyz</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Patterns.BuiltIn" xml:space="preserve">Motifs intégrés</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules" xml:space="preserve">Sélection par défaut par élément</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Description" xml:space="preserve">Remplace la sélection par défaut recommandée d'un élément dans le nettoyage standard.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rules.Reset" xml:space="preserve">Rétablir les valeurs par défaut</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Default" xml:space="preserve">Suivre la recommandation</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.On" xml:space="preserve">Toujours sélectionner</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Rule.Off" xml:space="preserve">Ne jamais sélectionner</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals" xml:space="preserve">Résultats cumulés</x:String>
  <x:String x:Key="Text.Cleanup.Settings.Totals.None" xml:space="preserve">Rien n'a encore été exécuté.</x:String>

  <!-- Windows 項目の名称 (Definitions の nameKey) -->
  <x:String x:Key="Text.Cleanup.Rule.traces.run-history" xml:space="preserve">Historique de la boîte de dialogue Exécuter</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.recent-items" xml:space="preserve">Éléments récents</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.rdp-history" xml:space="preserve">Historique des connexions Bureau à distance</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.explorer-mru" xml:space="preserve">Historique des boîtes de dialogue Ouvrir et Enregistrer</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.search-history" xml:space="preserve">Historique de recherche de l'Explorateur de fichiers</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.network-drive-history" xml:space="preserve">Historique de Connecter un lecteur réseau</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.jump-lists" xml:space="preserve">Listes de raccourcis</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.ie-history" xml:space="preserve">Historique d'Internet Explorer et adresses saisies</x:String>
  <x:String x:Key="Text.Cleanup.Rule.traces.userassist" xml:space="preserve">Historique des programmes lancés (UserAssist)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-error-reports" xml:space="preserve">Rapports d'erreurs Windows de l'utilisateur actuel</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.user-temp" xml:space="preserve">Fichiers temporaires de l'utilisateur</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.system-temp" xml:space="preserve">Fichiers temporaires du système</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.crash-dumps" xml:space="preserve">Fichiers de vidage en mode utilisateur</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.memory-dumps" xml:space="preserve">Fichiers de vidage de la mémoire système</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.error-reports" xml:space="preserve">Rapports de signalement d'erreurs Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.update-logs" xml:space="preserve">Journaux de l'orchestrateur Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.etl-trace-logs" xml:space="preserve">Journaux de trace ETL</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.defender-support-logs" xml:space="preserve">Journaux de diagnostic de Microsoft Defender</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.thumbnail-cache" xml:space="preserve">Cache des miniatures</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.icon-cache" xml:space="preserve">Cache des icônes</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.font-cache" xml:space="preserve">Cache des polices Windows</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.remote-desktop-cache" xml:space="preserve">Cache bitmap du Bureau à distance</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.directx-shader-cache" xml:space="preserve">Cache de shaders DirectX</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.prefetch" xml:space="preserve">Anciennes données Prefetch</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.recycle-bin" xml:space="preserve">Corbeille</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.dns-cache" xml:space="preserve">Cache du résolveur DNS</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.network-usage" xml:space="preserve">Historique d'utilisation du réseau</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-shortcuts" xml:space="preserve">Raccourcis et entrées du menu Démarrer non valides</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.invalid-scheduled-tasks" xml:space="preserve">Tâches planifiées non valides</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.internet-cache" xml:space="preserve">Cache Internet (WinINet)</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.office-addin-cache" xml:space="preserve">Cache des compléments Office</x:String>
  <x:String x:Key="Text.Cleanup.Rule.windows.cryptnet-url-cache" xml:space="preserve">Cache des URL de certificats (CryptnetUrlCache)</x:String>

  <!-- スリム化 15 項目 (SlimItemDefinition の NameKey / DescriptionKey / WarningKey) -->
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Name" xml:space="preserve">Fichiers orphelins de Windows Installer</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Description" xml:space="preserve">Supprime les fichiers .msi et .msp du dossier Windows Installer qui ne sont associés à aucun produit ni correctif et datent de plus de 30 jours.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.InstallerOrphans.Warning" xml:space="preserve">Si les données d'enregistrement ne peuvent pas être lues entièrement, cet élément est indisponible. Les enregistrements sont vérifiés à nouveau juste avant la suppression.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Name" xml:space="preserve">Données de restauration des mises à jour</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Description" xml:space="preserve">Utilise DISM /StartComponentCleanup /ResetBase pour supprimer les données nécessaires à la restauration des mises à jour déjà installées.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateRollback.Warning" xml:space="preserve">Après cette opération, les mises à jour installées ne pourront plus être désinstallées. Cette action est irréversible.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Name" xml:space="preserve">Sauvegardes des mises à jour (magasin de composants)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Description" xml:space="preserve">Utilise DISM /StartComponentCleanup pour nettoyer les composants remplacés.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateBackup.Warning" xml:space="preserve">L'espace indiqué est une estimation de DISM et peut différer de l'espace réellement libéré. Cela peut prendre plusieurs minutes.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Name" xml:space="preserve">Cache de téléchargement de Windows Update</x:String>
  <x:String x:Key="Text.Cleanup.Slim.UpdateCache.Description" xml:space="preserve">Supprime le contenu de SoftwareDistribution\Download. Les services Windows Update et BITS sont arrêtés pendant l'exécution, puis rétablis.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Name" xml:space="preserve">Cache de correctifs résiduel</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Description" xml:space="preserve">Arrête le service Windows Installer et supprime le contenu de Installer\$PatchCache$.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.PatchCache.Warning" xml:space="preserve">Des réparations ou désinstallations ultérieures pourraient demander le support d'installation d'origine.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Name" xml:space="preserve">Fonctionnalités de saisie de langue (japonais)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Description" xml:space="preserve">Utilise DISM Remove-Capability pour supprimer les fonctionnalités japonaises de Language.Basic (vérification orthographique, prédiction de texte, etc.). Il ne s'agit pas de l'IME lui-même. Cette opération n'est possible que si la langue n'est utilisée ni par la langue d'affichage, ni par la liste des langues, ni par une disposition de clavier.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageJa.Warning" xml:space="preserve">Pour utiliser de nouveau ces fonctionnalités linguistiques, vous devrez les rajouter.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Name" xml:space="preserve">Fonctionnalités de saisie de langue (coréen)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Description" xml:space="preserve">Utilise DISM Remove-Capability pour supprimer les fonctionnalités coréennes de Language.Basic (vérification orthographique, prédiction de texte, etc.). Il ne s'agit pas de l'IME lui-même. Cette opération n'est possible que si la langue n'est utilisée ni par la langue d'affichage, ni par la liste des langues, ni par une disposition de clavier.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageKo.Warning" xml:space="preserve">Pour utiliser de nouveau ces fonctionnalités linguistiques, vous devrez les rajouter.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Name" xml:space="preserve">Fonctionnalités de saisie de langue (chinois traditionnel)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Description" xml:space="preserve">Utilise DISM Remove-Capability pour supprimer les fonctionnalités de Language.Basic pour le chinois traditionnel (vérification orthographique, prédiction de texte, etc.). Il ne s'agit pas de l'IME lui-même. Cette opération n'est possible que si la langue n'est utilisée ni par la langue d'affichage, ni par la liste des langues, ni par une disposition de clavier.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhTw.Warning" xml:space="preserve">Pour utiliser de nouveau ces fonctionnalités linguistiques, vous devrez les rajouter.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Name" xml:space="preserve">Fonctionnalités de saisie de langue (chinois simplifié)</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Description" xml:space="preserve">Utilise DISM Remove-Capability pour supprimer les fonctionnalités de Language.Basic pour le chinois simplifié (vérification orthographique, prédiction de texte, etc.). Il ne s'agit pas de l'IME lui-même. Cette opération n'est possible que si la langue n'est utilisée ni par la langue d'affichage, ni par la liste des langues, ni par une disposition de clavier.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.LanguageZhCn.Warning" xml:space="preserve">Pour utiliser de nouveau ces fonctionnalités linguistiques, vous devrez les rajouter.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Name" xml:space="preserve">Fichiers d'aide de Windows</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Description" xml:space="preserve">Supprime les fichiers d'aide de Windows. Sous Windows 10/11, ils sont protégés par la Protection des ressources Windows ; il n'y a donc généralement rien à supprimer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.Help.Warning" xml:space="preserve">Les fichiers protégés par Windows ou appartenant à TrustedInstaller sont laissés intacts. La propriété n'est jamais prise.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Name" xml:space="preserve">Fonds d'écran par défaut</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Description" xml:space="preserve">Supprime les fonds d'écran par défaut de Windows. Sous Windows 10/11, ils sont protégés par la Protection des ressources Windows ; il n'y a donc généralement rien à supprimer.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.DefaultWallpapers.Warning" xml:space="preserve">Les fichiers protégés par Windows ou appartenant à TrustedInstaller sont laissés intacts. La propriété n'est jamais prise.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Name" xml:space="preserve">Exemples de musique</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleMusic.Description" xml:space="preserve">Supprime uniquement les morceaux d'exemple connus livrés avec Windows 7. Les autres fichiers du dossier sont laissés intacts.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Name" xml:space="preserve">Exemples d'images</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SamplePictures.Description" xml:space="preserve">Supprime uniquement les images d'exemple connues livrées avec Windows 7. Les autres fichiers du dossier sont laissés intacts.</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Name" xml:space="preserve">Exemples de vidéos</x:String>
  <x:String x:Key="Text.Cleanup.Slim.SampleVideos.Description" xml:space="preserve">Supprime uniquement la vidéo d'exemple connue livrée avec Windows 7. Les autres fichiers du dossier sont laissés intacts.</x:String>
  <x:String x:Key="Text.Cleanup.A11y.Expand" xml:space="preserve">Développer ou réduire {0}</x:String>
  <x:String x:Key="Text.Cleanup.Run.Error" xml:space="preserve">La suppression n'a pas pu être terminée. Consultez le journal.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SaveSuppressed" xml:space="preserve">Les paramètres n'ont pas pu être lus ; l'enregistrement est donc désactivé pour protéger le fichier d'origine. Les modifications ne s'appliquent que pendant cette session.</x:String>
  <x:String x:Key="Text.Cleanup.Settings.SystemRestore.Failed" xml:space="preserve">La restauration du système n'a pas pu être ouverte.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Done" xml:space="preserve">{0} a été ajouté aux exclusions. Les paramètres ont changé ; analysez à nouveau.</x:String>
  <x:String x:Key="Text.Cleanup.Ignore.Duplicate" xml:space="preserve">{0} est déjà exclu.</x:String>
