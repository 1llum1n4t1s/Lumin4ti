  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">Nettoyage avancé</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">Recherche, par motifs, dans les lecteurs sélectionnés des fichiers qui peuvent généralement être supprimés sans risque. L'analyse ne modifie rien. Examinez les résultats, puis supprimez uniquement ce que vous sélectionnez.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">Lecteurs à analyser</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">Amovible</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">Fixe</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">Inclure les fichiers de 0 octet</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">Inclure les raccourcis dont la cible est introuvable</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">Inclure les fichiers plus anciens que le nombre de jours indiqué</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">Jours</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">Sélectionner uniquement les éléments sûrs</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">Par défaut</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">Supplémentaires</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">Définis par l'utilisateur</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">Sûr</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">Indéterminable</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">Défini par l'utilisateur</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">Fichier .chk situé hors d'un dossier FOUND. Il peut s'agir d'un point de contrôle ESE ; il reste donc désélectionné tant que vous ne l'avez pas vérifié.</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">Modifié au cours des dernières 24 heures ; il n'est donc pas sélectionné par défaut.</x:String>
