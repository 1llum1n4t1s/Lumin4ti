  <x:String x:Key="Text.Cleanup.Advanced.Title" xml:space="preserve">進階清理</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Description" xml:space="preserve">依模式在所選的磁碟機中尋找通常可以安全刪除的檔案。掃描不會變更任何內容。請先檢查結果，再只刪除你所選的內容。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drives" xml:space="preserve">要掃描的磁碟機</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Removable" xml:space="preserve">卸除式</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Drive.Fixed" xml:space="preserve">固定式</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.ZeroByte" xml:space="preserve">包含 0 位元組檔案</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.InvalidShortcuts" xml:space="preserve">包含目標已不存在的捷徑</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.OlderThan" xml:space="preserve">包含早於指定天數的檔案</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Option.Days" xml:space="preserve">天數</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.SelectSafe" xml:space="preserve">只選取安全的項目</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Default" xml:space="preserve">預設</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.Additional" xml:space="preserve">額外</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Group.UserDefined" xml:space="preserve">使用者自訂</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Safe" xml:space="preserve">安全</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.Undeterminable" xml:space="preserve">無法判斷</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Verdict.UserDefined" xml:space="preserve">使用者自訂</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.CheckpointOutsideFound" xml:space="preserve">位於 FOUND 資料夾之外的 .chk 檔案。它可能是 ESE 檢查點，因此在你確認之前不會被選取。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.RecentlyModified" xml:space="preserve">在最近 24 小時內修改過，因此預設不選取。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.ZeroByte" xml:space="preserve">這是 0 位元組檔案，因此預設不選取。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.OldFile" xml:space="preserve">僅因檔案較舊而符合，因此預設不選取。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Hint.UserPattern" xml:space="preserve">符合你定義的模式，因此預設不選取。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.NamePattern" xml:space="preserve">名稱模式</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.ZeroByte" xml:space="preserve">0 位元組</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.InvalidShortcut" xml:space="preserve">無效的捷徑</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RuleKind.OldFile" xml:space="preserve">舊檔案</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Progress" xml:space="preserve">已檢查 {0} 個資料夾和 {1} 個檔案；{2} 個符合項目（{3}）：{4}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.ScanDone" xml:space="preserve">掃描完成：在檢查的 {2} 個檔案中，有 {0} 個符合項目（{1}）。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Truncated" xml:space="preserve">符合項目過多，因此只顯示前 {0} 個。其餘 {1} 個（{2}）既不會顯示，也不會被刪除。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.RootFailure" xml:space="preserve">無法掃描：{0}（{1}）</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Pruned" xml:space="preserve">有 {0} 個資料夾因受保護或被排除而未檢查。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Empty" xml:space="preserve">沒有符合的檔案。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Selection" xml:space="preserve">已選取 {0} 個檔案，共 {1} 個（{2}）</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolders" xml:space="preserve">自訂資料夾</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Note" xml:space="preserve">只會清空資料夾中的內容，資料夾本身會保留。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Missing" xml:space="preserve">找不到</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.CustomFolder.Summary" xml:space="preserve">{0} 個檔案，{1}</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Body" xml:space="preserve">所選的 {0} 個檔案（{1}）以及 {2} 個自訂資料夾中的內容將被永久刪除。它們不會移到資源回收筒，也無法還原。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Undeterminable" xml:space="preserve">包含 {0} 個標示為「無法判斷」的檔案。請取消選取你尚未檢查過的檔案。</x:String>
  <x:String x:Key="Text.Cleanup.Advanced.Confirm.Recent" xml:space="preserve">包含 {0} 個在最近 24 小時內修改過的檔案。</x:String>
