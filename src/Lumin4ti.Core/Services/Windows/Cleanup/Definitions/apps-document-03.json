{
  "schema": 1,
  "rules": [
    {
      "id": "app.notion-cache",
      "name": "Notion",
      "nameKey": null,
      "kind": "cache",
      "category": "apps",
      "scope": "user",
      "recommended": true,
      "impact": "junk",
      "warningKey": null,
      "engine": null,
      "detect": [
        { "path": "%APPDATA%\\Notion\\Cache" },
        { "path": "%APPDATA%\\Notion\\GPUCache" }
      ],
      "targets": [
        { "type": "contents", "path": "%APPDATA%\\Notion\\Cache", "pattern": null, "olderThanDays": null },
        { "type": "contents", "path": "%APPDATA%\\Notion\\Code Cache", "pattern": null, "olderThanDays": null },
        { "type": "contents", "path": "%APPDATA%\\Notion\\GPUCache", "pattern": null, "olderThanDays": null }
      ],
      "processes": ["Notion"],
      "services": [],
      "legacy": [],
      "evidence": [
        { "tier": "A", "url": "https://www.notion.com/help/reset-notion", "checked": "2026-11-25" },
        { "tier": "A", "url": "https://github.com/electron/website/blob/main/src/util/featured-apps.ts", "checked": "2026-11-25" },
        { "tier": "A", "url": "https://github.com/electron/electron/blob/main/docs/api/app.md", "checked": "2026-11-25" },
        { "tier": "A", "url": "https://github.com/chromium/chromium/blob/main/content/browser/storage_partition_impl.cc", "checked": "2026-11-25" }
      ]
    },
    {
