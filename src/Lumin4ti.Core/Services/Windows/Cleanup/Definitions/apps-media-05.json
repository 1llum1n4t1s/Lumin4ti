        { "tier": "A", "url": "https://raw.githubusercontent.com/videolan/vlc/master/src/preparser/art.c", "checked": "2026-11-26" },
        { "tier": "A", "url": "https://raw.githubusercontent.com/videolan/vlc/master/src/win32/dirs.c", "checked": "2026-11-26" }
      ]
    },
    {
      "id": "app.vlc-crashdump",
      "name": "VLC",
      "nameKey": null,
      "kind": "report",
      "category": "apps",
      "scope": "user",
      "recommended": true,
      "impact": "junk",
      "warningKey": null,
      "engine": null,
      "detect": [
        { "path": "%APPDATA%\\vlc\\crashdump" }
