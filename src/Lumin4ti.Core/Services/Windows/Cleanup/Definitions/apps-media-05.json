{
  "schema": 1,
  "rules": [
    {
      "id": "app.vlc-art-cache",
      "name": "VLC",
      "nameKey": null,
      "kind": "cache",
      "category": "apps",
      "scope": "user",
      "recommended": true,
      "impact": "junk",
      "warningKey": null,
      "engine": null,
      "detect": [
        { "path": "%APPDATA%\\vlc" }
      ],
      "targets": [
        { "type": "contents", "path": "%APPDATA%\\vlc\\art", "pattern": null, "olderThanDays": null }
