      "targets": [
        { "type": "contents", "path": "%APPDATA%\\vlc\\crashdump", "pattern": null, "olderThanDays": null }
      ],
      "processes": ["vlc"],
      "services": [],
      "legacy": [],
      "evidence": [
        { "tier": "A", "url": "https://raw.githubusercontent.com/videolan/vlc/master/bin/winvlc.c", "checked": "2026-11-27" }
      ]
    }
  ]
