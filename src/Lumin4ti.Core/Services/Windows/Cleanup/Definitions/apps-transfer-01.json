{
  "schema": 1,
  "rules": [
    {
      "id": "app.box-drive-logs",
      "name": "Box Drive",
      "nameKey": null,
      "kind": "log",
      "category": "apps",
      "scope": "user",
      "recommended": true,
      "impact": "junk",
      "warningKey": null,
      "engine": null,
      "detect": [
        { "path": "%LOCALAPPDATA%\\Box\\Box\\logs" }
      ],
      "targets": [
        { "type": "contents", "path": "%LOCALAPPDATA%\\Box\\Box\\logs", "pattern": null, "olderThanDays": null }
      ],
      "processes": ["Box"],
      "services": [],
      "legacy": [],
      "evidence": [
        { "tier": "A", "url": "https://support.box.com/hc/en-us/articles/360043695894-Technical-Information-for-Box-Drive-Administrators", "checked": "2026-11-25" }
      ]
    },
    {
