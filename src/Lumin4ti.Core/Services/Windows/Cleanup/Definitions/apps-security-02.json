      "impact": "junk",
      "warningKey": null,
      "engine": null,
      "detect": [
        { "path": "%PROGRAMDATA%\\Mullvad VPN\\daemon.old.log" }
      ],
      "targets": [
        { "type": "files", "path": "%PROGRAMDATA%\\Mullvad VPN", "pattern": "daemon.old.log", "olderThanDays": null }
