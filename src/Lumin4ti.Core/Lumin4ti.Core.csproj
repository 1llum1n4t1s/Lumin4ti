<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lumin4ti.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SuperLightLogger" Version="1.0.22" />
  </ItemGroup>

  <ItemGroup>
    <!-- クリーンアップ規則の定義。外部ファイルは読まず、埋め込みだけを正本にする。 -->
    <EmbeddedResource Include="Services\Windows\Cleanup\Definitions\*.json"
                      LogicalName="Lumin4ti.Cleanup.Definitions.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumin4ti.Tests" />
    <InternalsVisibleTo Include="Lumin4ti.UI" />
    <InternalsVisibleTo Include="Lumin4ti.Verification" />
  </ItemGroup>

</Project>
