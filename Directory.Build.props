<Project>

  <PropertyGroup>
    <!-- Windows 専用アプリ。UWP パッケージ列挙 (WinRT PackageManager) を使うため
         RealTimeTranslator と同じ Windows SDK 付き TFM を指定する。 -->
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- リリースバージョン。更新は /vava スキル経由のみ (手動で上げない)。 -->
    <Version>1.0.26</Version>
    <!-- 製作者情報。Company は exe のプロパティに載るので屋号で統一する。 -->
    <Authors>Kagayoi</Authors>
    <Company>Kagayoi</Company>
    <Copyright>Copyright © 2026 Kagayoi</Copyright>
    <!-- ReadyToRun: JIT コンパイル時間を削減して起動を高速化 (ExtWeigh / RealTimeTranslator と同方針)。 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 警告をエラー扱いにして品質ゲートを他リポジトリと揃える。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet 依存のサプライチェーン保護: lockfile (packages.lock.json) を生成・検証する。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- IDE コードスタイル分析をビルド時にも強制する。IDE0005 はドキュメント生成が必須なため対象外。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
